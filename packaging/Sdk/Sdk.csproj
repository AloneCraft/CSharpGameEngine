<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The engine SDK package (ADR-0065). A game project references only this package: its layout mirrors
    the repository (build/, src/, assets/Shaders/, tools/), so build/CSharpGameEngine.Game.props applies
    the same conventions in PackageMode as in SourceMode. The package carries:
    - build/: CSharpGameEngine.Sdk.props/.targets (NuGet entry points), Game.props and ShaderGraph.targets;
    - lib/: the engine libraries a game compiles against;
    - analyzers/: the ECS source generator and analyzers;
    - src/: the shared runtime sources the generator completes inside each game (ADR-0033);
    - assets/Shaders/: the default Stage shader graph and compute shaders;
    - tools/Cge/: the shader compiler, scene schema writer and model compiler the build invokes (Cge shader-graph, scene-schema, content);
    - plugins/: the engine plugins (ADR-0079), enabled per game with CgePlugins.
    External libraries are NuGet dependencies of this package.
  -->
  <Import Project="..\..\build\CSharpGameEngine.Version.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <CgeSkipEngineAnalyzerReference>true</CgeSkipEngineAnalyzerReference>
    <PackageId>CSharpGameEngine.Sdk</PackageId>
    <Version Condition="'$(Version)' == ''">$(CgeEngineVersion)</Version>
    <Authors>CSharpGameEngine</Authors>
    <Description>C# Game Engine SDK: runtime libraries, ECS source generator, shared runtime sources, default shaders and the shader compiler for game projects.</Description>
    <PackageTags>gamedev;ecs;direct3d12</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);NU5100;NU5128;NU5127</NoWarn>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\.artifacts\packages\</PackageOutputPath>
    <CgeRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))\</CgeRepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
  </ItemGroup>
  <ItemGroup>
    <CgeEngineLibrary Include="$(CgeRepositoryRoot)src\Contracts\Contracts.csproj" />
    <CgeEngineLibrary Include="$(CgeRepositoryRoot)src\Windows\Windows.csproj" />
    <CgeEngineLibrary Include="$(CgeRepositoryRoot)src\Engine\Engine.csproj" />
    <CgeEngineLibrary Include="$(CgeRepositoryRoot)src\Numerics\Numerics.csproj" />
    <!-- ADR-0079: build the Cook contract for the tool host; it is excluded from runtime lib below. -->
    <CgeEngineLibrary Include="$(CgeRepositoryRoot)src\Cooking\Cooking.csproj" />
    <None Include="build\CSharpGameEngine.Sdk.props;build\CSharpGameEngine.Sdk.targets" Pack="true" PackagePath="build\" />
    <None Include="build\CSharpGameEngine.Sdk.NumericProfiles.targets;build\CSharpGameEngine.ProfileLibrary.csproj.in" Pack="true" PackagePath="build\" />
    <None Include="$(CgeRepositoryRoot)build\CSharpGameEngine.NumericProfile.*" Pack="true" PackagePath="build\" />
    <None Include="$(CgeRepositoryRoot)build\CSharpGameEngine.RenderProfile.props" Pack="true" PackagePath="build\" />
    <None Include="$(CgeRepositoryRoot)build\CSharpGameEngine.ModelContent.targets" Pack="true" PackagePath="build\" />
    <None Include="$(CgeRepositoryRoot)build\CSharpGameEngine.TileContent.targets" Pack="true" PackagePath="build\" />
    <None Include="$(CgeRepositoryRoot)build\PropertyPages\**\*.xaml" Pack="true" PackagePath="build\PropertyPages\" />
    <None Include="$(CgeRepositoryRoot)src\Numerics\**\*.cs" Exclude="$(CgeRepositoryRoot)src\Numerics\bin\**;$(CgeRepositoryRoot)src\Numerics\obj\**" Pack="true" PackagePath="src\Numerics\" />
    <None Include="$(CgeRepositoryRoot)build\CSharpGameEngine.Game.props;$(CgeRepositoryRoot)build\CSharpGameEngine.Game.targets;$(CgeRepositoryRoot)build\CSharpGameEngine.Version.props;$(CgeRepositoryRoot)build\CSharpGameEngine.ShaderGraph.targets;$(CgeRepositoryRoot)build\CSharpGameEngine.SceneSchema.targets" Pack="true" PackagePath="build\" />
    <!-- Evaluation-time wildcards: NuGet keeps each file's RecursiveDir under PackagePath. Inside a target, an unqualified %(RecursiveDir) batched
         over the other None items and packed copies under their folders (src\<module>\win-x64\ in 0.1.15). -->
    <None Include="$(CgeRepositoryRoot)plugins\**\*" Exclude="$(CgeRepositoryRoot)plugins\**\bin\**;$(CgeRepositoryRoot)plugins\**\obj\**" Pack="true" PackagePath="plugins\" />
    <None Include="$(CgeRepositoryRoot)src\Entities\*.cs" Pack="true" PackagePath="src\Entities\" />
    <None Include="$(CgeRepositoryRoot)src\Runtime\**\*" Exclude="$(CgeRepositoryRoot)src\Runtime\**\bin\**;$(CgeRepositoryRoot)src\Runtime\**\obj\**" Pack="true" PackagePath="src\Runtime\" />
    <None Include="$(CgeRepositoryRoot)assets\Fonts\*" Pack="true" PackagePath="assets\Fonts\" />
    <None Include="$(CgeRepositoryRoot)assets\Shaders\*.cgeshadergraph;$(CgeRepositoryRoot)assets\Shaders\*.cgesubgraph;$(CgeRepositoryRoot)assets\Shaders\*.hlsl;$(CgeRepositoryRoot)assets\Shaders\*.hlsli" Pack="true" PackagePath="assets\Shaders\" />
  </ItemGroup>
  <!-- Builds the engine libraries, the analyzer and the shader compiler, then adds their outputs to the package. -->
  <Target Name="CgeCollectEnginePayload" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="@(CgeEngineLibrary)" Targets="Build" Properties="Configuration=$(Configuration);CgeNumericMode=Fixed;CgeFixedBits=128;CgeFractionalBits=64">
      <Output TaskParameter="TargetOutputs" ItemName="_CgeEngineAssembly" />
    </MSBuild>
    <MSBuild Projects="$(CgeRepositoryRoot)src\CodeAnalysis\CodeAnalysis.csproj" Targets="Build" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_CgeAnalyzerAssembly" />
    </MSBuild>
    <MSBuild Projects="$(CgeRepositoryRoot)tools\Cook.Cli\Cook.Cli.csproj" Targets="Build" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_CgeCookCli" />
    </MSBuild>
    <MSBuild Projects="$(CgeRepositoryRoot)tools\Cge\Cge.csproj;$(CgeRepositoryRoot)src\Import\Import.csproj" Targets="Restore" BuildInParallel="false"
      Properties="Configuration=$(Configuration);CgeNumericMode=Fixed;CgeFixedBits=128;CgeFractionalBits=64;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <!-- tools\Cge: the shader-graph, scene-schema and content commands the game build runs (Sdk.props, ModelContent.targets). -->
    <MSBuild Projects="$(CgeRepositoryRoot)tools\Cge\Cge.csproj" Targets="Build"
      Properties="Configuration=$(Configuration);CgeNumericMode=Fixed;CgeFixedBits=128;CgeFractionalBits=64">
      <Output TaskParameter="TargetOutputs" ItemName="_CgeTool" />
    </MSBuild>
    <MSBuild Projects="$(CgeRepositoryRoot)src\Import\Import.csproj" Targets="Build"
      Properties="Configuration=$(Configuration);CgeNumericMode=Fixed;CgeFixedBits=128;CgeFractionalBits=64">
      <Output TaskParameter="TargetOutputs" ItemName="_CgeModelImport" />
    </MSBuild>
    <!-- ADR-0079/M0106: the Navigation plugin's Cook module, built here and carried next to the plugin's sources (Navigation.plugin.items runs it from Cook\lib). -->
    <MSBuild Projects="$(CgeRepositoryRoot)plugins\Navigation\Cook\Navigation.Cook.csproj" Targets="Restore" Properties="Configuration=$(Configuration);CgeNumericMode=Fixed;CgeFixedBits=128;CgeFractionalBits=64;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" BuildInParallel="false" />
    <MSBuild Projects="$(CgeRepositoryRoot)plugins\Navigation\Cook\Navigation.Cook.csproj" Targets="Build" Properties="Configuration=$(Configuration);CgeNumericMode=Fixed;CgeFixedBits=128;CgeFractionalBits=64">
      <Output TaskParameter="TargetOutputs" ItemName="_CgeNavigationCookModule" />
    </MSBuild>
    <!-- ADR-0078/M0113: the Destruction plugin's Cook module (the fracture cooker), the same way. -->
    <MSBuild Projects="$(CgeRepositoryRoot)plugins\Destruction\Cook\Destruction.Cook.csproj" Targets="Restore" Properties="Configuration=$(Configuration);CgeNumericMode=Fixed;CgeFixedBits=128;CgeFractionalBits=64;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" BuildInParallel="false" />
    <MSBuild Projects="$(CgeRepositoryRoot)plugins\Destruction\Cook\Destruction.Cook.csproj" Targets="Build" Properties="Configuration=$(Configuration);CgeNumericMode=Fixed;CgeFixedBits=128;CgeFractionalBits=64">
      <Output TaskParameter="TargetOutputs" ItemName="_CgeDestructionCookModule" />
    </MSBuild>
    <PropertyGroup>
      <_CgeNavigationCookDirectory>@(_CgeNavigationCookModule->'%(RootDir)%(Directory)')</_CgeNavigationCookDirectory>
      <_CgeDestructionCookDirectory>@(_CgeDestructionCookModule->'%(RootDir)%(Directory)')</_CgeDestructionCookDirectory>
      <_CgeCookCliDirectory>@(_CgeCookCli->'%(RootDir)%(Directory)')</_CgeCookCliDirectory>
      <_CgeToolDirectory>@(_CgeTool->'%(RootDir)%(Directory)')</_CgeToolDirectory>
      <_CgeModelImportDirectory>@(_CgeModelImport->'%(RootDir)%(Directory)')</_CgeModelImportDirectory>
    </PropertyGroup>
    <ItemGroup>
      <None Include="@(_CgeEngineAssembly)" Condition="'%(_CgeEngineAssembly.Filename)' != 'Cooking'" Pack="true" PackagePath="lib\$(TargetFramework)\" />
      <None Include="@(_CgeAnalyzerAssembly)" Pack="true" PackagePath="analyzers\dotnet\cs\" />
      <!-- With its runtimes\ folder (AssimpNet's native asset is listed in Cge.deps.json). Not Cook\ (packed as tools\Cook below) and not a
           win-x64\ copy an x64 test run of the solution can leave below the output folder. -->
      <None Include="$(_CgeToolDirectory)**\*" Exclude="$(_CgeToolDirectory)**\*.pdb;$(_CgeToolDirectory)Cook\**;$(_CgeToolDirectory)win-x64\**" Pack="true" PackagePath="tools\Cge\" />
      <!-- The Cook module with its dependencies (the host shares CSharpGameEngine.Cooking with it, so that one is left out). -->
      <None Include="$(_CgeNavigationCookDirectory)*" Exclude="$(_CgeNavigationCookDirectory)*.pdb;$(_CgeNavigationCookDirectory)Cooking.dll" Pack="true" PackagePath="plugins\Navigation\Cook\lib\" />
      <None Include="$(_CgeDestructionCookDirectory)*" Exclude="$(_CgeDestructionCookDirectory)*.pdb;$(_CgeDestructionCookDirectory)Cooking.dll" Pack="true" PackagePath="plugins\Destruction\Cook\lib\" />
      <!-- ADR-0079: runs a plugin's Cook module in its own process (top level only, for the same reason as above). -->
      <None Include="$(_CgeCookCliDirectory)*" Exclude="$(_CgeCookCliDirectory)*.pdb" Pack="true" PackagePath="tools\Cook\" />
      <None Include="$(_CgeModelImportDirectory)*" Exclude="$(_CgeModelImportDirectory)*.pdb" Pack="true" PackagePath="tools\ModelImport\" />
      <None Include="$(_CgeModelImportDirectory)runtimes\**\*" Exclude="$(_CgeModelImportDirectory)runtimes\**\*.pdb" Pack="true" PackagePath="tools\ModelImport\runtimes\" />
    </ItemGroup>
  </Target>
</Project>
