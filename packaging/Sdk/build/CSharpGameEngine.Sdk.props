<Project>
  <!--
    NuGet entry point of the engine SDK package (ADR-0065). It selects PackageMode and applies the same
    game-project conventions as a repository build: the package root mirrors the repository, so
    CSharpGameEngine.Game.props resolves the shared sources and shaders inside the package.
  -->
  <PropertyGroup>
    <CgeEngineMode>Package</CgeEngineMode>
    <CgeEngineRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))\</CgeEngineRoot>
    <!-- tools\Cge carries the shader-graph, scene-schema and content commands (Docs/refactoring-designs/20261117-command-tools-consolidation.md). -->
    <CgeShaderGraphCliExe>$(CgeEngineRoot)tools\Cge\Cge.exe</CgeShaderGraphCliExe>
    <CgeSceneSchemaCli>$(CgeEngineRoot)tools\Cge\Cge.dll</CgeSceneSchemaCli>
    <!-- ADR-0079: run a plugin's Cook module with "dotnet $(CgeCookCli) cook <module.dll> <input> <output-directory>". -->
    <CgeCookCli>$(CgeEngineRoot)tools\Cook\Cook.Cli.dll</CgeCookCli>
    <CustomBeforeMicrosoftCommonTargets Condition="'$(CustomBeforeMicrosoftCommonTargets)' == ''">$(MSBuildThisFileDirectory)CSharpGameEngine.NumericProfile.BeforeCommon.targets</CustomBeforeMicrosoftCommonTargets>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)CSharpGameEngine.Game.props" />
</Project>
