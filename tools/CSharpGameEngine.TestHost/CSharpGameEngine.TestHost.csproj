<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- ADR-0034: was 3 references (Core + Platform.Windows + Graphics.D3D12). Graphics.D3D12 and
         Platform.Windows are now both inside CSharpGameEngine.Windows, which itself references Core,
         so Core is only listed for the types this project uses directly. -->
    <ProjectReference Include="..\..\src\CSharpGameEngine.Windows\CSharpGameEngine.Windows.csproj" />
    <ProjectReference Include="..\..\src\CSharpGameEngine.Core\CSharpGameEngine.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <CgeShaderGraph Include="..\..\assets\Shaders\Triangle.cgeshadergraph" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
  </PropertyGroup>

</Project>
