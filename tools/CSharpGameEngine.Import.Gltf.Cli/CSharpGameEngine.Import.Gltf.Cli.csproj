<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\CSharpGameEngine.Import\CSharpGameEngine.Import.csproj" />
    <!-- ADR-0023: resident-server mode ("serve" launch argument), shared with the other 2 bridges. -->
    <ProjectReference Include="..\CSharpGameEngine.Bridge.Hosting\CSharpGameEngine.Bridge.Hosting.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Unlike CSharpGameEngine.Import.Fbx.Cli, this bridge only ever calls GltfImporter, and
         SharpGLTF.Core is fully managed (no native DLL), so no RuntimeIdentifier/SelfContained is
         needed here - a plain portable net10.0 console app is enough for `dotnet run` to work from
         the VSIX's ExternalGltfLoader.

         ADR-0034 merged Import.Gltf and Import.Fbx into one assembly, so AssimpNet's MANAGED
         assembly is now resolved by this project too. Deliberately still no RuntimeIdentifier: the
         native assimp.dll is a RID-specific asset that NuGet only copies when one is set, and
         nothing on this bridge's code path loads it. Adding a RID here would drag the native binary
         into the output for no reason. -->
  </PropertyGroup>

</Project>
