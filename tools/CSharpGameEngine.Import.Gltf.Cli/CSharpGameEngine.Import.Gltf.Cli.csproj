<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\CSharpGameEngine.Import.Gltf\CSharpGameEngine.Import.Gltf.csproj" />
    <!-- ADR-0023: resident-server mode ("serve" launch argument), shared with the other 2 bridges. -->
    <ProjectReference Include="..\CSharpGameEngine.Bridge.Hosting\CSharpGameEngine.Bridge.Hosting.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Unlike CSharpGameEngine.Import.Fbx.Cli, SharpGLTF.Core is fully managed (no native DLL), so
         no RuntimeIdentifier/SelfContained is needed here - a plain portable net10.0 console app is
         enough for `dotnet run` to work from the VSIX's ExternalGltfLoader. -->
  </PropertyGroup>

</Project>
