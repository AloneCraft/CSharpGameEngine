<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <DefineConstants>$(DefineConstants);CGE_NUMERIC_ADAPTER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CSharpGameEngine.Contracts/CSharpGameEngine.Contracts.csproj" />
    <ProjectReference Include="../../src/CSharpGameEngine.Windows/CSharpGameEngine.Windows.csproj" />
    <ProjectReference Include="../CSharpGameEngine.Bridge.Hosting/CSharpGameEngine.Bridge.Hosting.csproj" />
    <!-- ADR-0090: the host loads skinned glTF itself (managed Import only; no RuntimeIdentifier, so AssimpNet's native DLL is not copied). -->
    <ProjectReference Include="../../src/CSharpGameEngine.Import/CSharpGameEngine.Import.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CSharpGameEngine.Windows.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADR-0070 B1: the runtime view reads the editor's scene JSON with the generator's own reader. -->
    <Compile Include="../../src/CSharpGameEngine.SceneModel/Json/SceneJson.cs" Link="SceneJson/SceneJson.cs" />
    <Compile Include="../../src/CSharpGameEngine.SceneModel/Json/SceneJsonReader.cs" Link="SceneJson/SceneJsonReader.cs" />
    <Compile Include="../../src/CSharpGameEngine.SceneModel/Json/SceneJsonAngles.cs" Link="SceneJson/SceneJsonAngles.cs" />
    <Compile Include="../../src/CSharpGameEngine.SceneModel/Json/SceneJsonDecimal.cs" Link="SceneJson/SceneJsonDecimal.cs" />
  </ItemGroup>
  <ItemGroup><Compile Include="../Shared/ThumbnailPng.cs" Link="ThumbnailPng.cs" /></ItemGroup>
  <ItemGroup>
    <!-- ADR-0090: the same skeleton/clip evaluation and glTF-to-stage conversion the game runs (ECS-free sources of the shared projects). -->
    <Compile Include="../../src/CSharpGameEngine.Runtime.Animation/Skeleton.cs" Link="SharedRuntime/Skeleton.cs" />
    <Compile Include="../../src/CSharpGameEngine.Runtime.Animation/AnimationClip.cs" Link="SharedRuntime/AnimationClip.cs" />
    <Compile Include="../../src/CSharpGameEngine.Runtime.Windows/StageGltfAssets.cs" Link="SharedRuntime/StageGltfAssets.cs" />
  </ItemGroup>
</Project>
