<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ADR-0078/M0104: bakes a TrueType font to a signed distance field atlas (.cgefont, FontAtlas in CSharpGameEngine.Rendering).
    A development tool, run when a font is added: the game reads the baked file and never needs GDI+ or the source font.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <ProjectReference Include="..\..\src\CSharpGameEngine.Rendering\CSharpGameEngine.Rendering.csproj" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo"><_Parameter1>CSharpGameEngine.FontBaker.Tests</_Parameter1></AssemblyAttribute>
  </ItemGroup>
</Project>
