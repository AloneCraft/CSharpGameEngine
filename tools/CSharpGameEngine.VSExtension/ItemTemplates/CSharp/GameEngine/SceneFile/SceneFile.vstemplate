<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name Package="{aec17804-e2e4-46e7-b373-de11af816203}" ID="130" />
    <Description Package="{aec17804-e2e4-46e7-b373-de11af816203}" ID="131" />
    <Icon>__TemplateIcon.ico</Icon>
    <ProjectType>CSharp</ProjectType>
    <ShowByDefault>true</ShowByDefault>
    <TemplateID>CSharpGameEngine.SceneFile</TemplateID>
    <!-- Visual Studio takes the extension after the last dot, so the name the user types becomes
         $fileinputname$ and the item is written as <name>.scene.json (ADR-0070). -->
    <DefaultName>Scene.json</DefaultName>
    <SortOrder>10</SortOrder>
    <NumberOfParentCategoriesToRollUp>1</NumberOfParentCategoriesToRollUp>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.scene.json">Scene.scene.json</ProjectItem>
  </TemplateContent>
  <WizardExtension>
    <Assembly>CSharpGameEngine.VSExtension</Assembly>
    <FullClassName>CSharpGameEngine.VSExtension.SceneFileTemplateWizard</FullClassName>
  </WizardExtension>
</VSTemplate>
