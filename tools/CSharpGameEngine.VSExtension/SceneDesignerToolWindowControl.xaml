<UserControl x:Class="CSharpGameEngine.VSExtension.SceneDesignerToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:CSharpGameEngine.VSExtension"
             mc:Ignorable="d"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             d:DesignHeight="400" d:DesignWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ToggleButton x:Name='CameraPreviewToggle' Grid.Row='0' HorizontalAlignment='Right' VerticalAlignment='Top' Margin='0,5,8,0' Panel.ZIndex='5' Width='120' IsChecked='True' Content='{local:Loc SceneCameraPreview}' ToolTip='{local:Loc SceneCameraPreviewToolTip}' />

        <Border Grid.Row="0" Padding="8,5" Background="#202020">
            <DockPanel LastChildFill="True">
                <ComboBox x:Name="SceneSelector"
                          Width="270"
                          Margin="0,0,10,0"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="False"
                          SelectionChanged="OnSceneSelectionChanged"
                          ToolTip="{local:Loc SceneSelectorToolTip}" />
                <TextBlock Text="{local:Loc SceneViewLabel}" Foreground="#D8D8D8" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="ViewModeSelector" Width="120" Margin="0,0,8,0" SelectedValuePath="Tag" SelectionChanged="OnViewModeSelectionChanged" ToolTip="{local:Loc SceneViewLabel}">
                    <ComboBoxItem Tag="Lit" Content="{local:Loc SceneRenderModeLit}" />
                    <ComboBoxItem Tag="BaseColor" Content="{local:Loc SceneRenderModeBaseColor}" />
                    <ComboBoxItem Tag="Normal" Content="{local:Loc SceneRenderModeNormal}" />
                    <ComboBoxItem Tag="Wireframe" Content="{local:Loc SceneRenderModeWireframe}" />
                </ComboBox>
                <CheckBox x:Name="GlobalSpatialOctreeToggle" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" VerticalAlignment="Center" Margin="0,0,8,0" Content="{local:Loc SceneGlobalSpatialOctree}" ToolTip="{local:Loc SceneGlobalSpatialOctreeToolTip}" Checked="OnGlobalSpatialOctreeChanged" Unchecked="OnGlobalSpatialOctreeChanged" />
                <ComboBox x:Name="SpatialDebugProcessSelector" Width="92" Margin="0,0,8,0" Visibility="Collapsed" SelectionChanged="OnSpatialDebugProcessSelectionChanged" ToolTip="{local:Loc SceneSpatialDebugProcessToolTip}" />
                <TextBlock x:Name="VsixIdentityText" Foreground="#8FC9FF" FontSize="10" />
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Padding="8,0,8,4" Background="#202020">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#D8D8D8" Text="{local:Loc SceneSelectPrompt}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SpatialDebugStatusText" Grid.Column="1" Margin="12,0,0,0" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Text="{local:Loc SceneSpatialOff}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
                <Grid x:Name="SceneSurfaceGrid" Grid.Row="2" Background="#050514">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="RenderHostGrid" Grid.Column="0" Background="#050514">
                <TextBlock x:Name="EmptyStateText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="16"
                           Foreground="#D8D8D8"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{local:Loc SceneSelectPrompt}" />
            </Grid>
            <Grid x:Name="PhysicsSidebarGrid" Grid.Column="1" Background="#202020">
                <Button x:Name="PhysicsPanelToggle"
                              Width="24"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Content="{local:Loc PhysicsPanelOpenGlyph}"
                              ToolTip="{local:Loc PhysicsPanelOpenToolTip}"
                              Click="OnPhysicsPanelToggleClicked" />
                <Border x:Name="PhysicsPanelBorder"
                        Width="280"
                        Visibility="Collapsed"
                        BorderBrush="#404040"
                        BorderThickness="1,0,0,0"
                        Background="#202020">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Height="32" Margin="8,3,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{local:Loc PhysicsLabel}"
                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                            <Button Grid.Column="1"
                                    x:Name="PhysicsPanelCloseButton"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Content="{local:Loc PhysicsPanelCloseGlyph}"
                                    ToolTip="{local:Loc PhysicsPanelCloseToolTip}"
                                    Click="OnPhysicsPanelToggleClicked" />
                        </Grid>
                        <ScrollViewer Padding="8,4,8,8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Button x:Name="PhysicsBakeSelectedButton" Content="{local:Loc PhysicsBakeSelected}" HorizontalAlignment="Left" Margin="0,0,0,4" Padding="7,1" IsEnabled="False" ToolTip="{local:Loc PhysicsBakeSelectedToolTip}" Click="OnPhysicsBakeSelected" />
                                <Button x:Name="PhysicsBakeAllButton" Content="{local:Loc PhysicsBakeAll}" HorizontalAlignment="Left" Margin="0,0,0,4" Padding="7,1" IsEnabled="False" ToolTip="{local:Loc PhysicsBakeAllToolTip}" Click="OnPhysicsBakeAll" />
                                <Button x:Name="PhysicsBakeCancelButton" Content="{local:Loc PhysicsBakeCancel}" HorizontalAlignment="Left" Margin="0,0,0,4" Padding="7,1" Visibility="Collapsed" Click="OnPhysicsBakeCancel" />
                                <ProgressBar x:Name="PhysicsBakeProgressBar" Height="4" Minimum="0" Maximum="1" Margin="0,0,0,4" Visibility="Collapsed" />
                                <TextBlock x:Name="PhysicsBakePhaseText" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Margin="0,0,0,4" Visibility="Collapsed" />
                                <TextBlock x:Name="PhysicsBakeDiagnosticText" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Margin="0,0,0,12" Visibility="Collapsed" />
                                <ListBox x:Name="PhysicsBakeArtifactList" MaxHeight="96" Margin="0,0,0,4" Visibility="Collapsed" SelectionChanged="OnPhysicsBakeArtifactSelectionChanged" />
                                <Button x:Name="PhysicsBakeOpenArtifactButton" Content="{local:Loc PhysicsBakeOpenArtifact}" HorizontalAlignment="Left" Margin="0,0,0,12" Padding="7,1" Visibility="Collapsed" IsEnabled="False" Click="OnPhysicsBakeOpenArtifact" />
                                <Separator Margin="0,0,0,8" />
                                <TextBlock Text="{local:Loc RuntimeDebugLabel}" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Margin="0,0,0,4" />
                                <Button x:Name="RuntimeDebugRefreshButton" Content="{local:Loc RuntimeDebugRefresh}" HorizontalAlignment="Left" Margin="0,0,0,4" Padding="7,1" ToolTip="{local:Loc RuntimeDebugRefreshToolTip}" Click="OnRuntimeDebugRefresh" />
                                <TextBlock x:Name="RuntimeDebugSummaryText" Text="{local:Loc RuntimeDebugNoSnapshot}" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Margin="0,0,0,4" />
                                <ListBox x:Name="RuntimeDebugRows" MaxHeight="240" Margin="0,0,0,12" HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <CheckBox x:Name="PhysicsDebugToggle" Content="{local:Loc PhysicsDebug}" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Margin="0,0,0,8" Checked="OnPhysicsDebugChanged" Unchecked="OnPhysicsDebugChanged" />
                                <CheckBox x:Name="PhysicsBoundsToggle" Content="{local:Loc PhysicsColliderAabb}" IsChecked="True" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Margin="0,0,0,8" Checked="OnPhysicsDebugOptionsChanged" Unchecked="OnPhysicsDebugOptionsChanged" />
                                <CheckBox x:Name="PhysicsVelocityToggle" Content="{local:Loc PhysicsVelocity}" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Margin="0,0,0,8" Checked="OnPhysicsDebugOptionsChanged" Unchecked="OnPhysicsDebugOptionsChanged" />
                                <CheckBox x:Name="PhysicsSleepToggle" Content="{local:Loc PhysicsSleep}" IsChecked="True" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Margin="0,0,0,8" Checked="OnPhysicsDebugOptionsChanged" Unchecked="OnPhysicsDebugOptionsChanged" />
                                <CheckBox x:Name="PhysicsCenterOfMassToggle" Content="{local:Loc PhysicsCenterOfMass}" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Margin="0,0,0,8" Checked="OnPhysicsDebugOptionsChanged" Unchecked="OnPhysicsDebugOptionsChanged" />
                                <CheckBox x:Name="PhysicsContactsToggle" Content="{local:Loc PhysicsContacts}" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Margin="0,0,0,8" Checked="OnPhysicsDebugOptionsChanged" Unchecked="OnPhysicsDebugOptionsChanged" />
                                <CheckBox x:Name="PhysicsTreeToggle" Content="{local:Loc PhysicsTree}" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Margin="0,0,0,8" Checked="OnPhysicsDebugOptionsChanged" Unchecked="OnPhysicsDebugOptionsChanged" />
                                <CheckBox x:Name="PhysicsBondsToggle" Content="{local:Loc PhysicsBonds}" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Checked="OnPhysicsDebugOptionsChanged" Unchecked="OnPhysicsDebugOptionsChanged" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
