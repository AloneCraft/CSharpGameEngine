<platformUi:DialogWindow x:Class="CSharpGameEngine.VSExtension.ScenePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        Title="シーン デザイナーで開く" Height="320" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="このファイルには複数の IScene クラスがあります。デザイナーで開くクラスを選んでください。" />

        <ListBox x:Name="ClassList" Grid.Row="1" DisplayMemberPath="."
                 SelectionMode="Single" MouseDoubleClick="ClassList_MouseDoubleClick" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click" />
            <Button x:Name="CancelButton" Content="キャンセル" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</platformUi:DialogWindow>
