<UserControl x:Class="CSharpGameEngine.VSExtension.ShaderGraphEditorControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CSharpGameEngine.VSExtension"
 Background="#1E1E1E" Foreground="#F0F0F0" Focusable="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ToolBar Grid.Row="0" Background="#2D2D30">
   <Button x:Name="UndoButton" Content="{local:Loc ShaderGraphUndo}" Click="Undo_Click"/>
   <Button x:Name="RedoButton" Content="{local:Loc ShaderGraphRedo}" Click="Redo_Click"/>
   <Button x:Name="SaveButton" Content="{local:Loc ShaderGraphSave}" Click="Save_Click"/>
   <Separator/>
   <Button Content="{local:Loc ShaderGraphCopy}" Click="Copy_Click"/>
   <Button Content="{local:Loc ShaderGraphPaste}" Click="Paste_Click"/>
   <Button Content="{local:Loc ShaderGraphDuplicate}" Click="Duplicate_Click"/>
   <Button Content="{local:Loc ShaderGraphDelete}" Click="Delete_Click"/>
   <Button Content="{local:Loc ShaderGraphFrame}" Click="Frame_Click"/>
   <Separator/>
   <TextBlock Text="{local:Loc ShaderGraphEntry}" VerticalAlignment="Center" Margin="4,0"/>
   <ComboBox x:Name="EntryTabs" Width="210" SelectionChanged="EntryTabs_SelectionChanged"/>
   <Button Content="{local:Loc ShaderGraphOpenHlsl}" Click="OpenHlsl_Click"/>
   <TextBlock Text="{local:Loc ShaderGraphZoom}" VerticalAlignment="Center" Margin="8,0,2,0"/>
   <Slider x:Name="ZoomSlider" Width="90" Minimum="0.2" Maximum="2.0" Value="0.8" ValueChanged="ZoomSlider_ValueChanged"/>
  </ToolBar>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
   <DockPanel Grid.Column="0" Margin="4">
    <TextBlock DockPanel.Dock="Top" Text="{local:Loc ShaderGraphPalette}" FontWeight="Bold" Margin="4"/>
    <TextBox x:Name="PaletteSearch" DockPanel.Dock="Top" Margin="2" TextChanged="PaletteSearch_TextChanged" ToolTip="{local:Loc ShaderGraphPaletteSearch}"/>
    <ListBox x:Name="PaletteList" Background="#252526" Foreground="#F0F0F0" MouseDoubleClick="PaletteList_MouseDoubleClick"/>
   </DockPanel>
   <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
   <ScrollViewer x:Name="CanvasScroll" Grid.Column="2" Background="#181818" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="CanvasScroll_PreviewMouseWheel">
    <Canvas x:Name="NodeCanvas" Width="2400" Height="1800" Background="#181818"/>
   </ScrollViewer>
   <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch"/>
   <Grid Grid.Column="4" Margin="4">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="{local:Loc ShaderGraphPropertyInspector}" FontWeight="Bold" Margin="4"/>
    <ScrollViewer Grid.Row="1"><StackPanel x:Name="PropertyPanel"/></ScrollViewer>
    <TextBlock Grid.Row="2" Text="{local:Loc ShaderGraphDiagnostics}" FontWeight="Bold" Margin="4"/>
    <ListBox Grid.Row="3" x:Name="DiagnosticsList" Background="#252526" Foreground="#FFB4AB"/>
   </Grid>
  </Grid>
  <StatusBar Grid.Row="2" Background="#007ACC"><TextBlock x:Name="StatusText"/></StatusBar>
 </Grid>
</UserControl>