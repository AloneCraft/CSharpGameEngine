<UserControl x:Class="CSharpGameEngine.VSExtension.ComponentPaletteToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:CSharpGameEngine.VSExtension"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             d:DesignHeight="400" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchBox" Grid.Row="0" Margin="4"
                 TextChanged="SearchBox_TextChanged"
                 ToolTip="型名と名前空間を空白区切りで絞り込みます。" />

        <ListBox x:Name="EntryList" Grid.Row="1" Margin="4,0,4,0"
                 BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="EntryList_MouseDoubleClick"
                 KeyDown="EntryList_KeyDown"
                 PreviewMouseLeftButtonDown="EntryList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="EntryList_PreviewMouseMove">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <local:SceneVisualIconPresenter Grid.Column="0" Icon="{Binding Icon}"
                                                        VerticalAlignment="Center" Margin="0,0,6,0" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- generic instantiationや同名型は名前だけでは判別できないので
                                 名前空間を必ず添える。 -->
                            <TextBlock Text="{Binding Namespace}" FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="StatusMessage" Grid.Row="2" Margin="6,4" TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"
                   Text="ダブルクリックまたは Enter で、選択中のノードに追加します。" />
    </Grid>
</UserControl>
