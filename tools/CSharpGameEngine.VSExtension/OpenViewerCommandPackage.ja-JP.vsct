<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Include href="KnownImageIds.vsct" />

  <Commands package="guidCSharpGameEngineViewerPackage">
    <Menus>
      <Menu guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbar" priority="0x0000" type="Toolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>C# Game Engine</ButtonText>
          <CommandName>C# Game Engine</CommandName>
        </Strings>
      </Menu>
      <!-- 2026-10-01: the engine's commands moved from the Tools menu to Extensions > C# Game Engine. -->
      <Menu guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineMenu" priority="0x0100" type="Menu">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineExtensionsGroup" />
        <Strings>
          <ButtonText>C# Game Engine</ButtonText>
          <CommandName>C# Game Engine</CommandName>
        </Strings>
      </Menu>
      <!-- M0097: Visual Studio's debugger and profiler for a running game, also on the toolbar. -->
      <Menu guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineDiagnosticsMenu" priority="0x0100" type="Menu">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineDiagnosticsGroup" />
        <Strings>
          <ButtonText>診断ツール</ButtonText>
          <CommandName>診断ツール</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineExtensionsGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_EXTENSIONS" />
      </Group>
      <Group guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" priority="0x0100">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineMenu" />
      </Group>
      <Group guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineOptionsGroup" priority="0x0F00">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineMenu" />
      </Group>
      <Group guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbarGroup" priority="0x0000">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbar" />
      </Group>
      <Group guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineDiagnosticsGroup" priority="0x0800">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineMenu" />
      </Group>
      <Group guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineDiagnosticsCommandsGroup" priority="0x0100">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineDiagnosticsMenu" />
      </Group>
      <Group guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbarDiagnosticsGroup" priority="0x0800">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbar" />
      </Group>
      <Group guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbarOptionsGroup" priority="0x0F00">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbar" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="OpenSceneEditorOptionsCommandId" priority="0x0100" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineOptionsGroup" />
        <Icon guid="ImageCatalogGuid" id="Settings" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>オプション...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerCommandId" priority="0x0100" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="OpenFolder" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>C# Game Engine Viewer を開く</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="ToggleFabWatchCommandId" priority="0x0102" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="FolderOpened" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Fabダウンロード監視を開始</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="OpenFabCommandId" priority="0x0103" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="ViewInBrowser" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Fab を開く</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="OpenGameCommandId" priority="0x0104" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Play" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>ゲームを開く</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="ShowHierarchyToolWindowCommandId" priority="0x0105" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="ToolWindow" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>ヒエラルキー パネルを表示</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="ApplyGameEngineLayoutCommandId" priority="0x0106" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="LayoutPanel" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Game Engine レイアウトを適用</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="ShowInspectorToolWindowCommandId" priority="0x0107" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="ToolWindow" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>インスペクター パネルを表示</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="ShowComponentPaletteToolWindowCommandId" priority="0x0108" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="ToolWindow" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>コンポーネント パレットを表示</ButtonText>
        </Strings>
      </Button>
      <!-- 0x0108 (PreviewSceneDefinitionCommandId) は ADR-0040 で退役した。VSIX の Scene 表示は
           対象プロジェクトをビルドして別プロセスで CreateRuntime を実行する方式をやめ、SceneModel を
           直接描画する方式へ移行したため、このコマンド自体が不要になった。0x0101 と同様、この ID は
           再利用しないこと (既にインストール済みの VS がキーバインドやカスタマイズを保持している)。 -->
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="OpenSceneDesignerToolbarCommandId" priority="0x0000" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbarGroup" />
        <Icon guid="ImageCatalogGuid" id="OpenFolder" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>シーン デザイナーで開く</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="AttachDebuggerToGameCommandId" priority="0x0100" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineDiagnosticsCommandsGroup" />
        <Icon guid="ImageCatalogGuid" id="DebugSelection" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>実行中のゲームにデバッガーをアタッチ...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="MeasureCpuUsageCommandId" priority="0x0100" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineDiagnosticsCommandsGroup" />
        <Icon guid="ImageCatalogGuid" id="Processor" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>CPU 使用率を計測...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="MeasureDotNetAllocationsCommandId" priority="0x0100" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineDiagnosticsCommandsGroup" />
        <Icon guid="ImageCatalogGuid" id="Memory" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>.NET のメモリ割り当てを計測...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="MeasureGpuUsageCommandId" priority="0x0100" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineDiagnosticsCommandsGroup" />
        <Icon guid="ImageCatalogGuid" id="GaugeRound" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>GPU 使用率を計測...</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <CommandPlacement guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerCommandId" priority="0x0001">
      <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbarGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidOpenViewerCommandPackageCmdSet" id="ToggleFabWatchCommandId" priority="0x0003">
      <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbarGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidOpenViewerCommandPackageCmdSet" id="OpenFabCommandId" priority="0x0004">
      <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbarGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidOpenViewerCommandPackageCmdSet" id="OpenGameCommandId" priority="0x0005">
      <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbarGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidOpenViewerCommandPackageCmdSet" id="ShowHierarchyToolWindowCommandId" priority="0x0006">
      <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbarGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidOpenViewerCommandPackageCmdSet" id="ApplyGameEngineLayoutCommandId" priority="0x0007">
      <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbarGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidOpenViewerCommandPackageCmdSet" id="ShowInspectorToolWindowCommandId" priority="0x0008">
      <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbarGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidOpenViewerCommandPackageCmdSet" id="ShowComponentPaletteToolWindowCommandId" priority="0x0009">
      <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbarGroup" />
    </CommandPlacement>
    <!-- M0097: the toolbar carries every command of the Extensions menu: the Diagnostic Tools dropdown and Options. -->
    <CommandPlacement guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineDiagnosticsMenu" priority="0x0100">
      <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbarDiagnosticsGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidOpenViewerCommandPackageCmdSet" id="OpenSceneEditorOptionsCommandId" priority="0x0100">
      <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbarOptionsGroup" />
    </CommandPlacement>
  </CommandPlacements>

  <Symbols>
    <GuidSymbol name="guidCSharpGameEngineViewerPackage" value="{aec17804-e2e4-46e7-b373-de11af816203}" />

    <GuidSymbol name="guidOpenViewerCommandPackageCmdSet" value="{521655e5-0d1b-4255-8086-1039c5c2e3da}">
      <IDSymbol name="OpenViewerMenuGroup" value="0x1020" />
      <IDSymbol name="OpenViewerCommandId" value="0x0100" />
      <!-- 0x0101 (ShowViewerToolWindowCommandId) retired in ADR-0021 - do not reuse; the docked
           single-mesh Viewer tool window it showed was removed (scene rendering now happens in the
           "シーン" document tab, ADR-0020). -->
      <IDSymbol name="ToggleFabWatchCommandId" value="0x0102" />
      <IDSymbol name="OpenFabCommandId" value="0x0103" />
      <IDSymbol name="OpenGameCommandId" value="0x0104" />
      <IDSymbol name="ShowHierarchyToolWindowCommandId" value="0x0105" />
      <IDSymbol name="ApplyGameEngineLayoutCommandId" value="0x0106" />
      <!-- 0x0107/0x0108は退役済みで再利用しない(下記コメント参照)。0x0109はOpenSceneDesignerCommandIdが
           既に使っているため、Inspectorには次の空きである0x010Aを割り当てる。 -->
      <IDSymbol name="ShowInspectorToolWindowCommandId" value="0x010A" />
      <!-- M0052: 0x010B が次の空き。0x0110〜0x0130 は退役した Scene 一覧スロット
           (ADR-0071) なので再利用しない。新しいコマンドは 0x0133 以降を使うこと。 -->
      <IDSymbol name="ShowComponentPaletteToolWindowCommandId" value="0x010B" />
      <!-- 0x0107 (ShowShapePaletteToolWindowCommandId) は M0020 Phase 0 で退役した。シェイプ
           パレットの配置先は .scene ファイルであり、ADR-0040 Phase 9 で読み取り経路がライブ Roslyn の
           SceneModel へ移った時点で書き込み先が消え、押しても案内ダイアログを出すだけの UI に
           なっていた。プリミティブ生成そのものは tools/CSharpGameEngine.Primitive.Cli として存続し、
           Scene デザイナーの PrimitiveMesh 描画が利用している。0x0101/0x0108 と同様、この ID は
           再利用しないこと (既にインストール済みの VS がキーバインドやカスタマイズを保持している)。 -->
      <!-- 0x0108 (PreviewSceneDefinitionCommandId) retired in ADR-0040 - do not reuse; the
           execution-based preview it triggered (build the target project, run CreateRuntime out of
           process, read WorldSnapshot reflectively) was replaced by rendering the SceneModel
           directly, which needs no command of its own. -->
      <IDSymbol name="CSharpGameEngineToolbar" value="0x1021" />
      <IDSymbol name="CSharpGameEngineToolbarGroup" value="0x1022" />
      <!-- 0x1023 (SceneDefinitionContextMenuGroup) retired together with 0x0108. Group 宣言と
           IDSymbol は「退役」と書きながら両方生きたまま残っていた (親付けされた Button はゼロで
           挙動には影響していなかった) ため、2026-08 に宣言そのものを削除した。他の退役 ID と同様
           再利用しないこと。 -->
      <!-- ADR-0040 Phase 9. -->
      <IDSymbol name="OpenSceneDesignerToolbarCommandId" value="0x0131" />
      <!-- ADR-0071: 0x0109 (OpenSceneDesignerCommandId), 0x0110-0x012F (the 32 scene slots),
           0x0130 (overflow) and 0x1024 (SceneDesignerContextMenuGroup) are retired with the code-editor
           and Solution Explorer context menus: a scene JSON opens in the Scene Editor by double-click.
           Do not reuse them (installed Visual Studio instances keep key bindings and customizations). -->
      <!-- 2026-10-01: Extensions > C# Game Engine menu. M0097 took 0x0133-0x0136 and 0x102A-0x102E; the next free
           command ID is 0x0137. -->
      <IDSymbol name="CSharpGameEngineMenu" value="0x1027" />
      <IDSymbol name="CSharpGameEngineExtensionsGroup" value="0x1028" />
      <IDSymbol name="CSharpGameEngineOptionsGroup" value="0x1029" />
      <IDSymbol name="OpenSceneEditorOptionsCommandId" value="0x0132" />
      <IDSymbol name="CSharpGameEngineDiagnosticsMenu" value="0x102A" />
      <IDSymbol name="CSharpGameEngineDiagnosticsGroup" value="0x102B" />
      <IDSymbol name="CSharpGameEngineDiagnosticsCommandsGroup" value="0x102C" />
      <IDSymbol name="CSharpGameEngineToolbarDiagnosticsGroup" value="0x102D" />
      <IDSymbol name="CSharpGameEngineToolbarOptionsGroup" value="0x102E" />
      <IDSymbol name="AttachDebuggerToGameCommandId" value="0x0133" />
      <IDSymbol name="MeasureCpuUsageCommandId" value="0x0134" />
      <IDSymbol name="MeasureDotNetAllocationsCommandId" value="0x0135" />
      <IDSymbol name="MeasureGpuUsageCommandId" value="0x0136" />
      <!-- 0x010A (OpenSceneDesignerSubmenuCommandId) / 0x1026 (SceneDesignerDynamicItemsGroup) /
           0x1025 (SceneDesignerSubmenu、宣言のみで未使用のまま残っていた) は「複数 Scene を入れ子の
           サブメニューで見せる」設計と一緒に退役した。<Menu> の可視性は QueryStatus に応答する
           コマンドを登録しないと制御できず、実際には登録されていなかったため、Scene が1件でも空の
           サブメニューが常にグレー表示で残り「シーン デザイナーで開く」が2つ並んでいた。その後の固定スロット方式も
           ADR-0071 でコンテキストメニューごと退役した。
           0x0101/0x0107/0x0108 と同様、これらの ID は再利用しないこと (既にインストール済みの VS が
           キーバインドやカスタマイズを保持している)。 -->
    </GuidSymbol>
  </Symbols>
</CommandTable>
