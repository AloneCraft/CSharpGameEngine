<UserControl x:Class="CSharpGameEngine.VSExtension.HierarchyToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:imageCatalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:local="clr-namespace:CSharpGameEngine.VSExtension"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             d:DesignHeight="400" d:DesignWidth="300">
    <UserControl.Resources>
        <!--
            Start from the public Visual Studio themed TreeView styles so that the hierarchy keeps
            the shell's fonts, contrast, and high-contrast/DPI behavior. The template below only
            supplies the additional multi-selection and primary-row semantics that WPF TreeView
            does not provide on its own.
        -->
        <local:HierarchyIconSizeConverter x:Key="HierarchyIconSizeConverter" />
        <local:HierarchyIndentSizeConverter x:Key="HierarchyIndentSizeConverter" />
        <local:HierarchyIndentThicknessConverter x:Key="HierarchyIndentThicknessConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="HierarchyTreeViewItemStyle"
               TargetType="{x:Type TreeViewItem}"
               BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ThemedDialogTreeViewItemStyleKey}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="HeaderBackground" Grid.Row="0" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2" />
                                        <ColumnDefinition Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource HierarchyIndentSizeConverter}}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- The primary node is the destination of Enter/double-click. -->
                                    <Border x:Name="PrimaryAccent" Grid.Column="0"
                                            Background="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"
                                            Visibility="Collapsed" />

                                    <!-- This is deliberately a ToggleButton, not part of the row body. The
                                         preview mouse handler lets this control handle its own click so
                                         expanding a node cannot alter the hierarchy selection. -->
                                    <ToggleButton x:Name="ExpanderToggle" Grid.Column="1"
                                                  Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource HierarchyIconSizeConverter}}" Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource HierarchyIconSizeConverter}}" Margin="1,0,1,0"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Focusable="False" Background="Transparent" BorderThickness="0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ToolTip="Expand or collapse">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Grid Background="Transparent">
                                                    <imaging:CrispImage x:Name="CollapsedGlyph" Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource HierarchyIconSizeConverter}}" Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource HierarchyIconSizeConverter}}"
                                                                        Moniker="{x:Static imageCatalog:KnownMonikers.ExpandRight}" />
                                                    <imaging:CrispImage x:Name="ExpandedGlyph" Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource HierarchyIconSizeConverter}}" Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource HierarchyIconSizeConverter}}"
                                                                        Visibility="Collapsed"
                                                                        Moniker="{x:Static imageCatalog:KnownMonikers.ExpandDown}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="CollapsedGlyph" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="ExpandedGlyph" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <ContentPresenter Grid.Column="2" ContentSource="Header"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Each nested item contributes this same indentation, matching a standard
                                 TreeView while retaining our explicit Visual Studio image expander. -->
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1"
                                          Margin="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource HierarchyIndentThicknessConverter}}" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="ExpanderToggle" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>

                            <!-- Active selection mirrors Solution Explorer while the hierarchy owns
                                 keyboard focus. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMultiSelected}" Value="True" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="HeaderBackground" Property="Background"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarSelectedKey}}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextSelectedKey}}" />
                            </MultiDataTrigger>

                            <!-- Keep selected rows visibly selected, but passive, when another VS tool
                                 window such as Solution Explorer owns the keyboard focus. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMultiSelected}" Value="True" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="HeaderBackground" Property="Background"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverOverSelectedKey}}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                            </MultiDataTrigger>

                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="PrimaryAccent" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="EmptyMessage" Grid.Row="0" Margin="8"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"
                   Text="IScene を宣言する C# ファイルを開いてください。" />

        <TreeView x:Name="Tree" Grid.Row="1" SelectedItemChanged="Tree_SelectedItemChanged"
                  PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                  PreviewKeyDown="Tree_PreviewKeyDown"
                  PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                  PreviewMouseMove="Tree_PreviewMouseMove"
                  AllowDrop="True" DragOver="Tree_DragOver" DragLeave="Tree_DragLeave" Drop="Tree_Drop"
                  Style="{StaticResource {x:Static vsshell:VsResourceKeys.ThemedDialogTreeViewStyleKey}}"
                  Background="Transparent" BorderThickness="0">
            <TreeView.ItemContainerStyle>
                <StaticResource ResourceKey="HierarchyTreeViewItemStyle" />
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid VerticalAlignment="Center">
                        <StackPanel x:Name="DisplayPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsRenaming, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <imaging:CrispImage Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource HierarchyIconSizeConverter}}"
                                                Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource HierarchyIconSizeConverter}}"
                                                Margin="0,0,4,0" Moniker="{Binding NodeMoniker}" />
                            <ItemsControl ItemsSource="{Binding ComponentIcons}" Margin="0,0,4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:SceneVisualIconPresenter Icon="{Binding}"
                                            IconSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource HierarchyIconSizeConverter}}"
                                            Margin="0,0,2,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ComponentSummary}" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
                        </StackPanel>
                        <TextBox x:Name="RenameBox" MinWidth="120" Padding="2,0"
                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" />
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <Border x:Name="ComponentDropFeedback" Grid.Row="1" Margin="8" Padding="8"
                HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="280"
                Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarSelectedKey}}"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ComponentDropFeedbackText" TextWrapping="Wrap"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextSelectedKey}}" />
        </Border>

        <!-- ノード並べ替えドラッグの挿入位置プレビュー。前/後は水平線、子として取り込む場合は
             対象行を囲む枠線。位置・サイズはコードから(TranslatePoint基準で)決める。 -->
        <Border x:Name="ReorderInsertionLine" Grid.Row="1" Height="2"
                HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Background="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"
                Visibility="Collapsed" IsHitTestVisible="False" />
        <Border x:Name="ReorderIntoHighlight" Grid.Row="1"
                HorizontalAlignment="Stretch" VerticalAlignment="Top"
                BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"
                BorderThickness="2" Background="Transparent"
                Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</UserControl>
