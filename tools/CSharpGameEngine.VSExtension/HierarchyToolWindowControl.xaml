<UserControl x:Class="CSharpGameEngine.VSExtension.HierarchyToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="400" d:DesignWidth="300">
    <Grid>
        <TreeView x:Name="Tree" SelectedItemChanged="Tree_SelectedItemChanged"
                  AllowDrop="True" DragEnter="Tree_DragEnterOrOver" DragOver="Tree_DragEnterOrOver" Drop="Tree_Drop">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Node.Name}" />
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
