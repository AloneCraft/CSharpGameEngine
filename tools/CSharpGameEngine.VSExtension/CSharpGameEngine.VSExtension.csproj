<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Directory.Build.props leaves LangVersion at "default", which resolves to C# 7.3 for
         net472 - too old for this project's Nullable annotations. Pin explicitly, matching the
         version VS's own local VSIXProject template uses. -->
    <LangVersion>14</LangVersion>

    <!-- VSIX settings -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <!-- The VSSDK defaults this to Exp. Keep its deployment/debug target aligned with
         StartArguments so F5 never launches the previously-corrupted Exp hive. -->
    <VSSDKTargetPlatformRegRootSuffix>CgeFixed</VSSDKTargetPlatformRegRootSuffix>
    <!--
      A normal Visual Studio F5 must deploy to the same CgeFixed hive before devenv starts.
      Previously only the package was built; opening CgeFixed manually then continued to execute
      an arbitrary old copy from Extensions.  Keep command-line `dotnet build` deployment-free
      because the VSSDK deployment target requires desktop MSBuild.
    -->
    <DeployExtension Condition="'$(BuildingInsideVisualStudio)' == 'true'">true</DeployExtension>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <UserEcsProjectSolutionPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\UserEcsProject.slnx'))</UserEcsProjectSolutionPath>
    <StartArguments>/rootsuffix CgeFixed &quot;$(UserEcsProjectSolutionPath)&quot;</StartArguments>

    <!-- VSIX deployment copies this assembly out of the repo (into the Extensions hive), so a
         runtime "walk up from my own location" search can never find CSharpGameEngine.slnx.
         Bake the repo root known at build time into the assembly instead; OpenViewerCommand
         still validates it against the marker file at runtime before trusting it. -->
    <CSharpGameEngineRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</CSharpGameEngineRepoRoot>
    <!-- Bump each deployable VSIX revision.  The installer/version cache must never be asked to
         distinguish a newly fixed extension from a prior binary with the same identity. -->
    <CSharpGameEngineVsixVersion>0.1.4</CSharpGameEngineVsixVersion>
    <CSharpGameEngineBuildUtc>$([System.DateTime]::UtcNow.ToString('O'))</CSharpGameEngineBuildUtc>
    <CSharpGameEngineGitRevision>unknown</CSharpGameEngineGitRevision>

    <!-- Release tracking for the Scene DSL descriptors is owned by CSharpGameEngine.CodeAnalysis,
         which is where they actually ship as an analyzer. Tracking them again here would create a
         second list to keep in sync. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.8.739" />

    <!-- ADR-0021: GameEngineLayout casts EnvDTE.DTE.CommandBars (typed as plain System.Object)
         to this strongly-typed interface to show the "C# Game Engine" toolbar programmatically -
         no .vsct flag makes a new toolbar visible by default (confirmed against VSCT.xsd and
         Microsoft's own shipped .vsct files; DefaultDocked only controls docked-vs-floating, not
         shown-vs-hidden). ExcludeAssets="runtime" matches the SDK metapackage above - the real DLL
         is supplied by devenv.exe itself at load time. -->
    <PackageReference Include="Microsoft.VisualStudio.CommandBars" Version="17.14.40260" ExcludeAssets="runtime" />

    <!-- In-process D3D12 rendering (ADR-0008): TerraFX.Interop.Windows (used by the net10.0
         Graphics.D3D12 project) targets net5.0+ only and cannot be referenced from this net472
         project. Vortice.Windows 2.4.2 is the last version series that still targets
         netstandard2.0, so it's usable here - confirmed against real NuGet package metadata
         before adding. Deliberately not shared with Graphics.D3D12: this stays its own
         self-contained net472 rendering path. -->
    <PackageReference Include="Vortice.Direct3D12" Version="2.4.2" />
    <PackageReference Include="Vortice.DXGI" Version="2.4.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="2.4.2" />

    <!-- ADR-0010/ADR-0019: deserializes the JSON produced by both out-of-process import bridges
         (CSharpGameEngine.Import.Fbx.Cli and CSharpGameEngine.Import.Gltf.Cli). Neither AssimpNet
         nor SharpGLTF.Core is referenced directly by this project anymore - see
         ExternalFbxLoader.cs/ExternalGltfLoader.cs. 10.0.1 was the version originally forced by a
         since-removed transitive SharpGLTF.Core dependency; kept pinned since it's already proven
         to work on net472. -->
    <PackageReference Include="System.Text.Json" Version="10.0.1" />

    <!-- Project-selected component icons may be SVG as well as PNG. SharpVectors stays entirely
         in the WPF presentation layer; unlike the VS SDK references above its runtime assets are
         copy-local and therefore included by the VSSDK VSIX container target. -->
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />

    <!-- ADR-0040: the Scene editor reads scenes from live Roslyn instead of a .scene file, so this
         project compiles against Roslyn and the VisualStudioWorkspace. ExcludeAssets="runtime" is
         essential - devenv.exe already hosts Roslyn, and shipping our own copy inside the .vsix
         would load a second set of the same assemblies. Version 4.14.0 matches what VS 17.14 hosts
         and what CSharpGameEngine.CodeAnalysis compiles against, so the shared source behaves
         identically in both hosts. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" ExcludeAssets="runtime" />
    <!-- VisualStudioWorkspace lives here, and it is not part of the Microsoft.VisualStudio.SDK
         metapackage (confirmed by CS0234 on Microsoft.VisualStudio.LanguageServices before adding
         it). Versioned with Roslyn, not with the VS SDK. -->
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="4.14.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    ADR-0040: the one and only Scene analysis implementation, shared as source with
    CSharpGameEngine.CodeAnalysis (the Source Generator). Both hosts run the same code on their own
    Roslyn instance - the SG on the compiler's Compilation, this project on the
    VisualStudioWorkspace's - which is what makes "the SG accepts it but the editor breaks" a
    structurally impossible class of bug. It is linked rather than referenced because an analyzer
    cannot reliably carry a dependency DLL, and because a DLL here would need its own Roslyn.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\CSharpGameEngine.SceneModel\**\*.cs"
             Exclude="..\..\src\CSharpGameEngine.SceneModel\obj\**\*.cs;..\..\src\CSharpGameEngine.SceneModel\bin\**\*.cs"
             Link="SceneModel\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- OleMenuCommandService's base MenuCommandService type lives here; not referenced by
         default for SDK-style net472 projects. -->
    <Reference Include="System.Design" />
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="OpenViewerCommandPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <!-- Template source is copied into an item-template archive; it is not source for this VSIX. -->
  <ItemGroup>
    <Compile Remove="ItemTemplates\**\*.cs" />
  </ItemGroup>
  <!--
    Item templates are authored as ordinary source files and zipped by the VSSDK's ZipItems target.
    TemplateProjectOutputGroup then exposes the generated archive to source.extension.vsixmanifest,
    so the installed VSIX always receives the template that was built from this checkout.
  -->
  <ItemGroup>
    <VSTemplate Include="ItemTemplates\CSharp\GameEngine\SceneFile\SceneFile.vstemplate">
      <TemplateType>Item</TemplateType>
      <Language>CSharp</Language>
      <OutputSubPath>GameEngine</OutputSubPath>
      <Culture>1033</Culture>
    </VSTemplate>
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CSharpGameEngineRepoRoot" Value="$(CSharpGameEngineRepoRoot)" />
    <AssemblyMetadata Include="CSharpGameEngineVsixVersion" Value="$(CSharpGameEngineVsixVersion)" />
    <AssemblyMetadata Include="CSharpGameEngineBuildUtc" Value="$(CSharpGameEngineBuildUtc)" />
    <AssemblyMetadata Include="CSharpGameEngineGitRevision" Value="$(CSharpGameEngineGitRevision)" />
    <AssemblyMetadata Include="CSharpGameEngineBuildOutputPath" Value="$(TargetPath)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets CSharpGameEngine.VSExtension.Tests unit-test internal, VS-independent classes
         (FabDownloadWatcher, KnownFolders) directly, since live VS UI automation proved unreliable
         for verifying this logic (ADR-0011). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSharpGameEngine.VSExtension.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <!--
    VsixUtil writes a regenerated template manifest over the previous file without truncating it.
    When a template becomes shorter, stale XML remains at the end and Visual Studio silently ignores
    every item template in the VSIX.  Delete the prior output and its cache before every generation.
  -->
  <Target Name="ClearGeneratedItemTemplateManifest"
          BeforeTargets="GenerateTemplatesManifest">
    <ItemGroup>
      <_GeneratedItemTemplateArtifact Include="$(IntermediateOutputPath)TemplateManifests\*.vstman" />
      <_GeneratedItemTemplateArtifact Include="$(CreateTemplateManifestsCacheFile)" />
      <_GeneratedItemTemplateArtifact Include="$(TemplateFileManifest)" />
    </ItemGroup>
    <Delete Files="@(_GeneratedItemTemplateArtifact)" />
  </Target>
  <!-- SourceRevisionId is discovered by the SDK after project evaluation. Update the metadata
       immediately before AssemblyInfo is generated so the installed assembly exposes the actual
       checkout revision rather than a build-machine setting. -->
  <Target Name="ResolveCSharpGameEngineVsixBuildIdentity"
          BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <CSharpGameEngineGitRevision Condition="'$(SourceRevisionId)' != ''">$(SourceRevisionId)</CSharpGameEngineGitRevision>
    </PropertyGroup>
    <ItemGroup>
      <!--
        `Update` without an item metadata predicate updates *every* AssemblyMetadata item in
        SDK-style projects.  That used to replace the repo root, VSIX version, build time and
        output path with the Git revision, making the on-screen identity incapable of proving
        which VSIX was loaded.  Replace only the one late-bound item instead.
      -->
      <AssemblyMetadata Remove="CSharpGameEngineGitRevision" />
      <AssemblyMetadata Include="CSharpGameEngineGitRevision" Value="$(CSharpGameEngineGitRevision)" />
    </ItemGroup>
  </Target>
  <!-- TemplateProjectOutputGroup is normally consumed by a referencing VSIX project. This project
       owns both the VSTemplate and the VSIX, so add its generated archive to the current container. -->
  <Target Name="IncludeGeneratedItemTemplatesInVsix"
          BeforeTargets="GetVsixSourceItems"
          DependsOnTargets="TemplateProjectOutputGroup;ZipItems">
    <ItemGroup>
      <VSIXSourceItem Include="$(OutDir)ItemTemplates\CSharp\GameEngine\1033\SceneFile.zip">
        <VSIXSubPath>ItemTemplates\CSharp\GameEngine\1033</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

</Project>
