<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <NeutralLanguage>en-US</NeutralLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Directory.Build.props leaves LangVersion at "default", which resolves to C# 7.3 for
         net472 - too old for this project's Nullable annotations. Pin explicitly, matching the
         version VS's own local VSIXProject template uses. -->
    <LangVersion>14</LangVersion>

    <!-- VSIX settings -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeSatelliteAssembliesInVSIXContainer>true</IncludeSatelliteAssembliesInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <!-- Refresh the embedded identity on every Visual Studio build so an older VSIX cannot be reused silently. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <!-- The VSSDK defaults this to Exp. Keep its deployment/debug target aligned with
         StartArguments so F5 never launches the previously-corrupted Exp hive. -->
    <VSSDKTargetPlatformRegRootSuffix>CgeFixed</VSSDKTargetPlatformRegRootSuffix>
    <!--
      A normal Visual Studio F5 must deploy to the same CgeFixed hive before devenv starts.
      Previously only the package was built; opening CgeFixed manually then continued to execute
      an arbitrary old copy from Extensions.  Keep command-line `dotnet build` deployment-free
      because the VSSDK deployment target requires desktop MSBuild.
    -->
    <DeployExtension Condition="'$(BuildingInsideVisualStudio)' == 'true'">true</DeployExtension>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <UserEcsProjectSolutionPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\UserEcsProject.slnx'))</UserEcsProjectSolutionPath>
    <StartArguments>/rootsuffix CgeFixed &quot;$(UserEcsProjectSolutionPath)&quot;</StartArguments>

    <!-- VSIX deployment copies this assembly out of the repo (into the Extensions hive), so a
         runtime "walk up from my own location" search can never find CSharpGameEngine.slnx.
         Bake the repo root known at build time into the assembly instead; OpenViewerCommand
         still validates it against the marker file at runtime before trusting it. -->
    <CSharpGameEngineRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</CSharpGameEngineRepoRoot>
    <!-- Bump each deployable VSIX revision.  The installer/version cache must never be asked to
         distinguish a newly fixed extension from a prior binary with the same identity. -->
    <CSharpGameEngineVsixVersion>0.1.7</CSharpGameEngineVsixVersion>
    <CSharpGameEngineBuildUtc>$([System.DateTime]::UtcNow.ToString('O'))</CSharpGameEngineBuildUtc>
    <CSharpGameEngineGitRevision>unknown</CSharpGameEngineGitRevision>
    <CgeEditorPreviewHostProject>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../CSharpGameEngine.EditorPreview.Host/CSharpGameEngine.EditorPreview.Host.csproj'))</CgeEditorPreviewHostProject>

    <!-- Release tracking for the Scene DSL descriptors is owned by CSharpGameEngine.CodeAnalysis,
         which is where they actually ship as an analyzer. Tracking them again here would create a
         second list to keep in sync. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
    <ProjectReference Include="..\..\src\CSharpGameEngine.Contracts\CSharpGameEngine.Contracts.csproj" />
    <ProjectReference Include="..\..\src\CSharpGameEngine.ShaderGraph\CSharpGameEngine.ShaderGraph.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.TemplateWizardInterface" Version="17.10.40170" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.8.739" />

    <!-- The net472 compiler does not provide the runtime-agnostic C# language feature types used
         by this project. These polyfills previously arrived accidentally through the removed
         Vortice/SharpGen renderer dependency; keep the actual build requirement explicit and
         prevent the source generator from becoming a VSIX runtime asset. -->
    <PackageReference Include="PolySharp" Version="1.10.0" PrivateAssets="all" />

    <!-- System.HashCode is not part of net472. This was also hidden behind the old
         Vortice.Mathematics dependency and remains an explicit copy-local runtime requirement. -->
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="1.1.1" />

    <!-- ADR-0021: GameEngineLayout casts EnvDTE.DTE.CommandBars (typed as plain System.Object)
         to this strongly-typed interface to show the "C# Game Engine" toolbar programmatically -
         no .vsct flag makes a new toolbar visible by default (confirmed against VSCT.xsd and
         Microsoft's own shipped .vsct files; DefaultDocked only controls docked-vs-floating, not
         shown-vs-hidden). ExcludeAssets="runtime" matches the SDK metapackage above - the real DLL
         is supplied by devenv.exe itself at load time. -->
    <PackageReference Include="Microsoft.VisualStudio.CommandBars" Version="17.14.40260" ExcludeAssets="runtime" />

    <!-- ADR-0010/ADR-0019: deserializes the JSON produced by both out-of-process import bridges
         (CSharpGameEngine.Import.Fbx.Cli and CSharpGameEngine.Import.Gltf.Cli). Neither AssimpNet
         nor SharpGLTF.Core is referenced directly by this project anymore - see
         ExternalFbxLoader.cs/ExternalGltfLoader.cs. 10.0.1 was the version originally forced by a
         since-removed transitive SharpGLTF.Core dependency; kept pinned since it's already proven
         to work on net472. -->
    <PackageReference Include="System.Text.Json" Version="10.0.1" />

    <!-- Project-selected component icons may be SVG as well as PNG. SharpVectors stays entirely
         in the WPF presentation layer; unlike the VS SDK references above its runtime assets are
         copy-local and therefore included by the VSSDK VSIX container target. -->
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />

    <!-- ADR-0040: the Scene editor reads scenes from live Roslyn instead of a .scene file, so this
         project compiles against Roslyn and the VisualStudioWorkspace. ExcludeAssets="runtime" is
         essential - devenv.exe already hosts Roslyn, and shipping our own copy inside the .vsix
         would load a second set of the same assemblies. Version 4.14.0 matches what VS 17.14 hosts
         and what CSharpGameEngine.CodeAnalysis compiles against, so the shared source behaves
         identically in both hosts. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" ExcludeAssets="runtime" />
    <!-- VisualStudioWorkspace lives here, and it is not part of the Microsoft.VisualStudio.SDK
         metapackage (confirmed by CS0234 on Microsoft.VisualStudio.LanguageServices before adding
         it). Versioned with Roslyn, not with the VS SDK. -->
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="4.14.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    ADR-0040: the one and only Scene analysis implementation, shared as source with
    CSharpGameEngine.CodeAnalysis (the Source Generator). Both hosts run the same code on their own
    Roslyn instance - the SG on the compiler's Compilation, this project on the
    VisualStudioWorkspace's - which is what makes "the SG accepts it but the editor breaks" a
    structurally impossible class of bug. It is linked rather than referenced because an analyzer
    cannot reliably carry a dependency DLL, and because a DLL here would need its own Roslyn.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\CSharpGameEngine.SceneModel\**\*.cs"
             Exclude="..\..\src\CSharpGameEngine.SceneModel\obj\**\*.cs;..\..\src\CSharpGameEngine.SceneModel\bin\**\*.cs"
             Link="SceneModel\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- OleMenuCommandService's base MenuCommandService type lives here; not referenced by
         default for SDK-style net472 projects. -->
    <Reference Include="System.Design" />
    <Reference Include="System.ComponentModel.Composition" />
    <!-- WindowPane.PreProcessMessage is the VS TranslateAccelerator boundary and its public
         contract uses System.Windows.Forms.Message even for WPF-hosted panes. -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="OpenViewerCommandPackage.en-US.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <VSCTCompile Include="OpenViewerCommandPackage.ja-JP.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <EmbeddedResource Update="VSPackage.en-US.resx">
      <MergeWithCTO>true</MergeWithCTO>
      <LogicalName>VSPackage.en-US.Resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="VSPackage.ja-JP.resx">
      <MergeWithCTO>true</MergeWithCTO>
      <LogicalName>VSPackage.ja-JP.Resources</LogicalName>
    </EmbeddedResource>
    <Content Include="ja-JP\Extension.vsixlangpack">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>ja-JP</VSIXSubPath>
    </Content>
  </ItemGroup>

  <!-- Template source is copied into an item-template archive; it is not source for this VSIX. -->
  <ItemGroup>
    <Compile Remove="ItemTemplates\**\*.cs" />
    <Compile Include="..\CSharpGameEngine.ProjectTemplates\GameProjectGenerator.cs" Link="ProjectTemplates\GameProjectGenerator.cs" />
  </ItemGroup>
  <!--
    Item templates are authored as ordinary source files and zipped by the VSSDK's ZipItems target.
    TemplateProjectOutputGroup then exposes the generated archive to source.extension.vsixmanifest,
    so the installed VSIX always receives the template that was built from this checkout.
  -->
  <ItemGroup>
    <VSTemplate Include="ItemTemplates\CSharp\GameEngine\SceneFile\SceneFile.vstemplate">
      <TemplateType>Item</TemplateType>
      <Language>CSharp</Language>
      <OutputSubPath>GameEngine</OutputSubPath>
      <Culture>1033</Culture>
    </VSTemplate>
    <VSTemplate Include="ItemTemplates\CSharp\GameEngine\SceneFile\SceneFile.vstemplate">
      <TemplateType>Item</TemplateType>
      <Language>CSharp</Language>
      <OutputSubPath>GameEngine</OutputSubPath>
      <Culture>1041</Culture>
    </VSTemplate>
    <VSTemplate Include="ItemTemplates\CSharp\GameEngine\ShaderGraph\ShaderGraph.vstemplate"><TemplateType>Item</TemplateType><Language>CSharp</Language><OutputSubPath>GameEngine</OutputSubPath><Culture>1033</Culture></VSTemplate>
    <VSTemplate Include="ItemTemplates\CSharp\GameEngine\ShaderGraph\ShaderGraph.vstemplate"><TemplateType>Item</TemplateType><Language>CSharp</Language><OutputSubPath>GameEngine</OutputSubPath><Culture>1041</Culture></VSTemplate>
    <VSTemplate Include="ItemTemplates\CSharp\GameEngine\ShaderSubgraph\ShaderSubgraph.vstemplate"><TemplateType>Item</TemplateType><Language>CSharp</Language><OutputSubPath>GameEngine</OutputSubPath><Culture>1033</Culture></VSTemplate>
    <VSTemplate Include="ItemTemplates\CSharp\GameEngine\ShaderSubgraph\ShaderSubgraph.vstemplate"><TemplateType>Item</TemplateType><Language>CSharp</Language><OutputSubPath>GameEngine</OutputSubPath><Culture>1041</Culture></VSTemplate>
    <VSTemplate Include="ProjectTemplates\CSharp\GameEngine\ThirdPerson\ThirdPerson.vstemplate"><TemplateType>Project</TemplateType><Language>CSharp</Language><OutputSubPath>GameEngine</OutputSubPath><Culture>1033</Culture></VSTemplate>
    <VSTemplate Include="ProjectTemplates\CSharp\GameEngine\ThirdPerson\ThirdPerson.vstemplate"><TemplateType>Project</TemplateType><Language>CSharp</Language><OutputSubPath>GameEngine</OutputSubPath><Culture>1041</Culture></VSTemplate>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\Shaders\Stage.cgeshadergraph" Link="ShaderGraphTemplates\Stage.cgeshadergraph"><IncludeInVSIX>true</IncludeInVSIX><VSIXSubPath>ShaderGraphTemplates</VSIXSubPath></Content>
    <Content Include="..\..\assets\Shaders\Pbr.cgesubgraph" Link="ShaderGraphTemplates\Pbr.cgesubgraph"><IncludeInVSIX>true</IncludeInVSIX><VSIXSubPath>ShaderGraphTemplates</VSIXSubPath></Content>
    <Content Include="..\..\assets\Shaders\Shadow.cgesubgraph" Link="ShaderGraphTemplates\Shadow.cgesubgraph"><IncludeInVSIX>true</IncludeInVSIX><VSIXSubPath>ShaderGraphTemplates</VSIXSubPath></Content>
    <Content Include="..\..\assets\Shaders\Pcss.cgesubgraph" Link="ShaderGraphTemplates\Pcss.cgesubgraph"><IncludeInVSIX>true</IncludeInVSIX><VSIXSubPath>ShaderGraphTemplates</VSIXSubPath></Content>
    <Content Include="..\..\assets\Shaders\Aces.cgesubgraph" Link="ShaderGraphTemplates\Aces.cgesubgraph"><IncludeInVSIX>true</IncludeInVSIX><VSIXSubPath>ShaderGraphTemplates</VSIXSubPath></Content>
    <Content Include="..\..\assets\Shaders\Model.cgeshadergraph" Link="ShaderGraphTemplates\Model.cgeshadergraph"><IncludeInVSIX>true</IncludeInVSIX><VSIXSubPath>ShaderGraphTemplates</VSIXSubPath></Content>
    <Content Include="..\..\assets\Shaders\Triangle.cgeshadergraph" Link="ShaderGraphTemplates\Triangle.cgeshadergraph"><IncludeInVSIX>true</IncludeInVSIX><VSIXSubPath>ShaderGraphTemplates</VSIXSubPath></Content>
    <CgeShaderGraph Include="../../assets/Shaders/Stage.cgeshadergraph" />
    <CgeShaderSubgraph Include="../../assets/Shaders/Pbr.cgesubgraph" />
    <CgeShaderSubgraph Include="../../assets/Shaders/Shadow.cgesubgraph" />
    <CgeShaderSubgraph Include="../../assets/Shaders/Pcss.cgesubgraph" />
    <CgeShaderSubgraph Include="../../assets/Shaders/Aces.cgesubgraph" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="CSharpGameEngineRepoRoot" Value="$(CSharpGameEngineRepoRoot)" />
    <AssemblyMetadata Include="CSharpGameEngineVsixVersion" Value="$(CSharpGameEngineVsixVersion)" />
    <AssemblyMetadata Include="CSharpGameEngineBuildUtc" Value="$(CSharpGameEngineBuildUtc)" />
    <AssemblyMetadata Include="CSharpGameEngineGitRevision" Value="$(CSharpGameEngineGitRevision)" />
    <AssemblyMetadata Include="CSharpGameEngineBuildOutputPath" Value="$(TargetPath)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets CSharpGameEngine.VSExtension.Tests unit-test internal, VS-independent classes
         (FabDownloadWatcher, KnownFolders) directly, since live VS UI automation proved unreliable
         for verifying this logic (ADR-0011). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSharpGameEngine.VSExtension.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <!--
    VsixUtil writes a regenerated template manifest over the previous file without truncating it.
    When a template becomes shorter, stale XML remains at the end and Visual Studio silently ignores
    every item template in the VSIX.  Delete the prior output and its cache before every generation.
  -->
  <Target Name="ClearGeneratedItemTemplateManifest"
          BeforeTargets="GenerateTemplatesManifest">
    <ItemGroup>
      <_GeneratedItemTemplateArtifact Include="$(IntermediateOutputPath)TemplateManifests\*.vstman" />
      <_GeneratedItemTemplateArtifact Include="$(CreateTemplateManifestsCacheFile)" />
      <_GeneratedItemTemplateArtifact Include="$(TemplateFileManifest)" />
    </ItemGroup>
    <Delete Files="@(_GeneratedItemTemplateArtifact)" />
  </Target>
  <!-- SourceRevisionId is discovered by the SDK after project evaluation. Update the metadata
       immediately before AssemblyInfo is generated so the installed assembly exposes the actual
       checkout revision rather than a build-machine setting. -->
  <!-- Touch the generated AssemblyInfo before CoreCompile so a normal incremental build refreshes the identity metadata. -->
  <Target Name="RefreshCSharpGameEngineVsixBuildIdentity" BeforeTargets="CoreCompile">
    <Touch Files="$(GeneratedAssemblyInfoFile)" AlwaysCreate="true" />
  </Target>
  <Target Name="ResolveCSharpGameEngineVsixBuildIdentity"
          BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <CSharpGameEngineGitRevision Condition="'$(SourceRevisionId)' != ''">$(SourceRevisionId)</CSharpGameEngineGitRevision>
      <CSharpGameEngineBuildUtc>$([System.DateTime]::UtcNow.ToString('O'))</CSharpGameEngineBuildUtc>
    </PropertyGroup>
    <ItemGroup>
      <!--
        `Update` without an item metadata predicate updates *every* AssemblyMetadata item in
        SDK-style projects.  That used to replace the repo root, VSIX version, build time and
        output path with the Git revision, making the on-screen identity incapable of proving
        which VSIX was loaded.  Replace only the one late-bound item instead.
      -->
      <AssemblyMetadata Remove="CSharpGameEngineBuildUtc" />
      <AssemblyMetadata Include="CSharpGameEngineBuildUtc" Value="$(CSharpGameEngineBuildUtc)" />
      <AssemblyMetadata Remove="CSharpGameEngineGitRevision" />
      <AssemblyMetadata Include="CSharpGameEngineGitRevision" Value="$(CSharpGameEngineGitRevision)" />
    </ItemGroup>
  </Target>
  <!-- TemplateProjectOutputGroup is normally consumed by a referencing VSIX project. This project
       owns both the VSTemplate and the VSIX, so add its generated archive to the current container. -->
  <Target Name="IncludeGeneratedItemTemplatesInVsix"
          BeforeTargets="GetVsixSourceItems"
          DependsOnTargets="TemplateProjectOutputGroup;ZipItems">
    <ItemGroup>
      <VSIXSourceItem Include="$(OutDir)ItemTemplates\CSharp\GameEngine\1033\SceneFile.zip">
        <VSIXSubPath>ItemTemplates\CSharp\GameEngine\1033</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(OutDir)ItemTemplates\CSharp\GameEngine\1041\SceneFile.zip">
        <VSIXSubPath>ItemTemplates\CSharp\GameEngine\1041</VSIXSubPath>
      </VSIXSourceItem>
      <VSIXSourceItem Include="$(OutDir)ItemTemplates\CSharp\GameEngine\1033\ShaderGraph.zip"><VSIXSubPath>ItemTemplates\CSharp\GameEngine\1033</VSIXSubPath></VSIXSourceItem>
      <VSIXSourceItem Include="$(OutDir)ItemTemplates\CSharp\GameEngine\1041\ShaderGraph.zip"><VSIXSubPath>ItemTemplates\CSharp\GameEngine\1041</VSIXSubPath></VSIXSourceItem>
      <VSIXSourceItem Include="$(OutDir)ItemTemplates\CSharp\GameEngine\1033\ShaderSubgraph.zip"><VSIXSubPath>ItemTemplates\CSharp\GameEngine\1033</VSIXSubPath></VSIXSourceItem>
      <VSIXSourceItem Include="$(OutDir)ItemTemplates\CSharp\GameEngine\1041\ShaderSubgraph.zip"><VSIXSubPath>ItemTemplates\CSharp\GameEngine\1041</VSIXSubPath></VSIXSourceItem>
      <VSIXSourceItem Include="$(OutDir)ProjectTemplates\CSharp\GameEngine\1033\ThirdPerson.zip"><VSIXSubPath>ProjectTemplates\CSharp\GameEngine\1033</VSIXSubPath></VSIXSourceItem>
      <VSIXSourceItem Include="$(OutDir)ProjectTemplates\CSharp\GameEngine\1041\ThirdPerson.zip"><VSIXSubPath>ProjectTemplates\CSharp\GameEngine\1041</VSIXSubPath></VSIXSourceItem>
    </ItemGroup>
  </Target>

  <!-- F-L8-018: the VSIX is only a client. Publish the exact same-configuration x64 Preview Host
       into an owned staging directory and package its complete framework-dependent closure with
       the compiled Stage artifact. No native renderer assembly is loaded into devenv.exe. -->
  <Target Name="StageEditorPreviewHostForVsix"
          BeforeTargets="GetVsixSourceItems"
          DependsOnTargets="CompileCgeShaderGraphs">
    <PropertyGroup>
      <CgeEditorPreviewHostStageDirectory Condition="$([System.IO.Path]::IsPathRooted('$(IntermediateOutputPath)'))">$(IntermediateOutputPath)PreviewHost\</CgeEditorPreviewHostStageDirectory>
      <CgeEditorPreviewHostStageDirectory Condition="'$(CgeEditorPreviewHostStageDirectory)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)PreviewHost/'))</CgeEditorPreviewHostStageDirectory>
    </PropertyGroup>
    <RemoveDir Directories="$(CgeEditorPreviewHostStageDirectory)" />
    <MakeDir Directories="$(CgeEditorPreviewHostStageDirectory)" />
    <MSBuild Projects="$(CgeEditorPreviewHostProject)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);Platform=x64;SelfContained=false;PublishDir=$(CgeEditorPreviewHostStageDirectory)"
             BuildInParallel="false" />
    <MakeDir Directories="$(CgeEditorPreviewHostStageDirectory)Shaders" />
    <Copy SourceFiles="$(CgeShaderGraphIntermediateDirectory)Stage.cgeshaderartifact"
          DestinationFolder="$(CgeEditorPreviewHostStageDirectory)Shaders" />
    <ItemGroup>
      <_CgeEditorPreviewHostPayload Include="$(CgeEditorPreviewHostStageDirectory)**/*"
                                    Exclude="$(CgeEditorPreviewHostStageDirectory)**/*.pdb" />
      <VSIXSourceItem Include="@(_CgeEditorPreviewHostPayload)">
        <VSIXSubPath>PreviewHost/%(RecursiveDir)</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

  <!-- ADR-0065: the authoring bridges and the shader compiler ship inside the VSIX (Bridges/<name>/),
       so the editor works for game projects outside the engine repository. Each is published
       framework-dependent into an owned staging directory, like the Preview Host. -->
  <ItemGroup>
    <CgeVsixBridge Include="$(MSBuildProjectDirectory)/../CSharpGameEngine.Import.Gltf.Cli/CSharpGameEngine.Import.Gltf.Cli.csproj" Platform="AnyCPU" />
    <CgeVsixBridge Include="$(MSBuildProjectDirectory)/../CSharpGameEngine.Import.Fbx.Cli/CSharpGameEngine.Import.Fbx.Cli.csproj" Platform="AnyCPU" />
    <CgeVsixBridge Include="$(MSBuildProjectDirectory)/../CSharpGameEngine.Import.AssetAuthoring.Cli/CSharpGameEngine.Import.AssetAuthoring.Cli.csproj" Platform="AnyCPU" />
    <CgeVsixBridge Include="$(MSBuildProjectDirectory)/../CSharpGameEngine.Primitive.Cli/CSharpGameEngine.Primitive.Cli.csproj" Platform="AnyCPU" />
    <CgeVsixBridge Include="$(MSBuildProjectDirectory)/../CSharpGameEngine.ShaderGraph.Cli/CSharpGameEngine.ShaderGraph.Cli.csproj" Platform="x64" />
  </ItemGroup>
  <!-- ADR-0068: the ThirdPerson project template needs its source project and the engine SDK package it restores from. -->
  <PropertyGroup>
    <CgeTemplateSourceDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../templates/CSharpGameEngine.Templates.ThirdPerson/'))</CgeTemplateSourceDirectory>
    <CgeSdkPackageProject>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../packaging/CSharpGameEngine.Sdk/CSharpGameEngine.Sdk.csproj'))</CgeSdkPackageProject>
  </PropertyGroup>
  <Target Name="StageProjectTemplateContentForVsix" BeforeTargets="GetVsixSourceItems">
    <PropertyGroup>
      <CgeSdkPackageStageDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)Packages/'))</CgeSdkPackageStageDirectory>
    </PropertyGroup>
    <RemoveDir Directories="$(CgeSdkPackageStageDirectory)" />
    <MSBuild Projects="$(CgeSdkPackageProject)" Targets="Restore;Pack" Properties="Configuration=$(Configuration);PackageOutputPath=$(CgeSdkPackageStageDirectory)" BuildInParallel="false" />
    <ItemGroup>
      <_CgeSdkPackage Include="$(CgeSdkPackageStageDirectory)*.nupkg" />
      <VSIXSourceItem Include="@(_CgeSdkPackage)">
        <VSIXSubPath>Packages</VSIXSubPath>
      </VSIXSourceItem>
      <_CgeTemplateSource Include="$(CgeTemplateSourceDirectory)**/*" Exclude="$(CgeTemplateSourceDirectory)bin/**;$(CgeTemplateSourceDirectory)obj/**;$(CgeTemplateSourceDirectory).cge/**;$(CgeTemplateSourceDirectory)*.csproj" />
      <VSIXSourceItem Include="@(_CgeTemplateSource)">
        <VSIXSubPath>ProjectTemplateSources/ThirdPerson/%(RecursiveDir)</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

  <Target Name="StageBridgesForVsix" BeforeTargets="GetVsixSourceItems">
    <PropertyGroup>
      <CgeBridgeStageDirectory Condition="$([System.IO.Path]::IsPathRooted('$(IntermediateOutputPath)'))">$(IntermediateOutputPath)Bridges\</CgeBridgeStageDirectory>
      <CgeBridgeStageDirectory Condition="'$(CgeBridgeStageDirectory)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)Bridges/'))</CgeBridgeStageDirectory>
    </PropertyGroup>
    <RemoveDir Directories="$(CgeBridgeStageDirectory)" />
    <MSBuild Projects="@(CgeVsixBridge)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);Platform=%(CgeVsixBridge.Platform);SelfContained=false;PublishDir=$(CgeBridgeStageDirectory)%(CgeVsixBridge.Filename)\"
             BuildInParallel="false" />
    <ItemGroup>
      <_CgeBridgePayload Include="$(CgeBridgeStageDirectory)**/*" Exclude="$(CgeBridgeStageDirectory)**/*.pdb" />
      <VSIXSourceItem Include="@(_CgeBridgePayload)">
        <VSIXSubPath>Bridges/%(RecursiveDir)</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

   <!--
     WPF's incremental markup compiler can leave the generated .g.cs files in place while dropping
     one or more BAML files (for example after a control is renamed). A normal Visual Studio F5
     build must repair that state automatically; otherwise the deployment target would install an
     assembly whose g.resources is incomplete. Remove only the markup compiler cache and generated
     Page outputs when a BAML is missing so MarkupCompilePass1/2 must regenerate them. Do not remove
     obj/project.assets.json or any user source file content.
   -->
  <Target Name="RepairIncompleteWpfBamlResources"
          BeforeTargets="MarkupCompilePass1"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_ExpectedWpfBamlForRepair Include="@(Page->'$(IntermediateOutputPath)%(Filename).baml')" />
      <_MissingWpfBamlForRepair Include="@(_ExpectedWpfBamlForRepair)" Condition="!Exists('%(Identity)')" />
       <_GeneratedWpfPageOutputForRepair Include="@(Page->'$(IntermediateOutputPath)%(Filename).g.cs')" />
       <_GeneratedWpfPageOutputForRepair Include="@(Page->'$(IntermediateOutputPath)%(Filename).g.i.cs')" />
       <_GeneratedWpfPageOutputForRepair Include="@(_ExpectedWpfBamlForRepair)" />
       <_WpfMarkupCacheForRepair Include="$(IntermediateOutputPath)$(AssemblyName)_MarkupCompile.cache" />
       <_WpfMarkupCacheForRepair Include="$(IntermediateOutputPath)$(AssemblyName)_MarkupCompile.lref" />
    </ItemGroup>
     <Delete Files="@(_GeneratedWpfPageOutputForRepair);@(_WpfMarkupCacheForRepair)"
             Condition="'@(_MissingWpfBamlForRepair)' != ''" />
  </Target>

  <!-- A stale WPF incremental-build cache can produce the generated .g.cs files while omitting
       the corresponding BAML from g.resources. Never allow that incomplete assembly to reach F5
       deployment: validate every Page item after Compile and before the VSIX deployment target.
       Not in design-time builds: Visual Studio's background CompileDesignTime runs MarkupCompilePass1
       without Pass2 and produces no BAML, so checking there reported this error on every F5 (the
       real build that follows regenerates the BAML through RepairIncompleteWpfBamlResources). -->
  <Target Name="ValidateWpfBamlResources"
          AfterTargets="MarkupCompilePass2;Compile"
          BeforeTargets="DeployVsixExtensionFiles"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_ExpectedWpfBaml Include="@(Page->'$(IntermediateOutputPath)%(Filename).baml')" />
      <_MissingWpfBaml Include="@(_ExpectedWpfBaml)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Error Condition="'@(_MissingWpfBaml)' != ''"
           Text="WPF BAML resource generation is incomplete. Missing: @(_MissingWpfBaml). Rebuild the VSIX before launching Visual Studio." />
  </Target>

</Project>
