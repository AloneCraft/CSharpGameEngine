<UserControl x:Class="CSharpGameEngine.VSExtension.InspectorToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:CSharpGameEngine.VSExtension"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             d:DesignHeight="400" d:DesignWidth="300">
    <UserControl.Resources>
        <local:InspectorEditorKindVisibilityConverter x:Key="EditorKindVisibilityConverter" />

        <!-- 既定のButtonクロムはVSテーマの背景色に馴染まず"×"の文字が事実上見えなくなる
             (実機報告)。テーマ非依存で確実に文字が見える自前テンプレートへ差し替える。 -->
        <Style x:Key="InspectorRemoveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="2">
                            <TextBlock Text="×" FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverOverSelectedKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 単純な値を持つ行(InspectorMemberViewModel)。DataTypeだけ付けて明示キーは付けない
             ("暗黙" DataTemplate)ので、ItemTemplateを指定しないItemsControlは実行時型を見て
             自動的にこれを選ぶ。これにより、下の入れ子テンプレートと合わせて自己参照的な
             再帰表示が組める(HierarchicalDataTemplate/TreeViewは使わない — Step2-1の判断
             どおり、独自の選択/フォーカス意味論がTextBoxのcommit経路と衝突するため)。 -->
        <DataTemplate DataType="{x:Type local:InspectorMemberViewModel}">
            <Border BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                    BorderThickness="0,0,0,1" Opacity="0.9" Padding="6,4" Focusable="True" PreviewKeyDown="InspectorRow_PreviewKeyDown">
<Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Opacity="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding MemberName}" VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                               ToolTip="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                    <Grid Grid.Column="1">
                        <TextBox Text="{Binding DisplayText, Mode=OneTime}"
                                 Visibility="{Binding EditorKind, Converter={StaticResource EditorKindVisibilityConverter}, ConverterParameter='Number,Text,PhysicalValue'}"
                                 PreviewKeyDown="InspectorRow_PreviewKeyDown" KeyDown="EditableField_KeyDown" LostFocus="EditableField_LostFocus">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="TextAlignment" Value="Left" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EditorKind}" Value="Number">
                                            <Setter Property="TextAlignment" Value="Right" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <!-- IsChecked/SelectedItemはOneWay。初期のデータバインド代入自体が
                             Checked/SelectionChangedを発火させるため、それらをcommitの
                             トリガーにすると「確定→再構築→再バインド→再確定」の無限
                             ループになる。Click/DropDownClosedはユーザー操作でしか
                             発火しないので、これらだけをcommitの起点にする。 -->
                        <CheckBox VerticalAlignment="Center"
                                  IsChecked="{Binding BooleanValue, Mode=OneWay}"
                                  Visibility="{Binding EditorKind, Converter={StaticResource EditorKindVisibilityConverter}, ConverterParameter=Boolean}"
                                  Click="BooleanField_Click" PreviewKeyDown="InspectorRow_PreviewKeyDown" />
                        <ComboBox ItemsSource="{Binding ChoiceCandidateNames}"
                                  SelectedItem="{Binding SelectedChoiceName, Mode=OneWay}"
                                  Visibility="{Binding EditorKind, Converter={StaticResource EditorKindVisibilityConverter}, ConverterParameter='Enum,AssetReference'}"
                                  DropDownClosed="ChoiceField_DropDownClosed" PreviewKeyDown="InspectorRow_PreviewKeyDown" />
                        <TextBlock Text="{Binding DisplayText, Mode=OneTime}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"
                                   Visibility="{Binding EditorKind, Converter={StaticResource EditorKindVisibilityConverter}, ConverterParameter=ReadOnly}">
                             <TextBlock.Style>
                                 <Style TargetType="TextBlock">
                                     <Setter Property="TextAlignment" Value="Left" />
                                     <Style.Triggers>
                                         <DataTrigger Binding="{Binding EditorKind}" Value="Number">
                                             <Setter Property="TextAlignment" Value="Right" />
                                         </DataTrigger>
                                     </Style.Triggers>
                                 </Style>
                             </TextBlock.Style>
                         </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ネストしたObjectCreation値(例: new Vector3(1,2,3))。Component 1件分と同じ
             「Expander + 内側ItemsControl」構造をもう1段重ねる。内側ItemsControlは
             ItemTemplateを指定しないので、子がさらにネストしていれば自分自身が
             (このDataTemplate自体が)暗黙に選ばれて再帰する。子行は常に読み取り専用として
             構築済み(SceneInspectorNestedRowのドキュメントコメント参照)。 -->
        <DataTemplate DataType="{x:Type local:InspectorNestedRowViewModel}">
            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                      ToolTip="{Binding TypeDisplayName}" Margin="12,0,0,2" Focusable="True" PreviewKeyDown="InspectorRow_PreviewKeyDown">
                <Expander.Header>
                <Border Padding="2,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Header}" FontWeight="Bold"
                                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding TypeDisplayName, StringFormat=' ({0})'}"
                                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                                    </Border>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Rows}" />
            </Expander>
        </DataTemplate>
    </UserControl.Resources>
    <!-- パレットからのドロップはパネル全体で受ける。対象は「選択中のノード」なので、
         パネル内のどこで離しても意味は変わらない。 -->
    <Grid Background="Transparent" AllowDrop="True" DragOver="Panel_DragOver" Drop="Panel_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="EmptyMessage" Grid.Row="0" Margin="8"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"
                   Text="{local:Loc InspectorEmpty}" />

        <ScrollViewer x:Name="MemberScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MemberList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- IsExpandedはTwoWay。ユーザーの開閉はViewModelへ書き戻り、再構築の直前に
                             CaptureExpansionStateが生きたItemsSourceから読み戻す(Hierarchyの
                             CollapsedPathsと同じ方式)。Expanded/Collapsedイベントは購読しない。 -->
                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                  ToolTip="{Binding FullTypeName}" Margin="0,0,0,2" Focusable="True" PreviewKeyDown="InspectorRow_PreviewKeyDown">
                            <Expander.Header>
                                <Border Padding="2,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Header}" FontWeight="Bold"
                                               Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                                               TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="{local:Loc LightConversionApply}" Margin="4,0,0,0"
                                                Visibility="{Binding LightConversionVisibility}" Command="{x:Static local:InspectorToolWindowControl.ConvertLightCommand}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource InspectorRemoveButtonStyle}"
                                                Margin="4,0,0,0"
                                                ToolTip="{local:Loc InspectorRemoveComponentToolTip}"
                                                Click="RemoveComponentButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                                        </Border>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="{local:Loc InspectorAnalysisPending}" Margin="6,4" FontStyle="Italic"
                                           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"
                                           Visibility="{Binding PendingMessageVisibility}" />
                                <!-- ItemTemplateを指定しない: 各行(InspectorMemberViewModel/
                                     InspectorNestedRowViewModel)の実行時型で上の暗黙DataTemplateが
                                     自動的に選ばれる。 -->
                                <ItemsControl ItemsSource="{Binding Rows}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
