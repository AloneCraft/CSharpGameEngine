<UserControl x:Class="CSharpGameEngine.VSExtension.SceneEditorOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CSharpGameEngine.VSExtension"
             d:DesignHeight="220" d:DesignWidth="460">
    <!-- Tools>Options のページなので Background/Foreground は敷かない。VsBrushes.WindowTextKey を
         UserControl に指定すると、このダイアログでは TextBlock だけが淡いグレーで描かれ
         (CheckBox は自前の Foreground を持つため濃いまま)見出しとラベルが読みにくくなる。
         ホストのダイアログ既定色を継承させるのが正しい。 -->
    <StackPanel Margin="0,0,0,8">
        <TextBlock Text="{local:Loc OptionsNavigationHeader}" FontWeight="Bold" Margin="0,0,0,8" />

        <CheckBox x:Name="InvertLookXCheckBox" Margin="0,0,0,6"
                  Content="{local:Loc OptionsInvertLookX}"
                  Checked="OnUserEditedValue" Unchecked="OnUserEditedValue" />
        <CheckBox x:Name="InvertLookYCheckBox" Margin="0,0,0,12"
                  Content="{local:Loc OptionsInvertLookY}"
                  Checked="OnUserEditedValue" Unchecked="OnUserEditedValue" />

        <CheckBox x:Name="InvertOrbitXCheckBox" Margin="0,0,0,6"
                  Content="{local:Loc OptionsInvertOrbitX}"
                  Checked="OnUserEditedValue" Unchecked="OnUserEditedValue" />
        <CheckBox x:Name="InvertOrbitYCheckBox" Margin="0,0,0,12"
                  Content="{local:Loc OptionsInvertOrbitY}"
                  Checked="OnUserEditedValue" Unchecked="OnUserEditedValue" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="{local:Loc OptionsNavigationSpeedMultiplier}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="NavigationSpeedMultiplierTextBox" Width="80" VerticalAlignment="Center"
                     TextChanged="OnUserEditedValue" />
        </StackPanel>
        <TextBlock x:Name="NavigationSpeedRangeHint" Margin="0,0,0,12" Opacity="0.75" />

        <Button x:Name="ResetToDefaultsButton" Content="{local:Loc OptionsResetDefaults}"
                HorizontalAlignment="Left" Padding="12,2" Click="ResetToDefaultsButton_Click" />
    </StackPanel>
</UserControl>
