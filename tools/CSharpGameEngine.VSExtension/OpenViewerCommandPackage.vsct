    </CommandPlacement>

    <!-- M0020: ソリューションエクスプローラーの単一項目右クリックにも同じ34個のボタン
         (SceneDesignerContextMenuGroup配下、Direct/32スロット/Overflow)をそのまま出す。新しい
         ID/ボタンは追加しない。コードウィンドウの右クリックとSEの項目右クリックは同時に出ないため、
         以前修正した「シーン デザイナーで開くが2つ並ぶ」問題は再発しない。フォルダや.cs以外の項目は
         OpenSceneDesignerCommand側の既存の.cs限定ゲートで非表示になる。 -->
    <CommandPlacement guid="guidOpenViewerCommandPackageCmdSet" id="SceneDesignerContextMenuGroup" priority="0x0600">
      <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ITEMNODE" />
    </CommandPlacement>
  </CommandPlacements>

  <Symbols>
    <GuidSymbol name="guidCSharpGameEngineViewerPackage" value="{aec17804-e2e4-46e7-b373-de11af816203}" />

    <GuidSymbol name="guidOpenViewerCommandPackageCmdSet" value="{521655e5-0d1b-4255-8086-1039c5c2e3da}">
      <IDSymbol name="OpenViewerMenuGroup" value="0x1020" />
      <IDSymbol name="OpenViewerCommandId" value="0x0100" />
      <!-- 0x0101 (ShowViewerToolWindowCommandId) retired in ADR-0021 - do not reuse; the docked
           single-mesh Viewer tool window it showed was removed (scene rendering now happens in the
           "シーン" document tab, ADR-0020). -->
      <IDSymbol name="ToggleFabWatchCommandId" value="0x0102" />
      <IDSymbol name="OpenFabCommandId" value="0x0103" />
      <IDSymbol name="OpenGameCommandId" value="0x0104" />
      <IDSymbol name="ShowHierarchyToolWindowCommandId" value="0x0105" />
      <IDSymbol name="ApplyGameEngineLayoutCommandId" value="0x0106" />
      <!-- 0x0107/0x0108は退役済みで再利用しない(下記コメント参照)。0x0109はOpenSceneDesignerCommandIdが
           既に使っているため、Inspectorには次の空きである0x010Aを割り当てる。 -->
      <IDSymbol name="ShowInspectorToolWindowCommandId" value="0x010A" />
      <!-- 0x0107 (ShowShapePaletteToolWindowCommandId) は M0020 Phase 0 で退役した。シェイプ
           パレットの配置先は .scene ファイルであり、ADR-0040 Phase 9 で読み取り経路がライブ Roslyn の
           SceneModel へ移った時点で書き込み先が消え、押しても案内ダイアログを出すだけの UI に
           なっていた。プリミティブ生成そのものは tools/CSharpGameEngine.Primitive.Cli として存続し、
           Scene デザイナーの PrimitiveMesh 描画が利用している。0x0101/0x0108 と同様、この ID は
           再利用しないこと (既にインストール済みの VS がキーバインドやカスタマイズを保持している)。 -->
      <!-- 0x0108 (PreviewSceneDefinitionCommandId) retired in ADR-0040 - do not reuse; the
           execution-based preview it triggered (build the target project, run CreateRuntime out of
           process, read WorldSnapshot reflectively) was replaced by rendering the SceneModel
           directly, which needs no command of its own. -->
      <IDSymbol name="CSharpGameEngineToolbar" value="0x1021" />
      <IDSymbol name="CSharpGameEngineToolbarGroup" value="0x1022" />
      <!-- 0x1023 (SceneDefinitionContextMenuGroup) retired together with 0x0108. Group 宣言と
           IDSymbol は「退役」と書きながら両方生きたまま残っていた (親付けされた Button はゼロで
           挙動には影響していなかった) ため、2026-08 に宣言そのものを削除した。他の退役 ID と同様
           再利用しないこと。 -->
      <!-- ADR-0040 Phase 9. -->
      <IDSymbol name="OpenSceneDesignerCommandId" value="0x0109" />
      <IDSymbol name="SceneDesignerContextMenuGroup" value="0x1024" />
      <IDSymbol name="OpenSceneDesignerSceneItem00" value="0x0110" />
