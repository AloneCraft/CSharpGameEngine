<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Include href="KnownImageIds.vsct" />

  <Commands package="guidCSharpGameEngineViewerPackage">
    <Menus>
      <Menu guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbar" priority="0x0000" type="Toolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>C# Game Engine</ButtonText>
          <CommandName>C# Game Engine</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <Group guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbarGroup" priority="0x0000">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="CSharpGameEngineToolbar" />
      </Group>
      <!-- ADR-0040 Phase 9: code-editor context menu only - deliberately not also placed on the
           Tools menu / toolbar like every other command here, since it only makes sense for the file
           currently being edited. Does not reuse the retired ADR-0031 group (see the Symbols
           section). -->
      <Group guid="guidOpenViewerCommandPackageCmdSet" id="SceneDesignerContextMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerCommandId" priority="0x0100" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="OpenFolder" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>C# Game Engine Viewer を開く</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="ToggleFabWatchCommandId" priority="0x0102" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="FolderOpened" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Fabダウンロード監視を開始</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="OpenFabCommandId" priority="0x0103" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="ViewInBrowser" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Fab を開く</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="OpenGameCommandId" priority="0x0104" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Play" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>ゲームを開く</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="ShowHierarchyToolWindowCommandId" priority="0x0105" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="ToolWindow" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>ヒエラルキー パネルを表示</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="ApplyGameEngineLayoutCommandId" priority="0x0106" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="LayoutPanel" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>GameEngine レイアウトを適用</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="ShowInspectorToolWindowCommandId" priority="0x0107" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="OpenViewerMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="ToolWindow" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>インスペクター パネルを表示</ButtonText>
        </Strings>
      </Button>
      <!-- 0x0108 (PreviewSceneDefinitionCommandId) は ADR-0040 で退役した。VSIX の Scene 表示は
           対象プロジェクトをビルドして別プロセスで CreateRuntime を実行する方式をやめ、SceneModel を
           直接描画する方式へ移行したため、このコマンド自体が不要になった。0x0101 と同様、この ID は
           再利用しないこと (既にインストール済みの VS がキーバインドやカスタマイズを保持している)。 -->
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="OpenSceneDesignerCommandId" priority="0x0100" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="SceneDesignerContextMenuGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>シーン デザイナーで開く</ButtonText>
        </Strings>
      </Button>
      <!-- 同じファイルに複数の Scene がある場合の一覧 (0x0110〜0x012F の32スロット + 溢れ表示
           0x0130)。以前は「シーン デザイナーで開く」という入れ子のサブメニュー (0x010A) の中に
           置いていたが、サブメニュー本体の可視性を制御する手段がなく、Scene が1件だけのときも空の
           サブメニューがグレー表示で常に居座って「シーン デザイナーで開く」が2つ並んでいた。
           コンテキストメニュー直下へ平らに置くことで重複が構造的に起こり得なくなる。
           priority は直接コマンド (0x0100) の後ろ。ButtonText は TextChanges で実行時に
           差し替えるプレースホルダー。

           なぜ DynamicItemStart をやめてスロットを固定 ID で並べているか:
           DynamicItemStart は可変長で上限が無い代わりに、root ID (先頭項目) だけは
           OleMenuCommandService.FindCommand が辞書の完全一致で解決して DynamicItemMatch を
           通さない。そのため共有される MatchedCommandId が更新されず、「1番目を押したのに2番目の
           シーンが開く」誘導ミスが起きていた (実機で確認済み)。root を実項目から外して常に非表示の
           アンカーにする案も試したが、root を非表示にすると VS はそこで列挙を打ち切り項目が1つも
           出なくなった (これも実機で確認済み) ため成立しなかった。スロットごとに固有の ID を持たせれば
           クリックされた ID がそのままハンドラを特定するので、共有可変状態が無くなり誘導ミスが
           原理的に起こり得ない。

           代償は表示件数の上限 (32件) である。これはサブメニューに分けても回避できない —
           リーフ1項目につき ID が1つ必要で、入れ子は見た目のグルーピングにすぎないため。
           33件目以降が存在する場合は 0x0130 が「他 N 件は…」と表示され、黙って消えることはない
           (シーン デザイナーのコンボボックスはプロジェクト内の全シーンを列挙する完全な経路)。 -->
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="OpenSceneDesignerSceneItem00" priority="0x0200" type="Button">
        <Parent guid="guidOpenViewerCommandPackageCmdSet" id="SceneDesignerContextMenuGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <CommandFlag>TogglePatternAvailable</CommandFlag>
        <Strings>
          <ButtonText>Scene</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOpenViewerCommandPackageCmdSet" id="OpenSceneDesignerSceneItem01" priority="0x0201" type="Button">
