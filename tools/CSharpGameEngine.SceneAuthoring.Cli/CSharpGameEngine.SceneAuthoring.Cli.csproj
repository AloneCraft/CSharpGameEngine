<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real (non-analyzer) reference: this bridge runs entirely in-process on the net10.0 side, so
         it can call CSharpGameEngine.Entities directly - unlike the net472 VSIX, which cannot
         (ADR-0031). InternalsVisibleTo on CSharpGameEngine.Entities.csproj grants WorldInspector.cs
         access to the internal Archetype-walking surface. -->
    <ProjectReference Include="..\..\src\CSharpGameEngine.Entities\CSharpGameEngine.Entities.csproj" />
    <!-- ADR-0023: resident-server mode (a serve-plus-pipe-name launch argument), shared with the
         other 3 bridges. -->
    <ProjectReference Include="..\CSharpGameEngine.Bridge.Hosting\CSharpGameEngine.Bridge.Hosting.csproj" />
    <!-- Syntax-only parse of the source .cs file to recover node names, which CreateRuntime's real
         Entity/World output does not carry (ADR-0031) - version-pinned to match
         CSharpGameEngine.CodeAnalysis.csproj's own reference exactly, avoiding two uncoordinated
         Roslyn versions in the same repo. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSharpGameEngine.SceneAuthoring.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
