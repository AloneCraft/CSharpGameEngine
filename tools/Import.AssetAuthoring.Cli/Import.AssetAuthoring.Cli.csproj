<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Import\Import.csproj" />
    <ProjectReference Include="..\..\src\Content\Content.csproj" />
    <ProjectReference Include="..\..\src\Audio\Audio.csproj" />
    <ProjectReference Include="..\..\src\Rendering\Rendering.csproj" />
    <ProjectReference Include="..\Bridge.Hosting\Bridge.Hosting.csproj" />
    <ProjectReference Include="../ContentCompiler/ContentCompiler.csproj" />
    <ProjectReference Include="../Cook.Cli/Cook.Cli.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="Platform;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSharpGameEngine.Bridge.Hosting.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Content Include="$(NuGetPackageRoot)assimpnet\4.1.0\runtimes\win-x64\native\assimp.dll" Link="assimp.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CgeCopyModelProductionWorker" AfterTargets="Build">
    <MSBuild Projects="../Cook.Cli/Cook.Cli.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="Platform;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_CgeModelProductionWorker" />
    </MSBuild>
    <PropertyGroup><_CgeModelProductionWorkerDirectory>@(_CgeModelProductionWorker->'%(RootDir)%(Directory)')</_CgeModelProductionWorkerDirectory></PropertyGroup>
    <ItemGroup><_CgeModelProductionWorkerFile Include="$(_CgeModelProductionWorkerDirectory)*" Exclude="$(_CgeModelProductionWorkerDirectory)*.pdb" /></ItemGroup>
    <Copy SourceFiles="@(_CgeModelProductionWorkerFile)" DestinationFolder="$(TargetDir)Cook/" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CgePublishModelProductionWorker" AfterTargets="Publish" DependsOnTargets="CgeCopyModelProductionWorker">
    <Error Condition="!Exists('$(TargetDir)Cook/Cook.Cli.dll')" Text="Model production worker is missing from the authoring bridge build." />
    <ItemGroup><_CgePublishedModelWorker Include="$(TargetDir)Cook/**/*" /></ItemGroup>
    <Copy SourceFiles="@(_CgePublishedModelWorker)" DestinationFiles="@(_CgePublishedModelWorker->'$(PublishDir)Cook/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
