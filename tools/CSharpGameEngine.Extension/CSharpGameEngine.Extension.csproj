<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\CSharpGameEngine.Import\CSharpGameEngine.Import.csproj" />
    <!-- ADR-0034: replaces the former Graphics.D3D12 + Platform.Windows + Compiler.Hlsl trio. -->
    <ProjectReference Include="..\..\src\CSharpGameEngine.Windows\CSharpGameEngine.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\Shaders\Model.hlsl" Link="Shaders\Model.hlsl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\TestFixtures\Gltf\Box.glb" Link="Samples\Box.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\TestFixtures\Gltf\BoxTextured.glb" Link="Samples\BoxTextured.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\TestFixtures\Fbx\Box.fbx" Link="Samples\Box.fbx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <!-- AssimpNet's native assimp.dll (ADR-0009) ships under runtimes/win-x64/native/ - NuGet
         only resolves/copies RID-specific native assets when a RuntimeIdentifier is set; without
         this, `dotnet build` produces a framework-dependent, RID-agnostic output missing
         assimp.dll entirely (confirmed empirically). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

</Project>
