<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CSharpGameEngine.ContentCompiler/CSharpGameEngine.ContentCompiler.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same project generator the Visual Studio template wizard uses (ADR-0068). -->
    <Compile Include="../CSharpGameEngine.ProjectTemplates/GameProjectGenerator.cs" Link="ProjectTemplates/GameProjectGenerator.cs" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSharpGameEngine.FeatureRunner.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="VerifyRepositoryFeatureContracts" AfterTargets="Build" Condition="'$(DesignTimeBuild)'!='true' And '$(IsCrossTargetingBuild)'!='true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; verify-coverage --repository-root &quot;$(MSBuildProjectDirectory)\..\..&quot;" />
    <Exec Command="dotnet &quot;$(TargetPath)&quot; verify-manual-ledger --repository-root &quot;$(MSBuildProjectDirectory)\..\..&quot;" />
    <Exec Command="dotnet &quot;$(TargetPath)&quot; verify-goldens --repository-root &quot;$(MSBuildProjectDirectory)/../..&quot;" />
    <Exec Command="dotnet &quot;$(TargetPath)&quot; verify-ci-matrix --repository-root &quot;$(MSBuildProjectDirectory)/../..&quot;" />
    <Exec Command="dotnet &quot;$(TargetPath)&quot; verify-vsix-compatibility --repository-root &quot;$(MSBuildProjectDirectory)/../..&quot; --configuration $(Configuration)" />
    <Exec Command="dotnet &quot;$(TargetPath)&quot; verify-failure-policy --repository-root &quot;$(MSBuildProjectDirectory)/../..&quot;" />
  </Target>
</Project>
