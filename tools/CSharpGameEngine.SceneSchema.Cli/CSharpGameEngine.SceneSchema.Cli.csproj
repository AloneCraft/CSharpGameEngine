<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ADR-0070: writes the scene JSON Schema that GameSystemGenerator embeds in a game assembly
    (CgeGeneratedSceneSchema.Json) to .cge/scene.schema.json. It reads the constant from metadata
    only and never loads or runs the game assembly.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo"><_Parameter1>CSharpGameEngine.CodeAnalysis.Tests</_Parameter1></AssemblyAttribute>
  </ItemGroup>
</Project>
