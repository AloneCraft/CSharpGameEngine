<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Configuration">
    <HasSharedItems>true</HasSharedItems>
    <Import_RootNamespace>CSharpGameEngine.Vehicles</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)VehicleComponents.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)VehicleMotor.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)VehicleSystems.cs" />
    <Using Include="CSharpGameEngine.Vehicles" />
  </ItemGroup>
</Project>
