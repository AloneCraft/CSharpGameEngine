<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- AnyCPU is listed alongside x64 so VS's Configuration Manager can map a plain "Any CPU"
         solution platform without leaving this project's "Build" checkbox unchecked. Retained
         defensively after ADR-0034 deleted the second solution file (UserGameProject.slnx) that
         originally motivated it: CSharpGameEngine.slnx declares x64 explicitly, so only x64 is
         exercised today, but AnyCPU costs nothing and keeps the project openable standalone.
         Safe because RuntimeIdentifier=win-x64 above already pins the actual native bitness
         (TerraFX/D3D12) regardless of which Platform label is active - unlike
         tools/CSharpGameEngine.TestHost, which has no RuntimeIdentifier and genuinely needs
         Platforms=x64 alone to force PlatformTarget=x64. -->
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Roslyn generator output (GameSystemGenerator's Executor/GeneratedGameLoop) normally stays
         in-memory only, so it can't be opened as a file or hold a persistent breakpoint. Writing it
         to disk lets Visual Studio set real breakpoints in the generated code for step-through
         debugging. <Compile Remove> below stops the SDK's default globbing from also picking these
         files up as a second, duplicate compile input (they're already part of the compilation via
         the analyzer itself). -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Generated\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Represents the simulated end-user game project's asset tree in Solution Explorer. .meta
         sidecar files (ADR-0012, one per 3D asset, holding a stable GUID - Unity/UE-style) are
         real project items but marked Visible="false", so only the representative asset file
         (e.g. Box.glb) shows, not its supporting .meta. A plain Exclude was tried first but found
         (empirically, via a real Solution Explorer screenshot) not to be enough on its own -
         modern VS's Solution Explorer still lists files physically present under an included
         folder even when excluded from the item list; Visible="false" on an actual item is what
         actually hides it. -->
    <None Include="Assets\**\*" Exclude="Assets\**\*.meta;Assets\Stage\**\*" />
    <None Include="Assets\**\*.meta" Visible="false" />
    <!-- Unlike the Fab/user-asset tree above (Solution Explorer-only), the UE level port's
         converted GLB + scene_meta.json (ADR-0017) are real runtime inputs SceneLoader reads via
         AppContext.BaseDirectory, so they must actually be copied to the output directory. -->
    <None Include="Assets\Stage\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Docs/EditorSpec.md §3 / ADR-0021: *.scene (single extension - VS's ProvideEditorExtension
         cannot match a compound ".scene.json" extension, ADR-0020's original choice never actually
         worked) is authored Source (ADR-0002), not a generated artifact, hence a plain <None> item
         (visible, Git-tracked) rather than a CopyToOutputDirectory asset - only the VSIX's
         Hierarchy/Scene tool windows read it today. -->
    <None Include="DefaultScene.scene" />
  </ItemGroup>

  <ItemGroup>
    <!-- Systems are `internal struct ... : ISystem` (ADR-0033), so the test project needs access. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>UserGameProject.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- CSharpGameEngine.Entities is consumed as SHARED SOURCE, not as a compiled binary:
         Runtime.cs's World/State are partial types that GameSystemGenerator completes in this
         project's own compilation, and partial types cannot span an assembly boundary (ADR-0033). -->
    <Compile Include="..\src\CSharpGameEngine.Entities\*.cs" Link="Entities\%(Filename)%(Extension)" />
    <ProjectReference Include="..\src\CSharpGameEngine.CodeAnalysis\CSharpGameEngine.CodeAnalysis.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- ADR-0034: replaces the former Platform.Windows + Graphics.D3D12 pair. -->
    <ProjectReference Include="..\src\CSharpGameEngine.Windows\CSharpGameEngine.Windows.csproj" />
    <ProjectReference Include="..\src\CSharpGameEngine.Import\CSharpGameEngine.Import.csproj" />
    <ProjectReference Include="..\src\CSharpGameEngine.Core\CSharpGameEngine.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\assets\Shaders\Stage.hlsl" Link="Shaders\Stage.hlsl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
