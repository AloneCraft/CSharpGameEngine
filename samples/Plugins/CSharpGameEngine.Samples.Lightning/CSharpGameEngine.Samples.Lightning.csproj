<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Sample package plugin (ADR-0079). The NuGet package carries the three parts of a distributed plugin:
    - lib/: the Library module, this project's DLL ([assembly: PluginLibrary]; it never names World, State, Entity or ISystem);
    - plugin/: the manifest, the MSBuild glue and the Runtime module's sources, compiled into the game with its own systems;
    - build/<id>.targets: imports plugin/Lightning.plugin.props after the game's project file, so a PackageReference enables it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>CSharpGameEngine.Samples.Lightning</PackageId>
    <Version>1.0.0</Version>
    <Authors>CSharpGameEngine</Authors>
    <Description>Sample C# Game Engine plugin: lightning bolts.</Description>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\..\.artifacts\packages\samples\</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Runtime module is source for the game, not part of this DLL. -->
    <Compile Remove="plugin\**" />
    <None Remove="plugin\**;build\**" />
    <None Include="plugin\**\*" Pack="true" PackagePath="plugin\" />
    <None Include="build\**\*" Pack="true" PackagePath="build\" />
  </ItemGroup>
  <ItemGroup>
    <!-- For [assembly: PluginLibrary]; the game gets CSharpGameEngine.Core from the engine SDK, so it is not a package dependency. -->
    <ProjectReference Include="..\..\..\src\CSharpGameEngine.Core\CSharpGameEngine.Core.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
