<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Writes GameSystemGenerator's output (Executor classes, GeneratedGameLoop) to disk as real
         files instead of staying in-memory only, so the user-defined half (Components.cs,
         MovementSystems.cs, HealthSystems.cs) and the SG-generated half can be read/compared side
         by side - this sample exists specifically to show both halves. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Dots101\**" />
    <Compile Remove="Generated\**\*.cs" />
    <EmbeddedResource Remove="Dots101\**" />
    <None Remove="Dots101\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ECS見本.cs" />
    <Compile Remove="ECS見本.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CSharpGameEngine.Entities\CSharpGameEngine.Entities.csproj" />
    <ProjectReference Include="..\..\src\CSharpGameEngine.CodeAnalysis\CSharpGameEngine.CodeAnalysis.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
