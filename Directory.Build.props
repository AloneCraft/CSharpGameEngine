<Project>
  <PropertyGroup>
    <CustomBeforeMicrosoftCommonTargets Condition="'$(CustomBeforeMicrosoftCommonTargets)' == ''">$(MSBuildThisFileDirectory)build\CSharpGameEngine.NumericProfile.BeforeCommon.targets</CustomBeforeMicrosoftCommonTargets>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<Deterministic>true</Deterministic>
	<DebugSymbols>true</DebugSymbols>
	<DebugType>portable</DebugType>
	<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	<LangVersion>14</LangVersion>
  </PropertyGroup>
  <!-- Classify projects by folder, not by name: projects under tests/ are tests, and the other engine
       folders build engine assemblies. The analyzers read CgeEngineAssembly (ADR-0099). -->
  <PropertyGroup>
    <_CgeRepositoryRelativeDirectory>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)','$(MSBuildProjectDirectory)').Replace('\','/'))/</_CgeRepositoryRelativeDirectory>
    <CgeTestProject Condition="'$(CgeTestProject)' == '' and $(_CgeRepositoryRelativeDirectory.StartsWith('tests/'))">true</CgeTestProject>
    <CgeEngineAssembly Condition="'$(CgeEngineAssembly)' == '' and '$(CgeTestProject)' != 'true' and ($(_CgeRepositoryRelativeDirectory.StartsWith('src/')) or $(_CgeRepositoryRelativeDirectory.StartsWith('tools/')) or $(_CgeRepositoryRelativeDirectory.StartsWith('plugins/')) or $(_CgeRepositoryRelativeDirectory.StartsWith('stages/')))">true</CgeEngineAssembly>
    <!-- Project and DLL names carry no CSharpGameEngine. prefix, but the namespaces keep it (ADR-0099).
         The default namespace also names embedded resources, so it stays CSharpGameEngine.<project>. -->
    <RootNamespace Condition="'$(RootNamespace)' == '' and '$(CgeEngineAssembly)' == 'true' and !$(MSBuildProjectName.StartsWith('CSharpGameEngine.'))">CSharpGameEngine.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>
</Project>
