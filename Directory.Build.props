<Project>
  <PropertyGroup>
    <CustomBeforeMicrosoftCommonTargets Condition="'$(CustomBeforeMicrosoftCommonTargets)' == ''">$(MSBuildThisFileDirectory)build\CSharpGameEngine.NumericProfile.BeforeCommon.targets</CustomBeforeMicrosoftCommonTargets>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<Deterministic>true</Deterministic>
	<DebugSymbols>true</DebugSymbols>
	<DebugType>portable</DebugType>
	<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	<LangVersion>14</LangVersion>
  </PropertyGroup>
</Project>
