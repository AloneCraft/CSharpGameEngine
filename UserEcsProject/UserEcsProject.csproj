<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <Import Project="..\src\CSharpGameEngine.Runtime.Simulation\CSharpGameEngine.Runtime.Simulation.projitems" Label="Shared" />
  <Import Project="..\src\CSharpGameEngine.Runtime.Physics\CSharpGameEngine.Runtime.Physics.projitems" Label="Shared" />
  <Import Project="..\src\CSharpGameEngine.Runtime.Windows\CSharpGameEngine.Runtime.Windows.projitems" Label="Shared" />

  <ItemGroup>
    <Compile Remove="Generated\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\src\CSharpGameEngine.Entities\*.cs" Link="Entities\%(Filename)%(Extension)" />
    <ProjectReference Include="..\src\CSharpGameEngine.CodeAnalysis\CSharpGameEngine.CodeAnalysis.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\src\CSharpGameEngine.Windows\CSharpGameEngine.Windows.csproj" />
    <ProjectReference Include="..\src\CSharpGameEngine.Import\CSharpGameEngine.Import.csproj" />
    <ProjectReference Include="..\src\CSharpGameEngine.Core\CSharpGameEngine.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <CgeShaderGraph Include="..\assets\Shaders\Stage.cgeshadergraph" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="../src/CSharpGameEngine.Entities/SceneComponentIconAttribute.cs" />
    <Compile Remove="../src/CSharpGameEngine.Entities/SceneComponentOrderAttribute.cs" />
  </ItemGroup>
</Project>
