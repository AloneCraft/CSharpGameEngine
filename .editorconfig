root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_qualification_for_field = true:suggestion
csharp_style_qualification_for_property = true:suggestion
csharp_style_qualification_for_method = true:suggestion
csharp_style_qualification_for_event = true:suggestion
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_members_in_anonymous_types = false
csharp_space_around_binary_operators = before_and_after
dotnet_style_allow_multiple_blank_lines_experimental = false:warning

dotnet_naming_rule.parameters_should_be_pascal_case.symbols = method_parameters
dotnet_naming_rule.parameters_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.parameters_should_be_pascal_case.severity = warning

dotnet_naming_symbols.method_parameters.applicable_kinds = parameter
dotnet_naming_symbols.method_parameters.applicable_accessibilities = *

dotnet_naming_rule.fields_should_be_pascal_case.symbols = all_fields
dotnet_naming_rule.fields_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.fields_should_be_pascal_case.severity = warning

dotnet_naming_symbols.all_fields.applicable_kinds = field
dotnet_naming_symbols.all_fields.applicable_accessibilities = *

dotnet_naming_rule.locals_should_be_pascal_case.symbols = locals
dotnet_naming_rule.locals_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.locals_should_be_pascal_case.severity = warning

dotnet_naming_symbols.locals.applicable_kinds = local
dotnet_naming_symbols.locals.applicable_accessibilities = *

dotnet_naming_style.pascal_case_style.capitalization = pascal_case
