<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- No pure-C# FBX library with mesh-level access exists (verified this session):
         FbxParser (NuGet, zero deps) only exposes FBX's raw json/xml-like node tree, requiring
         hand-written interpretation of Geometry/Vertices/PolygonVertexIndex nodes for every
         exporter/version variation. FbxSharp cannot read binary FBX files (ASCII-only) and is
         only tested against the 2013.3 format version - both unusable for real Fab-sourced FBX
         assets. AssimpNet wraps the mature native Assimp library and handles FBX (binary/ASCII,
         modern versions) reliably. This is a deliberate departure from ADR-0004 §1's "avoid
         native deps" glTF decision - that decision relied on SharpGLTF.Core existing as a pure
         C# option; no equivalent exists for FBX. See ADR-0009. -->
    <PackageReference Include="AssimpNet" Version="4.1.0" />
  </ItemGroup>

</Project>
