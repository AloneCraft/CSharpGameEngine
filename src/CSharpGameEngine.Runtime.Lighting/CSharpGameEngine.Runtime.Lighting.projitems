<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Configuration">
    <HasSharedItems>true</HasSharedItems>
    <Import_RootNamespace>CSharpGameEngine.Runtime.Lighting</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)Assets\Editor\ComponentIcons\DirectionalLight.svg" />
    <None Include="$(MSBuildThisFileDirectory)Assets\Editor\ComponentIcons\PointLight.svg" />
    <None Include="$(MSBuildThisFileDirectory)Assets\Editor\ComponentIcons\SpotLight.svg" />
    <None Include="$(MSBuildThisFileDirectory)Assets\Editor\ComponentIcons\RectAreaLight.svg" />
    <None Include="$(MSBuildThisFileDirectory)Assets\Editor\ComponentIcons\LightShadow.svg" />
    <None Include="$(MSBuildThisFileDirectory)Assets\Editor\ComponentIcons\SkyAtmosphere.svg" />
    <None Include="$(MSBuildThisFileDirectory)Assets\Editor\ComponentIcons\SkyLight.svg" />
    <None Include="$(MSBuildThisFileDirectory)Assets\Editor\ComponentIcons\PostProcessVolume.svg" />
    <None Include="$(MSBuildThisFileDirectory)Assets\Editor\ComponentIcons\ExponentialHeightFog.svg" />
    <None Include="$(MSBuildThisFileDirectory)Assets\Editor\ComponentIcons\GlobalIlluminationVolume.svg" />
    <None Include="$(MSBuildThisFileDirectory)Assets\Editor\ComponentIcons\VolumetricCloud.svg" />
    <None Include="$(MSBuildThisFileDirectory)Assets\Editor\ComponentIcons\SkySphere.svg" />
    <None Include="$(MSBuildThisFileDirectory)Assets\Editor\ComponentIcons\GlobalDistanceField.svg" />
    <Compile Include="$(MSBuildThisFileDirectory)LightComponents.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)EnvironmentComponents.cs" />
    <Using Include="CSharpGameEngine.Runtime.Lighting" />
    <Using Include="CSharpGameEngine.Lighting" />
  </ItemGroup>
</Project>
