<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- Runtime.cs's World/State are partial types that GameSystemGenerator completes in the SAME
         compilation, and partial types cannot span a compiled DLL and a downstream consumer's own
         compilation (ADR-0033). So this project is NOT referenced as a binary by anyone: it is the
         canonical SOURCE location that every consumer pulls in via
         <Compile Include="..\src\CSharpGameEngine.Entities\*.cs" Link="..." />.
         Building it standalone is a smoke test: with zero ISystem structs in this compilation, the
         generator still emits an empty `Archetype` enum plus an empty `partial struct World`, so
         Runtime.cs's forward references resolve. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Generated\**\*.cs" />
    <Compile Remove="FixedTransform.cs" />
    <Compile Remove="SpatialPartitioning.cs" />
    <Compile Remove="SpatialWorld.cs" />
    <Compile Remove="SpatialDebug.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharpGameEngine.Contracts\CSharpGameEngine.Contracts.csproj" />
    <ProjectReference Include="..\CSharpGameEngine.Numerics\CSharpGameEngine.Numerics.csproj" />
  </ItemGroup>

</Project>
