  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>CSharpGameEngine.Runtime</Import_RootNamespace>
  </PropertyGroup>
  <!-- ゲームにソースのまま取り込む実行時の部品。ファイルは部品ごとのフォルダーに置き、名前空間は CSharpGameEngine.Runtime.<部品> のまま。 -->
  <!-- Simulation は、確かめ用の場面(stages)、Entities の試験、速さの計測からも単独で使う。 -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Simulation\SimulationMessages.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Simulation\SimulationCache.cs" />
  </ItemGroup>
