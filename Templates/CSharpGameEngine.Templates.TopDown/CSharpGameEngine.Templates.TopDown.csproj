<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UE5.8 TopDownテンプレートの移植。リポジトリ内ではSourceModeでビルド・検証する。名前空間CgeTopDownはテンプレート作成時にWizardが置換する。
  -->
  <Import Project="..\..\build\CSharpGameEngine.Game.props" />

  <PropertyGroup>
    <RootNamespace>CgeTopDown</RootNamespace>
    <AssemblyName>CgeTopDown</AssemblyName>
    <!-- The engine plugins this game uses (ADR-0079). Navigation bakes the level's navigation mesh at build time (M0106). -->
    <CgePlugins>Navigation</CgePlugins>
  </PropertyGroup>
</Project>
