<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UE5.8 Vehicleテンプレートの移植。リポジトリ内ではSourceModeでビルド・検証する。名前空間CgeVehicleはテンプレート作成時にWizardが置換する。
  -->
  <Import Project="..\..\build\CSharpGameEngine.Game.props" />

  <PropertyGroup>
    <RootNamespace>CgeVehicle</RootNamespace>
    <AssemblyName>CgeVehicle</AssemblyName>
    <!-- The engine plugins this game uses (ADR-0079). -->
    <CgePlugins>Vehicles</CgePlugins>
  </PropertyGroup>
</Project>
