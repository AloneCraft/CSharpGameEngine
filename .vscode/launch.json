            "program": "${workspaceFolder}/UserEcsProject/bin/Debug/net10.0-windows10.0.19041.0/win-x64/UserEcsProject.exe",
            "args": [],
            "cwd": "${workspaceFolder}/UserEcsProject",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "TestHost: self-test",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/tools/TestHost/bin/x64/Debug/net10.0-windows10.0.19041.0/TestHost.exe",
            "args": [
                "self-test"
            ],
            "cwd": "${workspaceFolder}/tools/TestHost",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "TestHost: triangle",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/tools/TestHost/bin/x64/Debug/net10.0-windows10.0.19041.0/TestHost.exe",
            "args": [
                "triangle"
            ],
            "cwd": "${workspaceFolder}/tools/TestHost",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Extension: Viewer (Box.glb sample)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/tools/Extension/bin/x64/Debug/net10.0-windows10.0.19041.0/win-x64/Extension.exe",
