                               "cwd":  "${workspaceFolder}/tools/Extension",
                               "console":  "internalConsole",
                               "stopAtEntry":  false
                           },
                           {
                               "name":  "Import.Gltf.Cli",
                               "type":  "coreclr",
                               "request":  "launch",
                               "preLaunchTask":  "build",
                               "program":  "${workspaceFolder}/tools/Import.Gltf.Cli/bin/Debug/net10.0/Import.Gltf.Cli.exe",
                               "args":  [
                                            "${input:gltfInputPath}",
                                            "${input:gltfOutputPath}"
                                        ],
                               "cwd":  "${workspaceFolder}",
                               "console":  "internalConsole",
                               "stopAtEntry":  false
                           },
                           {
                               "name":  "Import.Fbx.Cli",
                               "type":  "coreclr",
                               "request":  "launch",
                               "preLaunchTask":  "build",
                               "program":  "${workspaceFolder}/tools/Import.Fbx.Cli/bin/Debug/net10.0/win-x64/Import.Fbx.Cli.exe",
                               "args":  [
                                            "${input:fbxInputPath}",
                                            "${input:fbxOutputPath}"
                                        ],
                               "cwd":  "${workspaceFolder}",
                               "console":  "internalConsole",
                               "stopAtEntry":  false
                           },
                           {
                               "name":  "Primitive.Cli",
                               "type":  "coreclr",
                               "request":  "launch",
                               "preLaunchTask":  "build",
                               "program":  "${workspaceFolder}/tools/Primitive.Cli/bin/Debug/net10.0/Primitive.Cli.exe",
                               "args":  [
                                            "${input:primitiveKind}",
                                            "${input:primitiveOutputPath}"
                                        ],
                               "cwd":  "${workspaceFolder}",
                               "console":  "internalConsole",
                               "stopAtEntry":  false
                           },
                           {
                               "name":  "CSharpGameEngine.VSExtension: Visual Studio experimental instance",
                               "type":  "node-terminal",
                               "request":  "launch",
                               "command":  "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/tools/Launch-VSExtension.ps1\"",
                               "cwd":  "${workspaceFolder}"
                           }
                       ],
    "inputs":  [
                   {
                       "id":  "gltfInputPath",
                       "type":  "promptString",
                       "description":  "Import.Gltf.Cli: input .glb/.gltf path",
                       "default":  "assets/TestFixtures/Gltf/Box.glb"
                   },
                   {
                       "id":  "gltfOutputPath",
                       "type":  "promptString",
                       "description":  "Import.Gltf.Cli: output .json path",
                       "default":  "${workspaceFolder}/.vscode/out/gltf-import.json"
                   },
                   {
                       "id":  "fbxInputPath",
                       "type":  "promptString",
                       "description":  "Import.Fbx.Cli: input .fbx path",
                       "default":  "assets/TestFixtures/Fbx/Box.fbx"
                   },
                   {
                       "id":  "fbxOutputPath",
                       "type":  "promptString",
                       "description":  "Import.Fbx.Cli: output .json path",
                       "default":  "${workspaceFolder}/.vscode/out/fbx-import.json"
                   },
                   {
                       "id":  "primitiveKind",
                       "type":  "promptString",
                       "description":  "Primitive.Cli: primitive name (Box/Sphere/Cylinder/Capsule/Cone/Torus/Rectangle/Disk)",
                       "default":  "Sphere"
                   },
                   {
                       "id":  "primitiveOutputPath",
                       "type":  "promptString",
                       "description":  "Primitive.Cli: output .glb path",
                       "default":  "${workspaceFolder}/.vscode/out/primitive.glb"
                   }
               ]
}
