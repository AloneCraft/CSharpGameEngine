<Project>
  <PropertyGroup>
    <CompilerGeneratedFilesOutputPath>$(IntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="$(MSBuildProjectDirectory)\Generated\**\*.cs" />
  </ItemGroup>
  <!-- Stages do not import the root Directory.Build.targets; the scene schema target is imported here. -->
  <Import Project="$(MSBuildThisFileDirectory)..\build\CSharpGameEngine.SceneSchema.targets" />
</Project>
