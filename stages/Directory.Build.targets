<Project>
  <PropertyGroup>
    <CompilerGeneratedFilesOutputPath>$(IntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="$(MSBuildProjectDirectory)\Generated\**\*.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\build\CSharpGameEngine.ShaderGraph.targets" />
  <!-- Stages do not import the root Directory.Build.targets; the scene schema target is imported here. -->
  <Import Project="$(MSBuildThisFileDirectory)..\build\CSharpGameEngine.SceneSchema.targets" />
  <PropertyGroup>
    <!-- Run from FeatureRunner or with a stage ID on the command line; started alone it only prints its usage. -->
    <CgeStartupCandidate>false</CgeStartupCandidate>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\build\CSharpGameEngine.StartupProjects.targets" />
</Project>
