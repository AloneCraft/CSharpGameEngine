<Project>
  <!--
    ADR-0070: after a game project builds, write the scene JSON Schema that GameSystemGenerator embedded
    in the assembly to .cge/scene.schema.json, so scene JSON files (Scenes\**\*.json) that point "$schema" at it get
    warnings and completion in the VS JSON editor. Only projects that consume the engine's game props
    (CgeGameProject) run it.
  -->
  <PropertyGroup>
    <!-- The schema is written by the scene-schema command of tools/Cge (Docs/refactoring-designs/20261117-command-tools-consolidation.md). -->
    <CgeSceneSchemaCliProject>$(MSBuildThisFileDirectory)..\tools\Cge\Cge.csproj</CgeSceneSchemaCliProject>
    <!-- PackageMode (ADR-0065) predefines the Cge assembly shipped in the SDK package; SourceMode builds it from the repository
         and BuildCgeSceneSchemaCli replaces this with the path the build produced (an artifacts path moves it). -->
    <CgeSceneSchemaCli Condition="'$(CgeSceneSchemaCli)' == ''">$(MSBuildThisFileDirectory)..\tools\Cge\bin\$(Configuration)\net10.0\Cge.dll</CgeSceneSchemaCli>
    <!-- The game build makes tools/Cge from three places (shader graphs, scene schema, model content). They pass the same properties,
         so MSBuild builds it once per game build and reuses the result. Keep these the same in all three files. -->
    <CgeToolBuildProperties Condition="'$(CgeToolBuildProperties)' == ''">Configuration=$(Configuration);CgeNumericMode=Fixed;CgeFixedBits=128;CgeFractionalBits=64</CgeToolBuildProperties>
    <CgeToolRemoveProperties Condition="'$(CgeToolRemoveProperties)' == ''">CgeGameProject;CgeDepthMapping;RuntimeIdentifier;SelfContained;PublishDir;Platform;TargetFramework;TargetFrameworks;OutputPath;BaseOutputPath;IntermediateOutputPath;BaseIntermediateOutputPath</CgeToolRemoveProperties>
    <CgeSceneSchemaPath Condition="'$(CgeSceneSchemaPath)' == ''">$(MSBuildProjectDirectory)\.cge\scene.schema.json</CgeSceneSchemaPath>
  </PropertyGroup>
  <Target Name="BuildCgeSceneSchemaCli" BeforeTargets="WriteCgeSceneSchema" Condition="'$(CgeGameProject)' == 'true' and '$(CgeEngineMode)' != 'Package'">
    <!-- A game built on its own does not restore this tool; restore in a separate evaluation first. -->
    <MSBuild Projects="$(CgeSceneSchemaCliProject)" Targets="Restore"
             Properties="$(CgeToolBuildProperties);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())"
             RemoveProperties="$(CgeToolRemoveProperties)"
             BuildInParallel="false" />
    <MSBuild Projects="$(CgeSceneSchemaCliProject)" Targets="Build"
             Properties="$(CgeToolBuildProperties)"
             RemoveProperties="$(CgeToolRemoveProperties)"
             BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_CgeSceneSchemaCliAssembly" />
    </MSBuild>
    <PropertyGroup>
      <CgeSceneSchemaCli>@(_CgeSceneSchemaCliAssembly->'%(FullPath)')</CgeSceneSchemaCli>
    </PropertyGroup>
  </Target>
  <Target Name="WriteCgeSceneSchema" AfterTargets="Build" Condition="'$(CgeGameProject)' == 'true'">
    <Exec Command="dotnet &quot;$(CgeSceneSchemaCli)&quot; scene-schema &quot;$(TargetPath)&quot; &quot;$(CgeSceneSchemaPath)&quot;" StandardOutputImportance="low" />
  </Target>
</Project>
