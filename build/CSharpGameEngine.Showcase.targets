<Project>
  <PropertyGroup>
    <CgeFeatureRunnerProject>$(MSBuildThisFileDirectory)..\tools\CSharpGameEngine.FeatureRunner\CSharpGameEngine.FeatureRunner.csproj</CgeFeatureRunnerProject>
    <CgeFeatureRunnerExe>$(MSBuildThisFileDirectory)..\tools\CSharpGameEngine.FeatureRunner\bin\x64\$(Configuration)\net10.0\CSharpGameEngine.FeatureRunner.exe</CgeFeatureRunnerExe>
    <CgeShowcaseIntermediateDirectory>$(IntermediateOutputPath)Showcase\</CgeShowcaseIntermediateDirectory>
    <CgeShowcaseIntermediateManifest>$(CgeShowcaseIntermediateDirectory)feature-progress.json</CgeShowcaseIntermediateManifest>
  </PropertyGroup>
  <Target Name="BuildCgeFeatureRunner" BeforeTargets="GenerateCgeShowcaseManifest" Condition="'@(CgeShowcaseManifest)' != ''">
    <!-- CgeFeatureRunnerExe is the RID-less output; a game's RuntimeIdentifier (an x64 test run of the solution, say) must not move it to win-x64\ and leave a stale exe there. -->
    <!-- A project built on its own does not restore the runner; restore in a separate evaluation first. -->
    <MSBuild Projects="$(CgeFeatureRunnerProject)" Targets="Restore" Properties="Configuration=$(Configuration);Platform=x64;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" RemoveProperties="RuntimeIdentifier;SelfContained" BuildInParallel="false" />
    <MSBuild Projects="$(CgeFeatureRunnerProject)" Targets="Build" Properties="Configuration=$(Configuration);Platform=x64" RemoveProperties="RuntimeIdentifier;SelfContained" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_CgeFeatureRunnerAssembly" />
    </MSBuild>
    <PropertyGroup>
      <!-- The apphost beside the built assembly, wherever the build put it (an artifacts path moves it). -->
      <CgeFeatureRunnerExe>@(_CgeFeatureRunnerAssembly->'%(RootDir)%(Directory)%(Filename).exe')</CgeFeatureRunnerExe>
    </PropertyGroup>
  </Target>
  <Target Name="GenerateCgeShowcaseManifest" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildCgeFeatureRunner" Condition="'@(CgeShowcaseManifest)' != ''" Inputs="@(CgeShowcaseManifest);$(CgeFeatureRunnerExe)" Outputs="$(CgeShowcaseIntermediateManifest)">
    <MakeDir Directories="$(CgeShowcaseIntermediateDirectory)" />
    <Exec Command="&quot;$(CgeFeatureRunnerExe)&quot; export-showcase --output &quot;$(CgeShowcaseIntermediateManifest)&quot;" />
    <ItemGroup><FileWrites Include="$(CgeShowcaseIntermediateManifest)" /></ItemGroup>
  </Target>
  <Target Name="PublishCgeShowcaseManifest" AfterTargets="Build" DependsOnTargets="GenerateCgeShowcaseManifest" Condition="'@(CgeShowcaseManifest)' != ''">
    <MakeDir Directories="$(TargetDir)Showcase" />
    <Copy SourceFiles="$(CgeShowcaseIntermediateManifest)" DestinationFiles="$(TargetDir)Showcase\feature-progress.json" SkipUnchangedFiles="true" />
  </Target>
</Project>
