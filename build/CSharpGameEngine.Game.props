<Project>
  <!--
    C# Game Engineのゲームプロジェクト取り込み規約(ADR-0065)。
    ゲームプロジェクトはこのファイルを1つImportするだけで、生成World/ループ/Mainに必要な共有ソース、
    Runtime Library、Analyzer、既定Stageシェーダーを得る。
    SourceMode: CgeEngineRootがエンジンのソースツリーを指す(このリポジトリ内のUserEcsProject/テンプレート原本)。
    PackageMode: CSharpGameEngine.Sdkパッケージが同じ規約をパッケージ内パスで提供する(ADR-0065 Phase 5)。
  -->
  <PropertyGroup>
    <CgeGameProject>true</CgeGameProject>
    <CgeEngineMode Condition="'$(CgeEngineMode)' == ''">Source</CgeEngineMode>
    <CgeEngineRoot Condition="'$(CgeEngineRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))\</CgeEngineRoot>
    <CgeEngineSourceRoot Condition="'$(CgeEngineSourceRoot)' == ''">$(CgeEngineRoot)src\</CgeEngineSourceRoot>
    <CgeEngineShaderRoot Condition="'$(CgeEngineShaderRoot)' == ''">$(CgeEngineRoot)assets\Shaders\</CgeEngineShaderRoot>
    <!-- Microsoft.NET.Sdk.propsがOutputType=Library/Platforms=AnyCPUを先に既定するため、条件なしで設定する。 -->
    <OutputType>Exe</OutputType>
    <CgeWindowsTargetFramework Condition="'$(CgeWindowsTargetFramework)' == ''">net10.0-windows10.0.19041.0</CgeWindowsTargetFramework>
    <CgeAndroidTargetFramework Condition="'$(CgeAndroidTargetFramework)' == ''">net10.0-android</CgeAndroidTargetFramework>
    <!-- ADR-0101: CgeTargetPlatforms (set before importing this file) names the platforms the game can build for. A game that
         lists Android builds for Android only when the solution platform (Platform) is Android; under every other platform it
         builds for Windows only, so the usual builds do not pay for the Android build. Under the Android platform Visual
         Studio offers Android devices and emulators next to the F5 button. -->
    <CgeTargetPlatforms Condition="'$(CgeTargetPlatforms)' == ''">Windows</CgeTargetPlatforms>
    <_CgeAndroidSelected Condition="'$(Platform)' == 'Android' and $(CgeTargetPlatforms.Contains('Android'))">true</_CgeAndroidSelected>
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' == '' and '$(_CgeAndroidSelected)' == 'true'">$(CgeAndroidTargetFramework)</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' == ''">$(CgeWindowsTargetFramework)</TargetFramework>
    <CgePlatform Condition="'$(TargetFramework)' != '' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">Android</CgePlatform>
    <!-- A game that sets TargetFrameworks itself has an outer build (TargetFramework empty) with no platform: it only dispatches
         the per-framework builds, so it must not run the shader, schema or content steps (it has no TargetPath). -->
    <CgePlatform Condition="'$(CgePlatform)' == '' and '$(TargetFramework)' != ''">Windows</CgePlatform>
    <_CgeWindowsDefault>false</_CgeWindowsDefault>
    <_CgeWindowsDefault Condition="'$(CgePlatform)' == 'Windows'">true</_CgeWindowsDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained Condition="'$(SelfContained)' == '' and '$(CgePlatform)' == 'Windows'">false</SelfContained>
    <IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath Condition="'$(CompilerGeneratedFilesOutputPath)' == ''">$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
    <CgeIncludeDefaultStageShaders Condition="'$(CgeIncludeDefaultStageShaders)' == ''">$(_CgeWindowsDefault)</CgeIncludeDefaultStageShaders>
    <CgeCopyAssets Condition="'$(CgeCopyAssets)' == ''">$(_CgeWindowsDefault)</CgeCopyAssets>
    <CgeIncludeDefaultFonts Condition="'$(CgeIncludeDefaultFonts)' == ''">$(_CgeWindowsDefault)</CgeIncludeDefaultFonts>
    <!-- ADR-0078/M0110: Unreal's "Generate Mesh Distance Fields" (on in its templates, needed by Lumen). The build makes each glTF's distance fields. -->
    <CgeGenerateMeshDistanceFields Condition="'$(CgeGenerateMeshDistanceFields)' == ''">$(_CgeWindowsDefault)</CgeGenerateMeshDistanceFields>
    <!-- The shared engine sources need these outside the repository, where Directory.Build.props does not apply. -->
    <LangVersion Condition="'$(LangVersion)' == ''">14</LangVersion>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
    <!-- ADR-0079: a project plugin's files come in through its <Name>.plugin.items (Game.targets), not the SDK's default globs:
         its Library and Cook modules are separate assemblies and must not compile into the game. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Plugins\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <Platforms>AnyCPU;x64</Platforms>
    <Platforms Condition="$(CgeTargetPlatforms.Contains('Android'))">AnyCPU;x64;Android</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CgePlatform)' == 'Windows'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- ADR-0101 stage 1: on Android the game's systems run without the Windows backend (no D3D12, XAudio2 or Win32 window).
       The D3D12 shaders, the distance fields, the fonts and the loose asset copies default to off there
       (_CgeWindowsDefault): nothing on Android reads them yet. -->
  <PropertyGroup Condition="'$(CgePlatform)' == 'Android'">
    <DefineConstants>$(DefineConstants);CGE_PLATFORM_ANDROID</DefineConstants>
    <!-- "Android" names the solution platform, not a CPU; the compiler accepts only CPU names. The APK carries both
         android-arm64 and android-x64. -->
    <PlatformTarget Condition="'$(Platform)' == 'Android'">AnyCPU</PlatformTarget>
    <SupportedOSPlatformVersion Condition="'$(SupportedOSPlatformVersion)' == ''">24</SupportedOSPlatformVersion>
    <ApplicationId Condition="'$(ApplicationId)' == ''">com.csharpgameengine.$(MSBuildProjectName.ToLowerInvariant())</ApplicationId>
    <ApplicationTitle Condition="'$(ApplicationTitle)' == ''">$(MSBuildProjectName)</ApplicationTitle>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">1.0</ApplicationDisplayVersion>
    <!-- The Android SDK interprets IL in Debug (for Hot Reload). Measured on the API 36 x86_64 emulator with ThirdPerson
         (2026-11-19): about 6 frames a second at full CPU interpreted, about 59 (the 60 Hz cap) at 20% CPU with the JIT.
         Breakpoints work either way; C# Hot Reload on Android needs UseInterpreter=true. -->
    <UseInterpreter Condition="'$(UseInterpreter)' == ''">false</UseInterpreter>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)CSharpGameEngine.Version.props" />
  <Import Project="$(CgeEngineSourceRoot)Runtime\Runtime.projitems" Label="Shared" />

  <ItemGroup>
    <!-- World/Stateはpartial structで、GameSystemGeneratorが同じコンパイル内で完成させる(ADR-0033)。 -->
    <Compile Include="$(CgeEngineSourceRoot)Entities\*.cs" Link="Entities\%(Filename)%(Extension)" />
    <!-- Windows.dll carries these two attributes; on Android (ADR-0101), which does not reference it, the game compiles them. -->
    <Compile Remove="$(CgeEngineSourceRoot)Entities\SceneComponentIconAttribute.cs" Condition="'$(CgePlatform)' == 'Windows'" />
    <Compile Remove="$(CgeEngineSourceRoot)Entities\SceneComponentOrderAttribute.cs" Condition="'$(CgePlatform)' == 'Windows'" />
    <Compile Remove="Generated\**\*.cs" />
    <!-- ADR-0070: scene documents are the *.json files under Scenes (SceneFiles), compiled to C# by
         GameSystemGenerator in the same build. The generator finds them with ProjectDir. -->
    <AdditionalFiles Include="Scenes\**\*.json" />
    <!-- ADR-0077: the file list of Assets (not the contents) becomes the typed catalog Assets.* and lets the generator check
         the paths that scenes name. -->
    <AdditionalFiles Include="Assets\**\*.wav;Assets\**\*.glb;Assets\**\*.gltf;Assets\**\*.fbx;Assets\**\*.png;Assets\**\*.jpg;Assets\**\*.jpeg;Assets\**\*.cgefont" Exclude="Assets\Editor\**" />
    <!-- ADR-0079: a data asset's contents are read too; the generator compiles each into its [DataAsset] type's value. -->
    <AdditionalFiles Include="Assets\**\*.meta" Exclude="Assets\Editor\**" />
    <AdditionalFiles Include="Assets\**\*.cgeasset" />
    <CompilerVisibleProperty Include="ProjectDir" />
    <!-- ADR-0079: the engine version a plugin manifest is checked against, and the project and enabled plugins' folders, encoded so
         the .editorconfig keeps a '#' or ';' in them (CgeEncodeGeneratorPaths in Game.targets). -->
    <CompilerVisibleProperty Include="CgeEngineVersion" />
    <CompilerVisibleProperty Include="CgeProjectDirectory" />
    <CompilerVisibleProperty Include="CgePluginRootsEncoded" />
    <!-- NAME001 (ADR-0099) checks the engine runtime source a game compiles only when this is true: the repository's own
         games set it in Directory.Build.props. A user's game leaves it unset, so its names are not checked. -->
    <CompilerVisibleProperty Include="CgeEnforceEnglishApi" />
  </ItemGroup>

  <!-- ADR-0101: game code names no Android types. Android.Widget.Button, from the Android SDK's implicit usings, would
       collide with CSharpGameEngine.Input.Button. -->
  <ItemGroup Condition="'$(CgePlatform)' == 'Android'">
    <Using Remove="Android.App;Android.Widget;Android.OS.Bundle" />
  </ItemGroup>

  <ItemGroup Condition="'$(CgeEngineMode)' == 'Source'">
    <ProjectReference Include="$(CgeEngineSourceRoot)Contracts\Contracts.csproj" />
    <ProjectReference Include="$(CgeEngineSourceRoot)Windows\Windows.csproj" Condition="'$(CgePlatform)' == 'Windows'" />
    <ProjectReference Include="$(CgeEngineSourceRoot)Engine\Engine.csproj" />
    <ProjectReference Include="$(CgeEngineSourceRoot)Numerics\Numerics.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(CgeIncludeDefaultStageShaders)' == 'true'">
    <CgeShaderGraph Include="$(CgeEngineShaderRoot)Stage.cgeshadergraph" />
    <CgeShaderSubgraph Include="$(CgeEngineShaderRoot)Pbr.cgesubgraph" />
    <CgeShaderSubgraph Include="$(CgeEngineShaderRoot)Shadow.cgesubgraph" />
    <CgeShaderSubgraph Include="$(CgeEngineShaderRoot)Pcss.cgesubgraph" />
    <CgeShaderSubgraph Include="$(CgeEngineShaderRoot)Aces.cgesubgraph" />
    <CgeShaderSubgraph Include="$(CgeEngineShaderRoot)Depth.cgesubgraph" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)Atmosphere.hlsl" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)GlobalIllumination.hlsl" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)AmbientOcclusion.hlsl" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)LuminanceHistogram.hlsl" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)Skinning.hlsl" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)VirtualGeometry.hlsl" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)HiZ.hlsl" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)VirtualShadowRequest.hlsl" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)GlobalDistanceField.hlsl" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)Lumen.hlsl" />
  </ItemGroup>

  <!-- ADR-0078/M0104: the engine's baked fonts (Roboto Regular and Light) land in Fonts\ next to the game, where ScreenText looks. -->
  <ItemGroup Condition="'$(CgeIncludeDefaultFonts)' == 'true'">
    <None Include="$(CgeEngineRoot)assets\Fonts\*.cgefont" Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(CgeGenerateMeshDistanceFields)' == 'true'">
    <CgeMeshDistanceFieldSource Include="Assets\**\*.glb" Exclude="Assets\Editor\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(CgeCopyAssets)' == 'true'">
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Solution Explorerで <Name>.<ext>.meta を <Name>.<ext> の子として入れ子表示する。 -->
  <ItemGroup>
    <None Update="Assets\**\*.meta" DependentUpon="%(Filename)" />
    <AdditionalFiles Update="Assets\**\*.meta" DependentUpon="%(Filename)" />
  </ItemGroup>
</Project>
