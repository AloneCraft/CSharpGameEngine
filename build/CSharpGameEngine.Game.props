<Project>
  <!--
    C# Game Engineのゲームプロジェクト取り込み規約(ADR-0065)。
    ゲームプロジェクトはこのファイルを1つImportするだけで、生成World/ループ/Mainに必要な共有ソース、
    Runtime Library、Analyzer、既定Stageシェーダーを得る。
    SourceMode: CgeEngineRootがエンジンのソースツリーを指す(このリポジトリ内のUserEcsProject/テンプレート原本)。
    PackageMode: CSharpGameEngine.Sdkパッケージが同じ規約をパッケージ内パスで提供する(ADR-0065 Phase 5)。
  -->
  <PropertyGroup>
    <CgeGameProject>true</CgeGameProject>
    <CgeEngineMode Condition="'$(CgeEngineMode)' == ''">Source</CgeEngineMode>
    <CgeEngineRoot Condition="'$(CgeEngineRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))\</CgeEngineRoot>
    <CgeEngineSourceRoot Condition="'$(CgeEngineSourceRoot)' == ''">$(CgeEngineRoot)src\</CgeEngineSourceRoot>
    <CgeEngineShaderRoot Condition="'$(CgeEngineShaderRoot)' == ''">$(CgeEngineRoot)assets\Shaders\</CgeEngineShaderRoot>
    <!-- Microsoft.NET.Sdk.propsがOutputType=Library/Platforms=AnyCPUを先に既定するため、条件なしで設定する。 -->
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath Condition="'$(CompilerGeneratedFilesOutputPath)' == ''">$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
    <CgeIncludeDefaultStageShaders Condition="'$(CgeIncludeDefaultStageShaders)' == ''">true</CgeIncludeDefaultStageShaders>
    <CgeCopyAssets Condition="'$(CgeCopyAssets)' == ''">true</CgeCopyAssets>
    <CgeIncludeDefaultFonts Condition="'$(CgeIncludeDefaultFonts)' == ''">true</CgeIncludeDefaultFonts>
    <!-- ADR-0078/M0110: Unreal's "Generate Mesh Distance Fields" (on in its templates, needed by Lumen). The build makes each glTF's distance fields. -->
    <CgeGenerateMeshDistanceFields Condition="'$(CgeGenerateMeshDistanceFields)' == ''">true</CgeGenerateMeshDistanceFields>
    <!-- The shared engine sources need these outside the repository, where Directory.Build.props does not apply. -->
    <LangVersion Condition="'$(LangVersion)' == ''">14</LangVersion>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
    <!-- ADR-0079: a project plugin's files come in through its <Name>.plugin.items (Game.targets), not the SDK's default globs:
         its Library and Cook modules are separate assemblies and must not compile into the game. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Plugins\**</DefaultItemExcludes>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)CSharpGameEngine.Version.props" />
  <Import Project="$(CgeEngineSourceRoot)CSharpGameEngine.Runtime.Simulation\CSharpGameEngine.Runtime.Simulation.projitems" Label="Shared" />
  <Import Project="$(CgeEngineSourceRoot)CSharpGameEngine.Runtime.Physics\CSharpGameEngine.Runtime.Physics.projitems" Label="Shared" />
  <Import Project="$(CgeEngineSourceRoot)CSharpGameEngine.Runtime.Animation\CSharpGameEngine.Runtime.Animation.projitems" Label="Shared" />
  <Import Project="$(CgeEngineSourceRoot)CSharpGameEngine.Runtime.Character\CSharpGameEngine.Runtime.Character.projitems" Label="Shared" />
  <Import Project="$(CgeEngineSourceRoot)CSharpGameEngine.Runtime.Windows\CSharpGameEngine.Runtime.Windows.projitems" Label="Shared" />

  <ItemGroup>
    <!-- World/Stateはpartial structで、GameSystemGeneratorが同じコンパイル内で完成させる(ADR-0033)。 -->
    <Compile Include="$(CgeEngineSourceRoot)CSharpGameEngine.Entities\*.cs" Link="Entities\%(Filename)%(Extension)" />
    <Compile Remove="$(CgeEngineSourceRoot)CSharpGameEngine.Entities\SceneComponentIconAttribute.cs" />
    <Compile Remove="$(CgeEngineSourceRoot)CSharpGameEngine.Entities\SceneComponentOrderAttribute.cs" />
    <Compile Remove="Generated\**\*.cs" />
    <!-- ADR-0070: scene documents are the *.json files under Scenes (SceneFiles), compiled to C# by
         GameSystemGenerator in the same build. The generator finds them with ProjectDir. -->
    <AdditionalFiles Include="Scenes\**\*.json" />
    <!-- ADR-0077: the file list of Assets (not the contents) becomes the typed catalog Assets.* and lets the generator check
         the paths that scenes name. -->
    <AdditionalFiles Include="Assets\**\*.wav;Assets\**\*.glb;Assets\**\*.gltf;Assets\**\*.fbx;Assets\**\*.png;Assets\**\*.jpg;Assets\**\*.jpeg;Assets\**\*.cgefont" Exclude="Assets\Editor\**" />
    <!-- ADR-0079: a data asset's contents are read too; the generator compiles each into its [DataAsset] type's value. -->
    <AdditionalFiles Include="Assets\**\*.meta" Exclude="Assets\Editor\**" />
    <AdditionalFiles Include="Assets\**\*.cgeasset" />
    <CompilerVisibleProperty Include="ProjectDir" />
    <!-- ADR-0079: the engine version a plugin manifest is checked against, and the project and enabled plugins' folders, encoded so
         the .editorconfig keeps a '#' or ';' in them (CgeEncodeGeneratorPaths in Game.targets). -->
    <CompilerVisibleProperty Include="CgeEngineVersion" />
    <CompilerVisibleProperty Include="CgeProjectDirectory" />
    <CompilerVisibleProperty Include="CgePluginRootsEncoded" />
  </ItemGroup>

  <ItemGroup Condition="'$(CgeEngineMode)' == 'Source'">
    <ProjectReference Include="$(CgeEngineSourceRoot)CSharpGameEngine.Contracts\CSharpGameEngine.Contracts.csproj" />
    <ProjectReference Include="$(CgeEngineSourceRoot)CSharpGameEngine.Windows\CSharpGameEngine.Windows.csproj" />
    <ProjectReference Include="$(CgeEngineSourceRoot)CSharpGameEngine.Import\CSharpGameEngine.Import.csproj" />
    <ProjectReference Include="$(CgeEngineSourceRoot)CSharpGameEngine.Core\CSharpGameEngine.Core.csproj" />
    <ProjectReference Include="$(CgeEngineSourceRoot)CSharpGameEngine.Numerics\CSharpGameEngine.Numerics.csproj" />
    <ProjectReference Include="$(CgeEngineSourceRoot)CSharpGameEngine.World\CSharpGameEngine.World.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(CgeIncludeDefaultStageShaders)' == 'true'">
    <CgeShaderGraph Include="$(CgeEngineShaderRoot)Stage.cgeshadergraph" />
    <CgeShaderSubgraph Include="$(CgeEngineShaderRoot)Pbr.cgesubgraph" />
    <CgeShaderSubgraph Include="$(CgeEngineShaderRoot)Shadow.cgesubgraph" />
    <CgeShaderSubgraph Include="$(CgeEngineShaderRoot)Pcss.cgesubgraph" />
    <CgeShaderSubgraph Include="$(CgeEngineShaderRoot)Aces.cgesubgraph" />
    <CgeShaderSubgraph Include="$(CgeEngineShaderRoot)Depth.cgesubgraph" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)Atmosphere.hlsl" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)GlobalIllumination.hlsl" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)AmbientOcclusion.hlsl" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)LuminanceHistogram.hlsl" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)Skinning.hlsl" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)GlobalDistanceField.hlsl" />
    <CgeComputeShader Include="$(CgeEngineShaderRoot)Lumen.hlsl" />
  </ItemGroup>

  <!-- ADR-0078/M0104: the engine's baked fonts (Roboto Regular and Light) land in Fonts\ next to the game, where ScreenText looks. -->
  <ItemGroup Condition="'$(CgeIncludeDefaultFonts)' == 'true'">
    <None Include="$(CgeEngineRoot)assets\Fonts\*.cgefont" Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(CgeGenerateMeshDistanceFields)' == 'true'">
    <CgeMeshDistanceFieldSource Include="Assets\**\*.glb" Exclude="Assets\Editor\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(CgeCopyAssets)' == 'true'">
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
