<Project>
  <PropertyGroup>
    <CgeShaderGraphCliProject>$(MSBuildThisFileDirectory)..\tools\CSharpGameEngine.ShaderGraph.Cli\CSharpGameEngine.ShaderGraph.Cli.csproj</CgeShaderGraphCliProject>
    <!-- PackageMode (ADR-0065) predefines the CLI shipped in the SDK package; SourceMode builds it from the repository
         and BuildCgeShaderGraphCli replaces this with the path the build produced (an artifacts path moves it). -->
    <CgeShaderGraphCliExe Condition="'$(CgeShaderGraphCliExe)' == ''">$(MSBuildThisFileDirectory)..\tools\CSharpGameEngine.ShaderGraph.Cli\bin\x64\$(Configuration)\net10.0-windows10.0.19041.0\CSharpGameEngine.ShaderGraph.Cli.exe</CgeShaderGraphCliExe>
    <CgeShaderGraphIntermediateDirectory>$(IntermediateOutputPath)ShaderGraph\</CgeShaderGraphIntermediateDirectory>
    <CgeMeshDistanceFieldIntermediateDirectory>$(IntermediateOutputPath)DistanceFields\</CgeMeshDistanceFieldIntermediateDirectory>
  </PropertyGroup>
  <Target Name="BuildCgeShaderGraphCli" BeforeTargets="CompileCgeShaderGraphs;CompileCgeComputeShaders;CompileCgeMeshDistanceFields" Condition="('@(CgeShaderGraph)' != '' or '@(CgeComputeShader)' != '' or '@(CgeMeshDistanceFieldSource)' != '') and '$(CgeEngineMode)' != 'Package'">
    <!-- A project built on its own does not restore this tool; restore in a separate evaluation first. -->
    <MSBuild Projects="$(CgeShaderGraphCliProject)" Targets="Restore"
             Properties="Configuration=$(Configuration);Platform=x64;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishDir"
             BuildInParallel="false" />
    <MSBuild Projects="$(CgeShaderGraphCliProject)" Targets="Build"
             Properties="Configuration=$(Configuration);Platform=x64"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishDir"
             BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_CgeShaderGraphCliAssembly" />
    </MSBuild>
    <PropertyGroup>
      <!-- The apphost beside the built assembly. -->
      <CgeShaderGraphCliExe>@(_CgeShaderGraphCliAssembly->'%(RootDir)%(Directory)%(Filename).exe')</CgeShaderGraphCliExe>
    </PropertyGroup>
  </Target>
  <Target Name="CompileCgeComputeShaders" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildCgeShaderGraphCli" Condition="'@(CgeComputeShader)' != ''" Inputs="@(CgeComputeShader);$(CgeShaderGraphCliExe)" Outputs="@(CgeComputeShader->'$(CgeShaderGraphIntermediateDirectory)%(Filename).cgeshaderartifact')">
    <MakeDir Directories="$(CgeShaderGraphIntermediateDirectory)" />
    <Exec Command="&quot;$(CgeShaderGraphCliExe)&quot; build-compute &quot;%(CgeComputeShader.FullPath)&quot; &quot;$(CgeShaderGraphIntermediateDirectory)%(CgeComputeShader.Filename).cgeshaderartifact&quot; &quot;$(Configuration)&quot;" />
    <!-- The CLI leaves an identical artifact untouched; mark it current so a rebuilt CLI does not rerun DXC on every build. -->
    <Touch Files="@(CgeComputeShader->'$(CgeShaderGraphIntermediateDirectory)%(Filename).cgeshaderartifact')" />
  </Target>
  <Target Name="CompileCgeShaderGraphs" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildCgeShaderGraphCli" Condition="'@(CgeShaderGraph)' != ''" Inputs="@(CgeShaderGraph);@(CgeShaderSubgraph);$(CgeShaderGraphCliExe)" Outputs="@(CgeShaderGraph->'$(CgeShaderGraphIntermediateDirectory)%(Filename).cgeshaderartifact')">
    <MakeDir Directories="$(CgeShaderGraphIntermediateDirectory)" />
    <Exec Command="&quot;$(CgeShaderGraphCliExe)&quot; build &quot;%(CgeShaderGraph.FullPath)&quot; &quot;$(CgeShaderGraphIntermediateDirectory)%(CgeShaderGraph.Filename).cgeshaderartifact&quot; &quot;$(CgeShaderGraphIntermediateDirectory)%(CgeShaderGraph.Filename).generated.hlsl&quot; &quot;$(Configuration)&quot;" />
    <Touch Files="@(CgeShaderGraph->'$(CgeShaderGraphIntermediateDirectory)%(Filename).cgeshaderartifact')" />
  </Target>
  <!--
    ADR-0078/M0110: the mesh distance fields of every glTF in CgeMeshDistanceFieldSource (Game.props: the game's Assets\**\*.glb), made by the same
    CLI as the shader artifacts into obj\...\DistanceFields\ and copied next to the game as Assets\<path>.glb.cgesdf, where the runtime looks for them
    when it loads the glTF. One file per glTF, rebuilt only when that glTF or the CLI is newer. It is geometry made ahead of the game; no lighting is baked.
  -->
  <Target Name="CompileCgeMeshDistanceFields" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildCgeShaderGraphCli"
          Condition="'@(CgeMeshDistanceFieldSource)' != '' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(CgeMeshDistanceFieldSource);$(CgeShaderGraphCliExe)"
          Outputs="@(CgeMeshDistanceFieldSource->'$(CgeMeshDistanceFieldIntermediateDirectory)%(RecursiveDir)%(Filename)%(Extension).cgesdf')">
    <MakeDir Directories="$(CgeMeshDistanceFieldIntermediateDirectory)" />
    <Exec Command="&quot;$(CgeShaderGraphCliExe)&quot; build-distance-fields &quot;%(CgeMeshDistanceFieldSource.FullPath)&quot; &quot;$(CgeMeshDistanceFieldIntermediateDirectory)%(CgeMeshDistanceFieldSource.RecursiveDir)%(CgeMeshDistanceFieldSource.Filename)%(CgeMeshDistanceFieldSource.Extension).cgesdf&quot;" />
    <Touch Files="@(CgeMeshDistanceFieldSource->'$(CgeMeshDistanceFieldIntermediateDirectory)%(RecursiveDir)%(Filename)%(Extension).cgesdf')" />
  </Target>
  <Target Name="CollectCgeMeshDistanceFields" BeforeTargets="AssignTargetPaths" DependsOnTargets="CompileCgeMeshDistanceFields"
          Condition="'@(CgeMeshDistanceFieldSource)' != '' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <None Include="@(CgeMeshDistanceFieldSource->'$(CgeMeshDistanceFieldIntermediateDirectory)%(RecursiveDir)%(Filename)%(Extension).cgesdf')"
            Link="Assets\%(CgeMeshDistanceFieldSource.RecursiveDir)%(CgeMeshDistanceFieldSource.Filename)%(CgeMeshDistanceFieldSource.Extension).cgesdf"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="PublishCgeShaderArtifacts" AfterTargets="Build" DependsOnTargets="CompileCgeShaderGraphs" Condition="'@(CgeShaderGraph)' != ''">
    <MakeDir Directories="$(TargetDir)Shaders" />
    <Exec Command="&quot;$(CgeShaderGraphCliExe)&quot; publish &quot;$(CgeShaderGraphIntermediateDirectory)%(CgeShaderGraph.Filename).cgeshaderartifact&quot; &quot;$(TargetDir)Shaders\%(CgeShaderGraph.Filename).cgeshaderartifact&quot;" />
  </Target>
  <Target Name="PublishCgeComputeArtifacts" AfterTargets="Build" DependsOnTargets="CompileCgeComputeShaders" Condition="'@(CgeComputeShader)' != ''">
    <MakeDir Directories="$(TargetDir)Shaders" />
    <Exec Command="&quot;$(CgeShaderGraphCliExe)&quot; publish &quot;$(CgeShaderGraphIntermediateDirectory)%(CgeComputeShader.Filename).cgeshaderartifact&quot; &quot;$(TargetDir)Shaders/%(CgeComputeShader.Filename).cgeshaderartifact&quot;" />
  </Target>
  <Target Name="CollectCgeShaderArtifactsForPublish"
          AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="CompileCgeShaderGraphs;CompileCgeComputeShaders"
          Condition="'@(CgeShaderGraph)' != '' or '@(CgeComputeShader)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(CgeShaderGraph->'$(CgeShaderGraphIntermediateDirectory)%(Filename).cgeshaderartifact')"
                             Condition="'@(CgeShaderGraph)' != ''">
        <RelativePath>Shaders/%(Filename).cgeshaderartifact</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(CgeComputeShader->'$(CgeShaderGraphIntermediateDirectory)%(Filename).cgeshaderartifact')"
                             Condition="'@(CgeComputeShader)' != ''">
        <RelativePath>Shaders/%(Filename).cgeshaderartifact</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
