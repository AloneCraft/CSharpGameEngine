<Project>
  <PropertyGroup Condition="'$(CgeGameProject)' == 'true'">
    <CgeCompileModels Condition="'$(CgeCompileModels)' == ''">true</CgeCompileModels>
    <CgeModelCompiler Condition="'$(CgeEngineMode)' == 'Package' and '$(CgeModelCompiler)' == ''">$(CgeEngineRoot)tools\ContentCompiler\ContentCompiler.dll</CgeModelCompiler>
    <CgeModelCookCli Condition="'$(CgeEngineMode)' == 'Package' and '$(CgeModelCookCli)' == ''">$(CgeEngineRoot)tools\Cook\Cook.Cli.dll</CgeModelCookCli>
    <CgeModelImportModule Condition="'$(CgeEngineMode)' == 'Package' and '$(CgeModelImportModule)' == ''">$(CgeEngineRoot)tools\ModelImport\Import.dll</CgeModelImportModule>
  </PropertyGroup>
  <ItemGroup Condition="'$(CgeGameProject)' == 'true'">
    <CgeModelSource Include="Assets\**\*.gltf;Assets\**\*.glb" Exclude="Assets\Editor\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(CgeGameProject)' == 'true' and '$(CgeCompileModels)' == 'true'">
    <None Update="Assets\**\*.gltf;Assets\**\*.glb" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <Target Name="_CgeBuildModelTools" Condition="'$(CgeEngineMode)' == 'Source' and '$(DesignTimeBuild)' != 'true' and '$(CgeCompileModels)' == 'true'">
    <ItemGroup>
      <_CgeModelToolProject Include="$(CgeEngineRoot)tools\ContentCompiler\ContentCompiler.csproj;$(CgeEngineRoot)tools\Cook.Cli\Cook.Cli.csproj;$(CgeEngineRoot)src\Import\Import.csproj" />
    </ItemGroup>
    <MSBuild Projects="@(_CgeModelToolProject)" Targets="Restore" BuildInParallel="false"
      Properties="Configuration=$(Configuration);CgeNumericMode=Fixed;CgeFixedBits=128;CgeFractionalBits=64;MSBuildRestoreSessionId=$([System.Guid]::NewGuid())"
      RemoveProperties="CgeGameProject;CgeDepthMapping;RuntimeIdentifier;SelfContained;PublishDir;Platform;TargetFramework;TargetFrameworks;OutputPath;BaseOutputPath;IntermediateOutputPath;BaseIntermediateOutputPath" />
    <MSBuild Projects="@(_CgeModelToolProject)" Targets="Build" BuildInParallel="false"
      Properties="Configuration=$(Configuration);CgeNumericMode=Fixed;CgeFixedBits=128;CgeFractionalBits=64"
      RemoveProperties="CgeGameProject;CgeDepthMapping;RuntimeIdentifier;SelfContained;PublishDir;Platform;TargetFramework;TargetFrameworks;OutputPath;BaseOutputPath;IntermediateOutputPath;BaseIntermediateOutputPath">
      <Output TaskParameter="TargetOutputs" ItemName="_CgeModelToolAssembly" />
    </MSBuild>
    <PropertyGroup>
      <CgeModelCompiler>@(_CgeModelToolAssembly->WithMetadataValue('Filename','ContentCompiler')->'%(FullPath)')</CgeModelCompiler>
      <CgeModelCookCli>@(_CgeModelToolAssembly->WithMetadataValue('Filename','Cook.Cli')->'%(FullPath)')</CgeModelCookCli>
      <CgeModelImportModule>@(_CgeModelToolAssembly->WithMetadataValue('Filename','Import')->'%(FullPath)')</CgeModelImportModule>
    </PropertyGroup>
  </Target>
  <Target Name="CgePrepareModels" BeforeTargets="AssignTargetPaths" DependsOnTargets="_CgeBuildModelTools"
    Condition="'$(CgeGameProject)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(CgeCompileModels)' == 'true'">
    <PropertyGroup>
      <CgeModelCookDirectory Condition="'$(CgeModelCookDirectory)' == ''">$(MSBuildProjectDirectory)\obj\cge-content\models</CgeModelCookDirectory>
      <CgeModelRuntimeDirectory Condition="'$(CgeModelRuntimeDirectory)' == ''">$(TargetDir)Content\Models</CgeModelRuntimeDirectory>
      <CgeModelInputList>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)','$(IntermediateOutputPath)','cge-models','inputs.txt'))</CgeModelInputList>
      <CgeModelRuntimeFileList>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)','$(IntermediateOutputPath)','cge-models','files.txt'))</CgeModelRuntimeFileList>
    </PropertyGroup>
    <Error Condition="!Exists('$(CgeModelCompiler)') or !Exists('$(CgeModelCookCli)') or !Exists('$(CgeModelImportModule)')" Text="CGE model production tools are missing from the selected engine installation." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(CgeModelInputList)'))" />
    <WriteLinesToFile File="$(CgeModelInputList)" Lines="@(CgeModelSource->'%(FullPath)')" Encoding="UTF-8" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Exec Command="dotnet &quot;$(CgeModelCompiler)&quot; compile-project --project &quot;$(MSBuildProjectDirectory)&quot; --cook &quot;$(CgeModelCookCli)&quot; --module &quot;$(CgeModelImportModule)&quot; --resources-module &quot;$(CgeModelImportModule)&quot; --inputs &quot;$(CgeModelInputList)&quot; --out &quot;$(CgeModelCookDirectory)&quot; --copy-to &quot;$(CgeModelRuntimeDirectory)&quot; --file-list &quot;$(CgeModelRuntimeFileList)&quot;" StandardOutputImportance="Low" />
    <ReadLinesFromFile File="$(CgeModelRuntimeFileList)"><Output TaskParameter="Lines" ItemName="CgeModelRuntimeFile" /></ReadLinesFromFile>
    <ItemGroup>
      <Content Include="@(CgeModelRuntimeFile)">
        <Link>Content\Models\$([MSBuild]::MakeRelative('$(CgeModelRuntimeDirectory)','%(CgeModelRuntimeFile.Identity)'))</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>
  <Target Name="_CgePublishModelFiles" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="CgePrepareModels"
    Condition="'$(CgeGameProject)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(CgeCompileModels)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(CgeModelRuntimeFile)">
        <RelativePath>Content\Models\$([MSBuild]::MakeRelative('$(CgeModelRuntimeDirectory)','%(CgeModelRuntimeFile.Identity)'))</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
