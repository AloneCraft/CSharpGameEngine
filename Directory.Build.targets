<Project>
  <!-- Test projects are those under tests/ (CgeTestProject, Directory.Build.props), whatever their name: they may be
       named in Japanese (ADR-0099). -->
  <ItemGroup Condition="'$(CgeSkipEngineAnalyzerReference)' != 'true' and '$(MSBuildProjectName)' != 'CodeAnalysis' and '$(CgeTestProject)' != 'true' and !$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Benchmarks'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\CodeAnalysis\CodeAnalysis.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <CompilerVisibleProperty Include="CgeEngineAssembly" />
  </ItemGroup>
  <!-- Logical numeric formats are runtime-owned. Game projects receive the reference from
       build/CSharpGameEngine.Game.props; the listed engine/test compilations get it here, and the
       library itself is excluded to avoid a cycle. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Entities' or '$(MSBuildProjectName)' == 'Windowsのテスト' or '$(MSBuildProjectName)' == 'エンジンのテスト'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\Numerics\Numerics.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <CgeNumericProfileLateImport Condition="'$(CgeGameProject)' == 'true' or '$(CgeNumericProfileProject)' == 'true'">true</CgeNumericProfileLateImport>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)build\CSharpGameEngine.NumericProfile.props" Condition="'$(CgeNumericProfileLateImport)' == 'true' and '$(CgeNumericProfileApplied)' != 'true'" />
  <Import Project="$(MSBuildThisFileDirectory)build\CSharpGameEngine.RenderProfile.props" Condition="'$(CgeGameProject)' == 'true' and '$(CgeRenderProfileApplied)' != 'true'" />
  <Import Project="$(MSBuildThisFileDirectory)build\CSharpGameEngine.ShaderGraph.targets" />
  <Import Project="$(MSBuildThisFileDirectory)build\CSharpGameEngine.SceneSchema.targets" />
  <Import Project="$(MSBuildThisFileDirectory)build\CSharpGameEngine.Showcase.targets" />
  <!-- The game projects' plugins (ADR-0079); the package imports it from CSharpGameEngine.Sdk.targets. -->
  <Import Project="$(MSBuildThisFileDirectory)build\CSharpGameEngine.Game.targets" />
  <Import Project="$(MSBuildThisFileDirectory)build\CSharpGameEngine.NumericProfile.targets" Condition="'$(CgeNumericProfileLateImport)' == 'true' and '$(MSBuildProjectName)' != 'Numerics'" />
</Project>


