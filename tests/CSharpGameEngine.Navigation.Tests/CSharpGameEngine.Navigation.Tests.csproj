<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ADR-0079/M0106: the Navigation plugin's Cook module (voxelization, polygons, the .cgenav format) and the path search it shares with the game.
    The module is referenced as a library, so the tests see its internals.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="CSharpGameEngine.Numerics" />
    <Using Include="CSharpGameEngine.Navigation" />
    <Using Include="CSharpGameEngine.Navigation.Cook" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\plugins\CSharpGameEngine.Navigation\Cook\CSharpGameEngine.Navigation.Cook.csproj" />
    <ProjectReference Include="..\..\src\CSharpGameEngine.Cooking\CSharpGameEngine.Cooking.csproj" />
    <ProjectReference Include="..\..\src\CSharpGameEngine.Numerics\CSharpGameEngine.Numerics.csproj" />
    <!-- The CLI is run as a process (a bake is a separate process in the build); it only has to be built. -->
    <ProjectReference Include="..\..\tools\CSharpGameEngine.Cook.Cli\CSharpGameEngine.Cook.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
