<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared source, not a binary reference: World/State are partial types the generator completes
         inside THIS compilation (ADR-0033). -->
    <!-- FixedTransform depends on the Scene-owned TransformPrecision generator output. Its
         behavior is covered by the UserEcs/Windows runtime test compilation, whereas this
         project intentionally exercises the generator-free shared Entity primitives. -->
    <Compile Include="..\..\src\Entities\*.cs" Exclude="..\..\src\Entities\FixedTransform.cs;..\..\src\Entities\SpatialPartitioning.cs;..\..\src\Entities\SpatialWorld.cs;..\..\src\Entities\SpatialDebug.cs" Link="Entities\%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\src\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\..\src\Core\Core.csproj" />
    <ProjectReference Include="..\..\src\Numerics\Numerics.csproj" />
    <ProjectReference Include="..\..\src\CodeAnalysis\CodeAnalysis.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <!-- 実行時の部品のうち Simulation だけを使う。 -->
    <CgeRuntimeSimulationOnly>true</CgeRuntimeSimulationOnly>
  </PropertyGroup>
  <Import Project="..\..\src\Runtime\Runtime.projitems" Label="Shared" />

</Project>
