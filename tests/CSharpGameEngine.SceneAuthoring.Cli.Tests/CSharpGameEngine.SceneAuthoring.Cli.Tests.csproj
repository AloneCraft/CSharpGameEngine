<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\CSharpGameEngine.SceneAuthoring.Cli\CSharpGameEngine.SceneAuthoring.Cli.csproj" />
    <ProjectReference Include="..\..\src\CSharpGameEngine.Entities\CSharpGameEngine.Entities.csproj" />
    <!-- SceneRuntimeInvokerTests loads this project's own built dll out-of-process via reflection
         (exactly what the real bridge does against a user's game project, ADR-0031) - not linked as
         an assembly reference, just built as a byproduct so the dll always exists before tests run. -->
    <ProjectReference Include="..\..\samples\SceneAuthoringDemo\SceneAuthoringDemo.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
