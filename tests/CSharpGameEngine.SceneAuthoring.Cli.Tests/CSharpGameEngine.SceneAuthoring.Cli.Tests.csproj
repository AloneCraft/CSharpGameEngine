<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\CSharpGameEngine.SceneAuthoring.Cli\CSharpGameEngine.SceneAuthoring.Cli.csproj" />
    <!-- SceneRuntimeInvokerTests loads THIS project's own built dll out-of-process via reflection
         (exactly what the real bridge does against a user's game project, ADR-0031/ADR-0033), so the
         fixture scene lives here: linking the runtime source + the generator makes this assembly a
         self-contained stand-in for a real game project, with no cross-TFM project reference and no
         graphics dependencies to resolve at load time. -->
    <Compile Include="..\..\src\CSharpGameEngine.Entities\*.cs" Link="Entities\%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\src\CSharpGameEngine.CodeAnalysis\CSharpGameEngine.CodeAnalysis.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
