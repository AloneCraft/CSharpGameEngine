<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="CSharpGameEngine.Numerics" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CSharpGameEngine.Windows\CSharpGameEngine.Windows.csproj" />
    <ProjectReference Include="..\..\UserEcsProject\UserEcsProject.csproj" />
    <ProjectReference Include="..\..\tools\CSharpGameEngine.Showcase.Automation\CSharpGameEngine.Showcase.Automation.csproj" />
    <ProjectReference Include="../../tools/CSharpGameEngine.EditorPreview.Host/CSharpGameEngine.EditorPreview.Host.csproj" />
    <!-- The authored physical-light API is compiled from the shared Runtime.Windows source inside
         UserEcsProject. Keep a compile-time contract test here so editor-only changes cannot
         reintroduce positional or unitless light fields. -->
    <!-- Test-only edge: production CSharpGameEngine.Windows itself has no reference to the
         importers - only the model/stage GPU integration tests load .glb fixtures. -->
    <ProjectReference Include="..\..\src\CSharpGameEngine.Import\CSharpGameEngine.Import.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0034: Triangle and Model shader graphs were declared with these exact Link paths by BOTH
         former test projects (Graphics.D3D12.Tests and Compiler.Hlsl.Tests). Each must appear
         exactly once here - a duplicate <None> with the same Link is an MSBuild warning, and
         TreatWarningsAsErrors=true turns that into a build failure. -->
    <CgeShaderGraph Include="..\..\assets\Shaders\Triangle.cgeshadergraph" />
    <CgeShaderGraph Include="..\..\assets\Shaders\Model.cgeshadergraph" />
    <CgeShaderGraph Include="..\..\assets\Shaders\Stage.cgeshadergraph" />
    <CgeComputeShader Include="../../assets/Shaders/ComputeVector.hlsl" />
    <CgeComputeShader Include="../../assets/Shaders/Atmosphere.hlsl" />
    <CgeComputeShader Include="../../assets/Shaders/GlobalIllumination.hlsl" />
    <CgeShaderSubgraph Include="..\..\assets\Shaders\Pbr.cgesubgraph" />
    <CgeShaderSubgraph Include="..\..\assets\Shaders\Shadow.cgesubgraph" />
    <CgeShaderSubgraph Include="..\..\assets\Shaders\Pcss.cgesubgraph" />
    <CgeShaderSubgraph Include="..\..\assets\Shaders\Aces.cgesubgraph" />
    <!-- From the former Graphics.D3D12.Tests. -->
    <None Include="..\..\assets\TestFixtures\Gltf\Box.glb" Link="Fixtures\Box.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\TestFixtures\Gltf\BoxTextured.glb" Link="Fixtures\BoxTextured.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\TestFixtures\Gltf\Malformed.glb" Link="Fixtures\Malformed.glb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
