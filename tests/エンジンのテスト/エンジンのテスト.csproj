  <ItemGroup>
    <!-- The FBX import tests need AssimpNet's native assimp.dll next to the tests. Copy it the way
         Import.AssetAuthoring.Cli does, instead of setting a RuntimeIdentifier: a RID would move this
         project's output folder, and the cook tests find the tools by the folder layout (ADR-0099). -->
    <Content Include="$(NuGetPackageRoot)assimpnet\4.1.0\runtimes\win-x64\native\assimp.dll" Link="assimp.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
