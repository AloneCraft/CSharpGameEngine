<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Inherited from the former CSharpGameEngine.Import.Fbx.Tests: AssimpNet's native assimp.dll
         (ADR-0009) ships under runtimes/win-x64/native/, and a RuntimeIdentifier is required for the
         test host to actually get the native binary next to the test assembly (same reason as
         CSharpGameEngine.Extension.csproj). Now that ADR-0034 put Gltf and Fbx in one assembly this
         also applies to the glTF tests, which do not need it but are not harmed by it. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Test-only: builds small synthetic glTF fixtures in memory for ImportScene tests. The
         shipping CSharpGameEngine.Import project deliberately stays on SharpGLTF.Core alone. -->
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\CSharpGameEngine.Unreal.SceneImporter\CSharpGameEngine.Unreal.SceneImporter.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/CSharpGameEngine.Runtime.Animation/Skeleton.cs" Link="Parity/Skeleton.cs" />
    <Compile Include="../../src/CSharpGameEngine.Runtime.Animation/AnimationClip.cs" Link="Parity/AnimationClip.cs" />
    <ProjectReference Include="..\..\src\CSharpGameEngine.Import\CSharpGameEngine.Import.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\TestFixtures\Gltf\Box.glb" Link="Fixtures\Box.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\TestFixtures\Gltf\Triangle.gltf" Link="Fixtures\Triangle.gltf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\TestFixtures\Gltf\Triangle.bin" Link="Fixtures\Triangle.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\TestFixtures\Gltf\Malformed.glb" Link="Fixtures\Malformed.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\TestFixtures\Gltf\BoxTextured.glb" Link="Fixtures\BoxTextured.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\TestFixtures\Fbx\Box.fbx" Link="Fixtures\Box.fbx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
