<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CSharpGameEngine.CodeAnalysis\CSharpGameEngine.CodeAnalysis.csproj" />
    <ProjectReference Include="..\..\src\CSharpGameEngine.Entities\CSharpGameEngine.Entities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read as text by StaticArchetypeGeneratorTestHelper (not compiled here) so the emission/e2e
         tests exercise the literal promoted sample content with zero drift risk (ADR-0032). -->
    <None Include="..\..\src\CSharpGameEngine.StaticArchetype\Runtime.cs" Link="TestAssets\StaticArchetype\Runtime.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\StaticArchetypeSystemsDemo\Components.cs" Link="TestAssets\StaticArchetype\Components.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\StaticArchetypeSystemsDemo\Systems.cs" Link="TestAssets\StaticArchetype\Systems.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
