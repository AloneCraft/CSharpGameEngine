<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CSharpGameEngine.CodeAnalysis\CSharpGameEngine.CodeAnalysis.csproj" />
    <ProjectReference Include="..\..\src\CSharpGameEngine.Entities\CSharpGameEngine.Entities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read as text by StaticArchetypeGeneratorTestHelper (not compiled here) so the emission/e2e
         tests exercise the literal promoted sample content with zero drift risk (ADR-0032). -->
    <!-- The real runtime source the generator completes, read as text by GameSystemGeneratorTestHelper
         so every generator test compiles against exactly what ships (ADR-0033). -->
    <None Include="..\..\src\CSharpGameEngine.Entities\Runtime.cs" Link="TestAssets\Entities\Runtime.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\Bootstrap.cs" Link="TestAssets\Entities\Bootstrap.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\SystemOrderAttribute.cs" Link="TestAssets\Entities\SystemOrderAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\Parent.cs" Link="TestAssets\Entities\Parent.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\SceneNodeTag.cs" Link="TestAssets\Entities\SceneNodeTag.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\SceneNodeId.cs" Link="TestAssets\Entities\SceneNodeId.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\SceneNodeSymbol.cs" Link="TestAssets\Entities\SceneNodeSymbol.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\SceneBuilder.cs" Link="TestAssets\Entities\SceneBuilder.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\SceneNodeBuilder.cs" Link="TestAssets\Entities\SceneNodeBuilder.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\SceneDefinitionAttribute.cs" Link="TestAssets\Entities\SceneDefinitionAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\StartupSceneAttribute.cs" Link="TestAssets\Entities\StartupSceneAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\SceneEntityAttribute.cs" Link="TestAssets\Entities\SceneEntityAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
    <!-- Scene DSL (ADR-0040). IScene/Node/SceneInstance/SceneInstanceTable/ISceneDefinition are
         referenced by Runtime.cs itself, so GameSystemGeneratorTestHelper includes them in *every*
         compilation - omitting one shows up immediately as CS0246 across the generator tests. -->
    <None Include="..\..\src\CSharpGameEngine.Entities\IScene.cs" Link="TestAssets\Entities\IScene.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\Node.cs" Link="TestAssets\Entities\Node.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\SceneInstance.cs" Link="TestAssets\Entities\SceneInstance.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\SceneInstanceTable.cs" Link="TestAssets\Entities\SceneInstanceTable.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\ISceneDefinition.cs" Link="TestAssets\Entities\ISceneDefinition.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Core\Authoring\SceneFactoryAttribute.cs" Link="TestAssets\Core\SceneFactoryAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Core\Authoring\SceneAssetsAttribute.cs" Link="TestAssets\Core\SceneAssetsAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
