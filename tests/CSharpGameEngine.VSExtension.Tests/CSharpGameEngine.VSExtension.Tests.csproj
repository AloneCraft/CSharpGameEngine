<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>14</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Release tracking for the Scene DSL descriptors is owned by CSharpGameEngine.CodeAnalysis,
         which is where they actually ship as an analyzer. Tracking them again here would create a
         second list to keep in sync. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Unlike the VSIX itself (which must bind to the Roslyn that Visual Studio hosts), this test
         process runs standalone, so it needs the Roslyn runtime assemblies. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <!--
    The Scene analysis types come from CSharpGameEngine.VSExtension itself (via InternalsVisibleTo),
    NOT from a second copy of the shared source. Linking the source here as well produced CS0436 on
    every shared type: the local copy and the referenced project's copy are distinct types with the
    same name. Testing the assembly's own types is also the stronger claim - these are exactly the
    types the VSIX runs.

    Only the compilation-building helper is shared with the net10.0 SceneModel tests, which is what
    makes the parity claim real: identical input, identical helper, two different host frameworks.
  -->
  <ItemGroup>
    <Compile Include="..\CSharpGameEngine.SceneModel.Tests\Shared\**\*.cs"
             Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The Scene DSL declaration surface, read as text by the shared helper so both hosts compile
       against exactly what ships. -->
  <ItemGroup>
    <None Include="..\..\src\CSharpGameEngine.Entities\IScene.cs" Link="TestAssets\Entities\IScene.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\Node.cs" Link="TestAssets\Entities\Node.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\Parent.cs" Link="TestAssets\Entities\Parent.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\SceneNodeTag.cs" Link="TestAssets\Entities\SceneNodeTag.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\StartupSceneAttribute.cs" Link="TestAssets\Entities\StartupSceneAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Core\Authoring\SceneFactoryAttribute.cs" Link="TestAssets\Core\SceneFactoryAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Core\Authoring\SceneAssetsAttribute.cs" Link="TestAssets\Core\SceneAssetsAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only exercises VS-independent classes (FabDownloadWatcher, KnownFolders) via
         InternalsVisibleTo - never loads the VSPackage/command types, which require a running VS
         host. -->
    <ProjectReference Include="..\..\tools\CSharpGameEngine.VSExtension\CSharpGameEngine.VSExtension.csproj" />
  </ItemGroup>

</Project>
