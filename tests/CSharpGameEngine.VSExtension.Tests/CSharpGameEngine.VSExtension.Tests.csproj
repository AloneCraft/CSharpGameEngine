<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>14</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Release tracking for the Scene DSL descriptors is owned by CSharpGameEngine.CodeAnalysis,
         which is where they actually ship as an analyzer. Tracking them again here would create a
         second list to keep in sync. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Unlike the VSIX itself (which must bind to the Roslyn that Visual Studio hosts), this test
         process runs standalone, so it needs the Roslyn runtime assemblies. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- SceneJsonWorkspaceSourceTests reads *.scene.json additional documents from an AdhocWorkspace. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <!-- Same reasoning as Microsoft.CodeAnalysis.CSharp above: the VSIX excludes this package's
         runtime assets (devenv.exe supplies Microsoft.VisualStudio.Shell.15.0.dll etc. itself), but
         this standalone test process has no VS host to supply them. SceneEditorSettingsTests needs
         the real WritableSettingsStore/ThreadHelper types loadable at runtime (FakeWritableSettingsStore
         derives from the real abstract class; it never talks to an actual running VS). -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
    <PackageReference Include="Microsoft.VisualStudio.Sdk.TestFramework" Version="17.11.66" />
    <PackageReference Include="Microsoft.VisualStudio.TemplateWizardInterface" Version="17.10.40170" />
  </ItemGroup>

  <!--
    The Scene analysis types come from CSharpGameEngine.VSExtension itself (via InternalsVisibleTo),
    NOT from a second copy of the shared source. Linking the source here as well produced CS0436 on
    every shared type: the local copy and the referenced project's copy are distinct types with the
    same name. Testing the assembly's own types is also the stronger claim - these are exactly the
    types the VSIX runs.

    Only the compilation-building helper is shared with the net10.0 SceneModel tests, which is what
    makes the parity claim real: identical input, identical helper, two different host frameworks.
  -->
  <ItemGroup>
    <Compile Include="..\CSharpGameEngine.SceneModel.Tests\Shared\**\*.cs"
             Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Keep the source manifest beside the tests so VSIX asset registration is covered without
       requiring a running Visual Studio instance. -->
  <PropertyGroup>
    <!-- CSharpGameEngine.slnx builds x64 into bin\x64\..., while a direct project test keeps the
         SDK's bin\... layout. The packaging tests must inspect the VSIX produced by the current
         build instead of silently reusing a package from the other layout. -->
    <CgeVsixPlatformOutputSegment Condition="'$(Platform)' == 'x64'">x64\</CgeVsixPlatformOutputSegment>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\source.extension.vsixmanifest" Link="TestAssets\source.extension.vsixmanifest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\Reinstall-CgeFixedVsix.ps1" Link="TestAssets\Reinstall-CgeFixedVsix.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\Launch-VSExtension.ps1" Link="TestAssets\Launch-VSExtension.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\bin\$(CgeVsixPlatformOutputSegment)$(Configuration)\net472\CSharpGameEngine.VSExtension.vsix" Link="TestAssets\CSharpGameEngine.VSExtension.vsix" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\ItemTemplates\CSharp\GameEngine\SceneFile\**\*"
          Link="TestAssets\ItemTemplates\CSharp\GameEngine\SceneFile\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\ItemTemplates\CSharp\GameEngine\ShaderGraph\**\*" Link="TestAssets\ItemTemplates\CSharp\GameEngine\ShaderGraph\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\ItemTemplates\CSharp\GameEngine\ShaderSubgraph\**\*" Link="TestAssets\ItemTemplates\CSharp\GameEngine\ShaderSubgraph\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <None Include="..\..\tools\CSharpGameEngine.VSExtension\ExperimentalToolWindowState.cs" Link="TestAssets\Source\ExperimentalToolWindowState.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\CSharpGameEngineViewerPackage.cs" Link="TestAssets\Source\CSharpGameEngineViewerPackage.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\CSharpGameEngineViewerPackage.SolutionLifecycle.cs" Link="TestAssets\Source\CSharpGameEngineViewerPackage.SolutionLifecycle.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\HierarchyToolWindowControl.xaml.cs" Link="TestAssets\Source\HierarchyToolWindowControl.xaml.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\HierarchyToolWindowPane.cs" Link="TestAssets\Source\HierarchyToolWindowPane.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\SceneDesignerDocumentManager.cs" Link="TestAssets\Source\SceneDesignerDocumentManager.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\CSharpGameEngineViewerPackage.ComponentDrop.cs" Link="TestAssets\Source\CSharpGameEngineViewerPackage.ComponentDrop.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\InspectorToolWindowControl.xaml.cs" Link="TestAssets\Source\InspectorToolWindowControl.xaml.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\SceneDesignerToolWindowControl.xaml.cs" Link="TestAssets\Source\SceneDesignerToolWindowControl.xaml.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\SceneEditorSessionService.cs" Link="TestAssets\Source\SceneEditorSessionService.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\SceneSourceCommitPlanner.cs" Link="TestAssets\Source\SceneSourceCommitPlanner.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\SceneJsonCommitPlanner.cs" Link="TestAssets\Source\SceneJsonCommitPlanner.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\SceneTextBufferWriter.cs" Link="TestAssets\Source\SceneTextBufferWriter.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\AuthoringOperationPresentation.cs" Link="TestAssets\Source\AuthoringOperationPresentation.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\PhysicsSceneBakeService.cs" Link="TestAssets\Source\PhysicsSceneBakeService.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\ExternalBridgeProcess.cs" Link="TestAssets\Source\ExternalBridgeProcess.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\SceneDesignerToolWindowControl.xaml" Link="TestAssets\Source\SceneDesignerToolWindowControl.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\AssetPreviewControl.xaml" Link="TestAssets\Source\AssetPreviewControl.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\AssetPreviewControl.xaml.cs" Link="TestAssets\Source\AssetPreviewControl.xaml.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\AssetPreviewHwndHost.cs" Link="TestAssets\Source\AssetPreviewHwndHost.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\AssetAuthoringHostClient.cs" Link="TestAssets\Source\AssetAuthoringHostClient.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\AssetAuthoringPresentation.cs" Link="TestAssets\Source\AssetAuthoringPresentation.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\RenderPreviewHostClient.cs" Link="TestAssets\Source\RenderPreviewHostClient.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\RuntimeDebugSnapshotPresentation.cs" Link="TestAssets\Source\RuntimeDebugSnapshotPresentation.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\SceneHwndHost.cs" Link="TestAssets\Source\SceneHwndHost.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.EditorPreview.Host\RenderPreviewHostSessionTable.cs" Link="TestAssets\Source\RenderPreviewHostSessionTable.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.EditorPreview.Host\RenderPreviewRenderSession.cs" Link="TestAssets\Source\RenderPreviewRenderSession.cs" CopyToOutputDirectory="PreserveNewest" />

    <!-- M0051 Step 1-8: デバウンス状態がポリシー経由でのみ遷移することを検査するためのソース。
         直接代入へ戻すと「シーンが開けなくなる」ライブロックが再発する。 -->
    <None Include="..\..\tools\CSharpGameEngine.VSExtension\SceneWorkspaceService.cs" Link="TestAssets\Source\SceneWorkspaceService.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\CSharpGameEngine.Vsix.Automation\VsixExperimentalScenario.cs" Link="TestAssets\Source\VsixExperimentalScenario.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The Scene DSL declaration surface, read as text by the shared helper so both hosts compile
       against exactly what ships. -->
  <ItemGroup>
    <None Include="..\..\src\CSharpGameEngine.Entities\IScene.cs" Link="TestAssets\Entities\IScene.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\Node.cs" Link="TestAssets\Entities\Node.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\Parent.cs" Link="TestAssets\Entities\Parent.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\SceneNodeTag.cs" Link="TestAssets\Entities\SceneNodeTag.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\IRuntimeComponent.cs" Link="TestAssets\Entities\IRuntimeComponent.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Entities\StartupSceneAttribute.cs" Link="TestAssets\Entities\StartupSceneAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Core\Authoring\SceneFactoryAttribute.cs" Link="TestAssets\Core\SceneFactoryAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\CSharpGameEngine.Core\Authoring\SceneAssetsAttribute.cs" Link="TestAssets\Core\SceneAssetsAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only exercises VS-independent classes (FabDownloadWatcher, KnownFolders) via
         InternalsVisibleTo - never loads the VSPackage/command types, which require a running VS
         host. -->
    <ProjectReference Include="..\..\tools\CSharpGameEngine.VSExtension\CSharpGameEngine.VSExtension.csproj" />
    <ProjectReference Include="..\..\tools\CSharpGameEngine.Vsix.Automation\CSharpGameEngine.Vsix.Automation.csproj" />
  </ItemGroup>

  <!-- The SDK's ArtifactsPath relocates every project output. Replace the legacy normal-bin
       package item before target paths are assigned so isolated builds copy the VSIX produced by
       their own ProjectReference generation rather than a stale package from the normal tree. -->
  <PropertyGroup>
    <CgeLowerConfiguration>$([System.String]::Copy('$(Configuration)').ToLowerInvariant())</CgeLowerConfiguration>
    <CgeActiveVsixPackagePath Condition="'$(ArtifactsPath)' != ''">$(ArtifactsPath)/bin/CSharpGameEngine.VSExtension/$(CgeLowerConfiguration)/CSharpGameEngine.VSExtension.vsix</CgeActiveVsixPackagePath>
    <CgeActiveVsixPackagePath Condition="'$(CgeActiveVsixPackagePath)' == ''">../../tools/CSharpGameEngine.VSExtension/bin/$(CgeVsixPlatformOutputSegment)$(Configuration)/net472/CSharpGameEngine.VSExtension.vsix</CgeActiveVsixPackagePath>
  </PropertyGroup>
  <Target Name="SelectActiveVsixPackageForTests" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_LegacyVsixPackage Include="@(None)" Condition="'%(None.Link)' == 'TestAssets/CSharpGameEngine.VSExtension.vsix'" />
      <None Remove="@(_LegacyVsixPackage)" />
      <None Include="$(CgeActiveVsixPackagePath)" Link="TestAssets/CSharpGameEngine.VSExtension.vsix" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="../../src/CSharpGameEngine.Entities/EcsSnapshotTransientAttribute.cs" Link="TestAssets/Entities/EcsSnapshotTransientAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
