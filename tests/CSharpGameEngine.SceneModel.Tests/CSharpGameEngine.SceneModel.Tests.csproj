<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <!-- The scene-upgrade tests live here: the generator and the VSIX builds exclude that code (ADR-0098 §5 rule 2). -->
    <DefineConstants>$(DefineConstants);CGE_SCENE_UPGRADE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    SceneModelは共有ソースであってアセンブリではない。ProjectReferenceではなく <Compile Include> で
    取り込むのは、これが CSharpGameEngine.CodeAnalysis と CSharpGameEngine.VSExtension での消費方法と
    まったく同じだからである(内部型へそのままアクセスでき、InternalsVisibleToも不要)。
  -->
  <ItemGroup>
    <Compile Include="..\..\src\SceneModel\**\*.cs"
             Exclude="..\..\src\SceneModel\obj\**\*.cs;..\..\src\SceneModel\bin\**\*.cs"
             Link="SceneModel\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The scene upgrade lives in SceneJson.Cli only (ADR-0098 §5 rule 2); its tests compile it from there. -->
    <Compile Include="..\..\tools\SceneJson.Cli\SceneJsonAngleUpgrade.cs" Link="SceneJsonCli\SceneJsonAngleUpgrade.cs" />
  </ItemGroup>

  <!--
    Scene DSLの正本ソース。テストコンパイルへ文字列として渡すことで、テストが「実際に出荷される宣言」
    そのものに対して走る(ドリフトゼロ、既存 CodeAnalysis.Tests と同じ方式)。
  -->
  <ItemGroup>
    <None Include="..\..\src\Entities\IScene.cs" Link="TestAssets\Entities\IScene.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Entities\Node.cs" Link="TestAssets\Entities\Node.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Entities\Parent.cs" Link="TestAssets\Entities\Parent.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Entities\SceneNodeTag.cs" Link="TestAssets\Entities\SceneNodeTag.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Entities\IRuntimeComponent.cs" Link="TestAssets\Entities\IRuntimeComponent.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Entities\StartupSceneAttribute.cs" Link="TestAssets\Entities\StartupSceneAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Engine\Core\Authoring\SceneFactoryAttribute.cs" Link="TestAssets\Core\SceneFactoryAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Engine\Core\Authoring\SceneAssetsAttribute.cs" Link="TestAssets\Core\SceneAssetsAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../src/Entities/EcsSnapshotTransientAttribute.cs" Link="TestAssets/Entities/EcsSnapshotTransientAttribute.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
